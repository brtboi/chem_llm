&control
 calculation = 'scf'
 restart_mode = 'from_scratch'
 prefix = 'csPbBr3'
 outdir = './tmp'
 wfcdir = './tmp'
 verbosity = 'high'
/
&system
 ibrav = 2
 celldm(1) = 5.86
 nat = 4
 ntyp = 3
 ecutwfc = 30.0
 ecutrho = 120.0
 occupations = 'smearing'
 smearing = 'gaussian'
 degauss = 0.01
 nosym = .true.
 nspin = 1
/
&electrons
 conv_thr = 1.0d-8
 mixing_mode = 'plain'
 mixing_beta = 0.7
 diagonalization = 'david'
/
ATOMIC_SPECIES
Cs 132.905 Cs.upf
Pb 207.2 Pb.upf
Br 79.904 Br.upf

ATOMIC_POSITIONS (crystal)
Cs 0.000000000 0.000000000 0.000000000
Pb 0.500000000 0.500000000 0.500000000
Br 0.500000000 0.500000000 0.000000000
Br 0.500000000 0.000000000 0.500000000

K_POINTS (automatic)
3 3 3 0 0 0