SHOWPLOTS = 1
nSystem = 1
memory_flag = 0
runtime_flag = 0
num_cores = 23
num_threads = 1
cacheSO = 1

local_env_corr = 0
descriptor_backend = mace       # handcrafted | mace (MACE-MP-0 invariants, D=256; pretraining only)
LSDmodel = Net_celu_HeInit_decayGaussian_LSD
LSDmodel_osc_alpha = 1.0
LSDmodel_gaussian_std = 3.5
LSD_hiddenLayers = 256 128 64
init_LSD_num_epochs = 10000
init_LSD_optimizer_lr = 0.001    # lowered: normalized inputs make lr=0.05 too hot
init_LSD_normalize = 1           # standardize descriptors+q inputs (set 0 to A/B test)
init_LSD_scheduler_gamma = 0.95
init_LSD_plot_every = 100
init_LSD_scheduler_step = 500
init_LSD_force_retrain = 1
init_LSD_scheduler = cosine     # cosine anneal lr -> lr*eta_min_frac over all epochs
init_LSD_eta_min_frac = 0.001
# LSD pre-training runs on GPU if available (independent of the CPU band-structure
# path). 'auto'|'cpu'|'cuda'|'cuda:N'. Set parallel_atoms=1 to train the atom-type
# nets concurrently, one per GPU (needs >1 visible CUDA device).
init_LSD_device = auto
init_LSD_parallel_atoms = 1     # train Cs/I/Pb nets concurrently, one per GPU
init_LSD_dtype = float32        # train in float32 (faster on A100); net cast back to float64 after

PPmodel = Net_celu_HeInit_decayGaussian
PPmodel_decay_rate = 1.5
PPmodel_decay_center = 5.0
PPmodel_gaussian_std = 2.0
hiddenLayers = 20

# Pseudopotential output grids. write_PP_qSpace (qSpace_pot.dat) and
# FT_converge_and_write_pp (final_pot_q_*.dat) share qmax/nQGrid so the
# potentials land on one grid (no interpolation when differencing).
Rmax = 30.0
qmax = 30.0
nQGrid = 4096
nRGrid = 4096

separateKptGrad = 0
checkpoint = 0
SObool = 0
NLbool = 1

init_Zunger_optimizer_lr = 0.12
init_Zunger_scheduler_gamma = 0.90
init_Zunger_num_epochs = 0
init_Zunger_plotEvery = 1000
init_Zunger_schedulerStep = 500
force_retrain = 0

pre_adjust_moves = 0
pre_adjust_stepSize = 0.00
pre_adjust_LSD_step_size = 0.0005

mc_bool = 1
mc_beta = 5
mc_percentage = 0.05
mc_iter = 1000

optimizer_lr = 0.0001
LSD_optimizer_lr = 0.0005
scheduler_gamma = 0.70
LSD_scheduler_gamma = 0.80
max_num_epochs = 0
plotEvery = 10
schedulerStep = 1000
patience = 100
