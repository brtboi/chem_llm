 {"tool": "write_file", "args": {"path": "generate_structures.py", "content": "import numpy as np\nfrom ase.io import read, write\n\n# STEP 2: Generate 51 CsPbBr3 structures: 000 = unperturbed base (primitive cell),\n# 001-050 = perturbed copies with chemically reasonable random atomic displacements\n# at room temperature plus a small random lattice strain.\n#\n# Displacement magnitude justification:\n# Room-temperature thermal RMS atomic displacements in halide perovskites\n# (from atomic displacement parameters / Debye-Waller factors) are on the order\n# of 0.1 Angstrom per Cartesian component. We therefore draw Gaussian displacements\n# with sigma = 0.1 A per component (ase.Atoms.rattle uses a Gaussian of this stdev).\n# Lattice strain: small +/-1% random strain on the cell (uniform in [-0.01, 0.01]),\n# representative of modest thermal/anharmonic volume/shape fluctuations.\n\nrng = np.random.default_rng(12345)\nSIGMA_DISP = 0.1   # Angstrom, Gaussian stdev per Cartesian component (room-T ADP scale)\nSTRAIN_MAX = 0.01  # +/-1% random strain\n\nbase = read('structures/base.cif')\nn_expected = len(base)\nntyp_expected = len(set(base.get_chemical_symbols()))\n\nfor i in range(51):\n    atoms = base.copy()\n    if i > 0:\n        # Random symmetric-ish strain tensor applied to the cell.\n        # Build a small deformation gradient F = I + eps and apply to cell vectors,\n        # scaling atomic positions with the cell (scale_atoms via new_cell w/ scale).\n        eps = rng.uniform(-STRAIN_MAX, STRAIN_MAX, size=(3, 3))\n        # symmetrize so it is a pure strain (no rigid rotation)\n        eps = 0.5 * (eps + eps.T)\n        F = np.eye(3) + eps\n        new_cell = atoms.get_cell()[:] @ F.T\n        atoms.set_cell(new_cell, scale_atoms=True)  # scale positions with the cell\n        # Gaussian atomic displacements at room-T ADP scale (0.1 A per component).\n        # Use a fresh seed derived from i so each structure is reproducible & distinct.\n        atoms.rattle(stdev=SIGMA_DISP, seed=int(rng.integers(1, 2**31 - 1)))\n\n    # INVARIANT 1: nat/ntyp derived from the actual Atoms object, per structure.\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == n_expected, f'structure {i}: nat {nat} != {n_expected}'\n    assert ntyp == ntyp_expected, f'structure {i}: ntyp {ntyp} != {ntyp_expected}'\n\n    write(f'structures/structure_{i:03d}.cif', atoms)\n\nprint(f'Wrote 51 structures, each with nat={n_expected}, ntyp={ntyp_expected}')\n"}}
