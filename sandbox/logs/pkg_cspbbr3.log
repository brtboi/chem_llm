ymprec=0.01)\n    # self-consistency check against spglib at the same symprec\n    ds = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01)\n    sg = ds[\'number\'] if isinstance(ds, dict) else ds.number\n    assert res[\'spacegroup_number\'] == sg, f"seekpath/spglib SG mismatch: {res[\'spacegroup_number\']} vs {sg}"\n\n    recip_prim = np.array(res[\'reciprocal_primitive_lattice\'])       # includes 2*pi\n    recip_actual = 2 * np.pi * np.array(atoms.cell.reciprocal()[:])  # ASE has no 2*pi\n\n    def to_actual_frac(frac_prim):\n        cart = np.array(frac_prim) @ recip_prim\n        return cart @ np.linalg.inv(recip_actual)\n\n    pts = {lbl: to_actual_frac(c) for lbl, c in res[\'point_coords\'].items()}\n\n    kpoints = []        # (kx,ky,kz) actual-cell fractional\n    labels = []         # (index_in_kpoints, label) for high-symmetry vertices\n    prev_end_label = None\n    for (a, b) in res[\'path\']:\n        start = pts[a]\n        end = pts[b]\n        # every segment contributes its own start point (path can be discontinuous)\n        start_idx = len(kpoints)\n        # mark discontinuity: previous segment end != this segment start\n        if prev_end_label is not None and prev_end_label != a:\n            labels.append((start_idx, f\'{prev_end_label}|{a}\'))\n        else:\n            labels.append((start_idx, a))\n        # interior + end points (i from 1..NPTS_PER_SEG)\n        seg = [start]\n        for i in range(1, NPTS_PER_SEG + 1):\n            frac = i / NPTS_PER_SEG\n            seg.append(start + frac * (end - start))\n        kpoints.extend(seg)\n        prev_end_label = b\n    # final endpoint label\n    labels.append((len(kpoints) - 1, prev_end_label))\n\n    karr = np.array(kpoints)\n    # (n,4) with weight column (unused for bands run)\n    kwt = np.hstack([karr, np.ones((len(karr), 1))])\n    return kwt, labels\n\n\nbase_dir = \'calculations\'\nos.makedirs(base_dir, exist_ok=True)\n\nfor i in range(51):\n    nnn = f\'{i:03d}\'\n    cdir = os.path.join(base_dir, nnn)\n    os.makedirs(cdir, exist_ok=True)\n\n    # copy pseudos into the run dir (pseudo_dir=\'.\')\n    for el, fn in PSEUDOS.items():\n        shutil.copy(os.path.join(PSEUDO_SRC, fn), os.path.join(cdir, fn))\n\n    atoms = read(f\'structures/structure_{nnn}.cif\')\n\n    # INVARIANT 1: nat/ntyp from the actual Atoms object\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == 5 and ntyp == 3\n\n    # --- pw.in (SCF) ---\n    with open(os.path.join(cdir, \'pw.in\'), \'w\') as fd:\n        write_espresso_in(fd, atoms, input_data=dict(SCF_INPUT),\n                          pseudopotentials=PSEUDOS, kpts=SCF_KMESH)\n\n    # --- bands.in (non-SCF along k-path) ---\n    kwt, labels = build_kpath(atoms)\n    bands_input = dict(SCF_INPUT)\n    bands_input[\'calculation\'] = \'bands\'\n    bands_input[\'nbnd\'] = NBND_BANDS\n    with open(os.path.join(cdir, \'bands.in\'), \'w\') as fd:\n        write_espresso_in(fd, atoms, input_data=bands_input,\n                          pseudopotentials=PSEUDOS, kpts=kwt)\n\n    # --- bands_post.in (bands.x, hand-written &BANDS - no ASE writer) ---\n    with open(os.path.join(cdir, \'bands_post.in\'), \'w\') as fd:\n        fd.write(\'&BANDS\\n\')\n        fd.write(f"  prefix = \'{PREFIX}\'\\n")\n        fd.write("  outdir = \'./out\'\\n")\n        fd.write(f"  filband = \'{nnn}.bands.dat\'\\n")\n        fd.write(\'  lsym = .true.\\n\')\n        fd.write(\'/\\n\')\n\n    # --- band_labels.dat (label + index into the bands k-point list) ---\n    with open(os.path.join(cdir, \'band_labels.dat\'), \'w\') as fd:\n        for idx, lbl in labels:\n            fd.write(f\'{idx} {lbl}\\n\')\n\nprint(\'Wrote calculations/000 ... calculations/050\')\n'}}
