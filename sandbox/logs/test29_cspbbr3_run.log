t (including start, excluding end)\n\n\ndef get_kpath_for_structure(atoms):\n    """\n    Derive the k-path for a given structure using seekpath.\n    \n    Returns:\n        prim: Atoms object for the primitive cell (to be written into CELL_PARAMETERS)\n        path: list of (label_from, label_to) segments\n        point_coords: dict mapping label -> 3-vector (fractional in primitive cell)\n        kpoints: list of (kx, ky, kz, weight) tuples for the explicit k-point list\n        labels: list of (label, index) for each high-symmetry point in the k-point list\n    """\n    cell_tuple = (atoms.cell[:], atoms.get_scaled_positions(), atoms.get_atomic_numbers())\n    \n    # Use symprec=0.01 to match pymatgen\'s default and avoid under-detecting symmetry\n    res = seekpath.get_path(cell_tuple, symprec=0.01)\n    \n    # INVARIANT 3 check: space group from seekpath must match spglib\'s own analysis\n    spg = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01)\n    assert res[\'spacegroup_number\'] == spg.number, \\\n        f"Space group mismatch: seekpath={res[\'spacegroup_number\']}, spglib={spg.number}"\n    \n    # Build the primitive cell from seekpath\'s own reduced cell\n    prim = Atoms(\n        cell=res[\'primitive_lattice\'],\n        scaled_positions=res[\'primitive_positions\'],\n        numbers=res[\'primitive_types\'],\n        pbc=True\n    )\n    \n    path = res[\'path\']\n    point_coords = res[\'point_coords\']\n    \n    # Build the explicit k-point list\n    # Each segment: start point + interior points (PTS_PER_SEGMENT total per segment)\n    # The last point of each segment is the start of the next segment (except the last)\n    kpoints = []\n    labels = []  # (label, index) for high-symmetry points\n    \n    for i, (label_from, label_to) in enumerate(path):\n        start = np.array(point_coords[label_from])\n        end = np.array(point_coords[label_to])\n        \n        # Add the start point of this segment\n        # For the first segment, this is the very first point\n        # For subsequent segments, this is the end of the previous segment\n        # (which we already added as the last point of the previous segment)\n        if i == 0:\n            kpoints.append((start[0], start[1], start[2], 1.0))\n            labels.append((label_from, 0))\n        else:\n            # The start point of this segment is the same as the end point of the previous\n            # We already added it as the last point of the previous segment\n            # So we just need to add the label for this segment\'s start\n            # (which is the same point, but with a different label)\n            # Actually, we need to add the label for the start of this segment\n            # at the current index (which is the last point of the previous segment)\n            labels.append((label_from, len(kpoints) - 1))\n        \n        # Add interior points (excluding start, including end)\n        for j in range(1, PTS_PER_SEGMENT + 1):\n            t = j / PTS_PER_SEGMENT\n            k = start + t * (end - start)\n            kpoints.append((k[0], k[1], k[2], 1.0))\n        \n        # Add the label for the end of this segment\n        # (which is the start of the next segment, or the final point)\n        labels.append((label_to, len(kpoints) - 1))\n    \n    return prim, path, point_coords, kpoints, labels\n\n\ndef write_bands_post_in(filepath, prefix, outdir, filband):\n    """Write the bands.x post-processing input file."""\n    with open(filepath, \'w\') as f:\n        f.write("&BANDS\\n")\n        f.write(f"  prefix = \'{prefix}\',\\n")\n        f.write(f"  outdir = \'{outdir}\',\\n")\n        f.write(f"  filband = \'{filband}\'\\n")\n        f.write("/")\n\n\ndef setup_structure(nnn):\n    """Set up the calculation directory for structure NNN."""\n    calc_dir = f\'calculations/{nnn}\'\n    os.makedirs(calc_dir, exist_ok=True)\n    \n    # Copy pseudopotential files\n    for elem, pp_file in PP_FILES.items():\n        src = f\'template/{pp_file}\'\n        dst = f\'{calc_dir}/{pp_file}\'\n        if not os.path.exists(dst):\n            shutil.copy2(src, dst)\n    \n    # Read the structure\n    atoms = read(f\'structures/structure_{nnn}.cif\')\n    \n    # Derive the k-path and primitive cell\n    prim, path, point_coords, kpoints, labels = get_kpath_for_structure(atoms)\n    \n    # INVARIANT 1: assert nat/ntyp consistency\n    nat = len(prim)\n    ntyp = len(set(prim.get_chemical_symbols()))\n    assert nat == 5, f"Structure {nnn}: expected 5 atoms, got {nat}"\n    assert ntyp == 3, f"Structure {nnn}: expected 3 element types, got {ntyp}"\n    \n    # Pseudopotential mapping for write_espresso_in\n    pseudos = {elem: pp_file for elem, pp_file in PP_FILES.items()}\n    \n    # SCF input (pw.in)\n    scf_input_data = {\n        \'calculation\': \'scf\',\n        \'prefix\': PREFIX,\n        \'outdir\': OUTDIR,\n        \'pseudo_dir\': \'.\',\n        \'ecutwfc\': ECUTWFC,\n        \'ecutrho\': ECUTRHO,\n        \'occupations\': \'fixed\',\n        \'conv_thr\': CONV_THR,\n        \'nbnd\': NBND,\n    }\n    \n    # K-points for SCF: 4x4x4 Monkhorst-Pack\n    scf_kpts = (4, 4, 4)\n    \n    write_espresso_in(f\'{calc_dir}/pw.in\', prim, scf_input_data, pseudos, kpts=scf_kpts)\n    \n    # Bands input (bands.in)\n    bands_input_data = {\n        \'calculation\': \'bands\',\n        \'prefix\': PREFIX,\n        \'outdir\': OUTDIR,\n        \'pseudo_dir\': \'.\',\n        \'ecutwfc\': ECUTWFC,\n        \'ecutrho\': ECUTRHO,\n        \'occupations\': \'fixed\',\n        \'nbnd\': NBND,\n    }\n    \n    # K-points for bands: explicit list from the k-path\n    # Convert to numpy array of shape (n_kpts, 4)\n    kpts_array = np.array(kpoints)\n    \n    write_espresso_in(f\'{calc_dir}/bands.in\', prim, bands_input_data, pseudos, kpts=kpts_array)\n    \n    # Bands post-processing input (bands_post.in)\n    filband = f\'{nnn}.bands.dat\'\n    write_bands_post_in(f\'{calc_dir}/bands_post.in\', PREFIX, OUTDIR, filband)\n    \n    # Band labels file (for plotting)\n    with open(f\'{calc_dir}/band_labels.dat\', \'w\') as f:\n        for label, index in labels:\n            f.write(f"{label} {index}\\n")\n    \n    print(f"Setup complete for structure {nnn}: {len(kpoints)} k-points, "\n          f"path = {path}")\n    \n    return calc_dir\n\n\nif __name__ == \'__main__\':\n    # Set up all 51 structures\n    for i in range(51):\n        nnn = f\'{i:03d}\'\n        setup_structure(nnn)\n    \n    print("\\nAll 51 calculation directories set up.")\n    print("Next: validate calculations/000/pw.in and calculations/000/bands.in")\n'}}
