1.2,\n            color="blue"\n        )\n\n    # symmetry lines\n    for x in xcoords:\n\n        ax.axvline(\n            x,\n            lw=0.7,\n            color="black",\n            alpha=0.5\n        )\n\n    ax.axhline(\n        0.0,\n        lw=0.8,\n        color="black"\n    )\n\n    # labels\n    labels = ["R", r"$\\Gamma$", "X" , "M", r"$\\Gamma$"]\n\n    ax.set_xticks(xcoords)\n    ax.set_xticklabels(labels)\n    ax.set_ylabel("Energy (eV)")\n    ax.set_xlim(xcoords[0], xcoords[-1])\n    ax.set_ylim(YMIN, YMAX)\n\n    plt.tight_layout()\n\n    outfile = calc_dir / f"bands_{prefix}.pdf"\n\n    plt.savefig(outfile)\n    plt.close()\n\n    print("Wrote", outfile)\n\n# MAIN\nif __name__ == "__main__":\n\n    for calc_dir in sorted(Path("calculations").glob("*")):\n        try:\n            plot_bands(calc_dir)\n            \n        except Exception as e:\n            print(f"Failed for {calc_dir}: {e}")\n', 'truncated': False, 'total_chars': 2743}

