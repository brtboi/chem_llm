ems\'\n\n# GREEK label prettification for the plot\ndef pretty(lbl):\n    return lbl.replace(\'GAMMA\', r\'$\\Gamma$\')\n\n# --- draw ---\nfig, ax = plt.subplots(figsize=(7, 5))\n\n# split each band at path discontinuities so no line is drawn across a jump.\n# bands.x marks a discontinuity by REPEATING the k-distance (zero increment).\ndk = np.diff(kdist)\nsplit_idx = np.where(dk == 0.0)[0]  # index i where kdist[i+1] == kdist[i]\nsegments_bounds = []\nstart = 0\nfor si in split_idx:\n    segments_bounds.append((start, si + 1))  # inclusive of si\n    start = si + 1\nsegments_bounds.append((start, nk))\n\nfor bi in range(nbands):\n    for (s, e) in segments_bounds:\n        ax.plot(kdist[s:e], energies_aligned[bi, s:e], color=\'C0\', lw=0.8)\n\n# vertical lines at high-symmetry ticks\nfor xp in tick_pos:\n    ax.axvline(xp, color=\'k\', lw=0.5, alpha=0.5)\nax.axhline(0.0, color=\'r\', lw=0.6, ls=\'--\')  # VBM reference\n\nax.set_xticks(tick_pos)\nax.set_xticklabels([pretty(l) for l in tick_lbl])\nax.set_xlim(kdist.min(), kdist.max())\nax.set_ylim(-10, 10)   # +/-10 eV around VBM (aligned so VBM=0)\nax.set_ylabel(\'E - E_VBM (eV)\')\nax.set_title(f\'ZnO wurtzite band structure (gap = {gap:.2f} eV)\')\n\nfig.tight_layout()\nfig.savefig(f\'{CALC}/bands_000.pdf\')\nprint(f\'saved {CALC}/bands_000.pdf\')\n'}}
