RAW MODEL OUTPUT:
 {"tool": "write_file", "args": {"path": "generate_structures.py", "content": "\"\"\"STEP 2: generate 51 wurtzite ZnO structures.\n\nstructure_000.cif  = unperturbed primitive cell\nstructure_001..050 = perturbed copies (random thermal displacements + small lattice strain)\n\nUses only ASE + spglib + numpy. No pymatgen.\n\"\"\"\nimport numpy as np\nimport spglib\nfrom ase.io import read, write\nfrom ase import Atoms\n\nSYMPREC = 0.01  # matches pymatgen's SpacegroupAnalyzer default; spglib default 1e-5 under-detects on CIF-round-tripped coords\n\n# --- read base structure (from Materials Project, mp-1017539, P6_3mc #186) ---\nbase = read('structures/base.cif')\nn_orig = len(base)\nprint('original atom count:', n_orig)\n\n# --- build spglib cell tuple from the EXACT ASE Atoms object ---\ncell_tuple = (base.cell[:], base.get_scaled_positions(), base.get_atomic_numbers())\n\nsg_orig = spglib.get_symmetry_dataset(cell_tuple, symprec=SYMPREC).number\nprint('space group of base (spglib):', sg_orig)\nassert sg_orig == 186, f'expected P6_3mc #186, got {sg_orig}'\n\n# --- reduce to primitive cell (unit-cell-choice DECISION RULE) ---\nprim = spglib.standardize_cell(cell_tuple, to_primitive=True, no_idealize=False, symprec=SYMPREC)\nassert prim is not None, 'spglib primitive reduction failed'\nprim_cell, prim_scaled, prim_numbers = prim\nprimitive = Atoms(numbers=prim_numbers, scaled_positions=prim_scaled, cell=prim_cell, pbc=True)\nn_prim = len(primitive)\nprint('primitive atom count:', n_prim)\n\n# CHECK IN CODE: space group unchanged by reduction, and reduced count divides original evenly\nprim_tuple = (primitive.cell[:], primitive.get_scaled_positions(), primitive.get_atomic_numbers())\nsg_prim = spglib.get_symmetry_dataset(prim_tuple, symprec=SYMPREC).number\nassert sg_prim == sg_orig, f'space group changed by reduction: {sg_orig} -> {sg_prim}'\nassert n_orig % n_prim == 0, f'primitive count {n_prim} does not divide original {n_orig}'\n\n# helper for the nat/ntyp INVARIANT (computed from the actual Atoms object)\ndef check_nat_ntyp(atoms):\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat > 0 and ntyp > 0\n    return nat, ntyp\n\n# --- structure_000: unperturbed primitive base ---\nnat, ntyp = check_nat_ntyp(primitive)\nprint(f'structure_000: nat={nat} ntyp={ntyp}')\nwrite('structures/structure_000.cif', primitive)\n\n# --- perturbed structures 001..050 ---\n# Displacement magnitude justification:\n# Room-temperature RMS thermal displacement of atoms in oxides (from Debye-Waller\n# B-factors, B ~ 0.5-1 A^2, RMS = sqrt(B/(8*pi^2))) is ~0.08-0.11 A. We use a normal\n# distribution with stdev = 0.08 A per Cartesian component, a chemically reasonable\n# ~300 K thermal displacement scale. Lattice strain: small random isotropic + anisotropic\n# strain up to ~+/-2%, representative of thermal-expansion / cell-fluctuation magnitudes.\nDISP_STDEV = 0.08   # Angstrom, RMS thermal displacement at room temperature\nMAX_STRAIN = 0.02   # +/-2% lattice strain\n\nfor i in range(1, 51):\n    atoms = primitive.copy()\n    rng = np.random.default_rng(1000 + i)  # per-structure seeded RNG for reproducibility\n\n    # small random lattice strain: symmetric strain tensor with components in [-2%, +2%]\n    strain = np.zeros((3, 3))\n    strain[0, 0] = rng.uniform(-MAX_STRAIN, MAX_STRAIN)\n    strain[1, 1] = rng.uniform(-MAX_STRAIN, MAX_STRAIN)\n    strain[2, 2] = rng.uniform(-MAX_STRAIN, MAX_STRAIN)\n    strain[0, 1] = strain[1, 0] = 0.5 * rng.uniform(-MAX_STRAIN, MAX_STRAIN)\n    strain[0, 2] = strain[2, 0] = 0.5 * rng.uniform(-MAX_STRAIN, MAX_STRAIN)\n    strain[1, 2] = strain[2, 1] = 0.5 * rng.uniform(-MAX_STRAIN, MAX_STRAIN)\n    deformation = np.eye(3) + strain\n    # apply strain to cell while keeping fractional coordinates (scale_atoms=True)\n    new_cell = atoms.cell[:] @ deformation.T\n    atoms.set_cell(new_cell, scale_atoms=True)\n\n    # random thermal displacements (Gaussian, per-atom, per-Cartesian component)\n    atoms.rattle(stdev=DISP_STDEV, rng=rng)\n\n    nat, ntyp = check_nat_ntyp(atoms)\n    assert nat == n_prim and ntyp == 2, f'structure {i}: nat/ntyp mismatch'\n\n    write(f'structures/structure_{i:03d}.cif', atoms)\n\nprint('wrote structures 000..050')\n"}}
