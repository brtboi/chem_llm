 {"tool": "write_file", "args": {"path": "setup_jobs.py", "content": "\"\"\"STEP 5: set up QE SCF + bands + bands.x post-processing inputs for each structure.\n\nFor each structure NNN:\n  calculations/NNN/\n    Zn.upf, O.upf        (copied so pseudo_dir='.' resolves from inside the dir)\n    pw.in                (SCF, MP mesh)\n    bands.in             (non-self-consistent bands along seekpath-derived k-path)\n    bands_post.in        (bands.x &BANDS, filband='NNN.bands.dat')\n    band_labels.dat      (label + index in the bands k-point list)\n\nUses only ASE + spglib + seekpath + numpy. No pymatgen.\n\"\"\"\nimport os\nimport shutil\nimport glob\nimport numpy as np\nimport spglib\nimport seekpath\nfrom ase.io import read\nfrom ase.io.espresso import write_espresso_in\n\nSYMPREC = 0.01  # match pymatgen default; spglib's 1e-5 under-detects on CIF-round-tripped coords\n\n# --- INVARIANT 5: unit conversion for cutoffs ---\n# get_pseudopotential returned ecut = 42.0 Ha (hints ecut_unit='Ha') for BOTH Zn and O.\n# QE ecutwfc/ecutrho are in Rydberg. 1 Ha = 2 Ry.\nECUT_HA = 42.0\nECUTWFC_RY = 2.0 * ECUT_HA          # = 84.0 Ry\nECUTRHO_RY = 4.0 * ECUTWFC_RY       # = 336.0 Ry (norm-conserving standard: rho cutoff ~4x wfc)\nassert ECUTWFC_RY == 84.0 and ECUTRHO_RY == 336.0\n\n# --- INVARIANT 2: nbnd padding for bands run ---\n# Valence electrons per pseudo: Zn nv=4, O nv=2 -> 2*4 + 2*2 = 12 electrons -> 6 occupied bands.\n# Pad generously; re-checked against pw.out 'number of electrons' after SCF.\nNBND = 16\n\nSCF_KPTS = (6, 6, 4)  # Monkhorst-Pack: hexagonal wurtzite a=b short, c longer -> fewer k along c\nNPTS_PER_SEG = 20     # interpolated points per k-path segment\n\nPSEUDO_SRC = 'template'\nPSEUDOS = {'Zn': 'Zn.upf', 'O': 'O.upf'}\n\n\ndef build_kpath(atoms):\n    \"\"\"INVARIANT 3: derive an explicit k-path from THIS exact Atoms object via seekpath.\n\n    Returns (kpts_array (n,4) crystal coords weight=1, labels list of (index, label)).\n    Reprojects seekpath's primitive-cell named points onto atoms.cell.reciprocal()\n    through Cartesian, applying the 2*pi convention correctly.\n    \"\"\"\n    cell_tuple = (atoms.cell[:], atoms.get_scaled_positions(), atoms.get_atomic_numbers())\n    res = seekpath.get_path(cell_tuple, symprec=SYMPREC)\n\n    # self-consistency check: seekpath and spglib must agree at the same symprec\n    sg_spglib = spglib.get_symmetry_dataset(cell_tuple, symprec=SYMPREC).number\n    assert res['spacegroup_number'] == sg_spglib, (\n        f\"seekpath sg {res['spacegroup_number']} != spglib sg {sg_spglib}\")\n\n    recip_prim = np.array(res['reciprocal_primitive_lattice'])      # already includes 2*pi\n    recip_actual = 2 * np.pi * np.array(atoms.cell.reciprocal()[:])  # ASE has NO 2*pi -> add it\n\n    def to_actual_frac(frac_prim):\n        # go through Cartesian: seekpath's primitive cell may differ from the cell we wrote\n        cart = np.array(frac_prim) @ recip_prim\n        return cart @ np.linalg.inv(recip_actual)\n\n    point_coords_actual = {lbl: to_actual_frac(c) for lbl, c in res['point_coords'].items()}\n\n    kpts = []\n    labels = []  # (index_in_kpts, label)\n    prev_end_label = None\n    for (a, b) in res['path']:\n        ka = point_coords_actual[a]\n        kb = point_coords_actual[b]\n        start_idx = len(kpts)\n        # discontinuity: previous segment's end label != this segment's start label\n        if prev_end_label is not None and prev_end_label != a:\n            # mark the jump on the shared tick with both sides\n            labels[-1] = (labels[-1][0], f\"{prev_end_label}|{a}\")\n        else:\n            labels.append((start_idx, a))\n        # each segment contributes its own start point + interior points\n        seg = np.linspace(ka, kb, NPTS_PER_SEG, endpoint=True)\n        for j, kp in enumerate(seg):\n            if j == 0 and start_idx != 0 and prev_end_label == a:\n                # start point coincides with previous end already appended -> skip duplicate\n                continue\n            kpts.append(kp)\n        end_idx = len(kpts) - 1\n        labels.append((end_idx, b))\n        prev_end_label = b\n\n    kpts = np.array(kpts)\n    weights = np.ones((len(kpts), 1))\n    kpts4 = np.hstack([kpts, weights])\n    return kpts4, labels\n\n\ncif_files = sorted(glob.glob('structures/structure_*.cif'))\nassert len(cif_files) == 51, f'expected 51 structures, found {len(cif_files)}'\n\nfor cif in cif_files:\n    nnn = os.path.basename(cif).replace('structure_', '').replace('.cif', '')\n    outdir_calc = os.path.join('calculations', nnn)\n    os.makedirs(outdir_calc, exist_ok=True)\n\n    atoms = read(cif)\n\n    # INVARIANT 1: nat/ntyp computed from the actual Atoms object\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == 4 and ntyp == 2, f'{nnn}: nat={nat} ntyp={ntyp}'\n\n    # copy pseudopotentials so pseudo_dir='.' resolves from inside calculations/NNN\n    for el, fn in PSEUDOS.items():\n        shutil.copy(os.path.join(PSEUDO_SRC, fn), os.path.join(outdir_calc, fn))\n\n    common = {\n        'prefix': 'zno',\n        'outdir': './out',\n        'pseudo_dir': '.',\n        'ecutwfc': ECUTWFC_RY,   # Ry\n        'ecutrho': ECUTRHO_RY,   # Ry\n        'occupations': 'smearing',\n        'smearing': 'gaussian',\n        'degauss': 0.01,         # Ry, small smearing for robust convergence across perturbed cells\n        'conv_thr': 1.0e-8,\n    }\n\n    # --- SCF input (flat dict; ASE routes keys to correct namelists per INVARIANT 6) ---\n    scf_data = dict(common)\n    scf_data['calculation'] = 'scf'\n    with open(os.path.join(outdir_calc, 'pw.in'), 'w') as fd:\n        write_espresso_in(fd, atoms, input_data=scf_data,\n                          pseudopotentials=PSEUDOS, kpts=SCF_KPTS)\n\n    # --- bands input (non-scf along explicit k-path) ---\n    kpts4, labels = build_kpath(atoms)\n    bands_data = dict(common)\n    bands_data['calculation'] = 'bands'\n    bands_data['nbnd'] = NBND\n    with open(os.path.join(outdir_calc, 'bands.in'), 'w') as fd:\n        # kpts as np.ndarray (n,4) -> raw crystal-coord k-points with weight column\n        write_espresso_in(fd, atoms, input_data=bands_data,\n                          pseudopotentials=PSEUDOS, kpts=kpts4)\n\n    # --- bands.x post-processing input (ASE has no bands.x writer -> hand-write namelist) ---\n    with open(os.path.join(outdir_calc, 'bands_post.in'), 'w') as fd:\n        fd.write('&BANDS\\n')\n        fd.write(\"  prefix = 'zno'\\n\")\n        fd.write(\"  outdir = './out'\\n\")\n        fd.write(f\"  filband = '{nnn}.bands.dat'\\n\")\n        fd.write('/\\n')\n\n    # --- band_labels.dat: label + its index in the bands k-point list ---\n    with open(os.path.join(outdir_calc, 'band_labels.dat'), 'w') as fd:\n        for idx, lbl in labels:\n            fd.write(f'{idx} {lbl}\\n')\n\nprint('setup complete for', len(cif_files), 'structures')\n"}}
