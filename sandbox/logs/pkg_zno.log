 {"tool": "write_file", "args": {"path": "plot_bands.py", "content": "\"\"\"STEP 7: plot the band structure of calculations/000.\n\nReads the bands.x .gnu output (cumulative k-distance + energies in eV), aligns to\nthe VBM using the occupied-band count derived from pw.out (number of electrons / 2),\nplaces high-symmetry ticks in the SAME x units as the band data (INVARIANT 4),\nlabels genuine path discontinuities with both sides ('A|L'), draws no line across\nsuch jumps, restricts y to +/-10 eV around the VBM, saves bands_000.pdf, and prints\nVBM, CBM and band gap.\n\nUses only numpy + matplotlib (band data parsing) -- no pymatgen.\n\"\"\"\nimport re\nimport numpy as np\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\nCALC = 'calculations/000'\n\n# --- (a) occupied-band count from pw.out (INVARIANT 2): derive, do NOT guess ---\nwith open(f'{CALC}/pw.out') as f:\n    pw = f.read()\nm = re.search(r'number of electrons\\s*=\\s*([0-9.]+)', pw)\nassert m, 'could not find number of electrons in pw.out'\nn_elec = float(m.group(1))\n# spin-unpolarized, non-metallic: occupied bands = electrons / 2\nassert n_elec == round(n_elec)\nn_occ = int(round(n_elec / 2))\nprint(f'number of electrons = {n_elec} -> occupied bands = {n_occ}')\n\n# --- (b) parse the .gnu bands file (the real, non-empty output) ---\n# Format: blocks separated by blank lines, one block per band.\n# Each row: cumulative k-distance (2*pi/alat)   energy (eV).\ngnu_path = f'{CALC}/000.bands.dat.gnu'\nwith open(gnu_path) as f:\n    gnu_txt = f.read()\nblocks = [b for b in gnu_txt.strip().split('\\n\\n') if b.strip()]\nassert len(blocks) > 0, 'empty .gnu file'\n\nbands = []  # list of (kdist_array, energy_array) per band\nfor b in blocks:\n    rows = [ln.split() for ln in b.strip().splitlines() if ln.strip()]\n    arr = np.array([[float(r[0]), float(r[1])] for r in rows])\n    bands.append(arr)\n\nnbands = len(bands)\nnk = bands[0].shape[0]\nfor arr in bands:\n    assert arr.shape[0] == nk, 'inconsistent k-point count across bands'\nprint(f'parsed {nbands} bands x {nk} k-points from .gnu')\nassert nbands >= n_occ + 1, 'not enough bands to resolve the gap'\n\nkdist = bands[0][:, 0]            # cumulative k-distance shared by all bands (2*pi/alat)\nenergies = np.array([arr[:, 1] for arr in bands])  # shape (nbands, nk)\n\n# --- (c) VBM / CBM / gap from occupied-band count ---\nvb = energies[n_occ - 1]   # highest occupied band (index n_occ-1)\ncb = energies[n_occ]       # lowest unoccupied band\nvbm = vb.max()\ncbm = cb.min()\ngap = cbm - vbm\nprint(f'VBM = {vbm:.4f} eV')\nprint(f'CBM = {cbm:.4f} eV')\nprint(f'band gap = {gap:.4f} eV')\n\n# align energies to VBM\nenergies_aligned = energies - vbm\n\n# --- (d) high-symmetry ticks in the SAME x units (INVARIANT 4) ---\n# band_labels.dat: 'index label'. Index is an integer index into the k-point list.\n# Map each index to its cumulative k-distance kdist[index] (same units as band data).\nlabels_raw = []\nwith open(f'{CALC}/band_labels.dat') as f:\n    for ln in f:\n        ln = ln.strip()\n        if not ln:\n            continue\n        parts = ln.split(None, 1)\n        labels_raw.append((int(parts[0]), parts[1]))\n\n# Collapse consecutive duplicate labels at adjacent indices (same physical point\n# appended as one segment's end and the next segment's start). Keep discontinuity\n# markers ('A|L') as-is.\ncollapsed = []\nfor idx, lbl in labels_raw:\n    if collapsed and collapsed[-1][1] == lbl and abs(collapsed[-1][0] - idx) <= 1:\n        continue  # same label, adjacent index -> one tick\n    collapsed.append((idx, lbl))\n\ntick_pos = [kdist[idx] for idx, lbl in collapsed]\ntick_lbl = [lbl for idx, lbl in collapsed]\n\n# INVARIANT 4 check: ticks must span (approximately) the same numeric range as the band data\nassert abs(max(tick_pos) - kdist.max()) < 0.05 * kdist.max(), \\\n    f'tick span {max(tick_pos)} vs band k-col span {kdist.max()} -- different unit systems'\n\n# GREEK label prettification for the plot\ndef pretty(lbl):\n    return lbl.replace('GAMMA', r'$\\Gamma$')\n\n# --- draw ---\nfig, ax = plt.subplots(figsize=(7, 5))\n\n# split each band at path discontinuities so no line is drawn across a jump.\n# bands.x marks a discontinuity by REPEATING the k-distance (zero increment).\ndk = np.diff(kdist)\nsplit_idx = np.where(dk == 0.0)[0]  # index i where kdist[i+1] == kdist[i]\nsegments_bounds = []\nstart = 0\nfor si in split_idx:\n    segments_bounds.append((start, si + 1))  # inclusive of si\n    start = si + 1\nsegments_bounds.append((start, nk))\n\nfor bi in range(nbands):\n    for (s, e) in segments_bounds:\n        ax.plot(kdist[s:e], energies_aligned[bi, s:e], color='C0', lw=0.8)\n\n# vertical lines at high-symmetry ticks\nfor xp in tick_pos:\n    ax.axvline(xp, color='k', lw=0.5, alpha=0.5)\nax.axhline(0.0, color='r', lw=0.6, ls='--')  # VBM reference\n\nax.set_xticks(tick_pos)\nax.set_xticklabels([pretty(l) for l in tick_lbl])\nax.set_xlim(kdist.min(), kdist.max())\nax.set_ylim(-10, 10)   # +/-10 eV around VBM (aligned so VBM=0)\nax.set_ylabel('E - E_VBM (eV)')\nax.set_title(f'ZnO wurtzite band structure (gap = {gap:.2f} eV)')\n\nfig.tight_layout()\nfig.savefig(f'{CALC}/bands_000.pdf')\nprint(f'saved {CALC}/bands_000.pdf')\n"}}
