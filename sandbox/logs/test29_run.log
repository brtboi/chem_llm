    "content": "import numpy as np\nimport seekpath\nimport spglib\nfrom ase.io import read\n\n# Read the base CIF from Materials Project (mp-2657, P4_2/mnm #136)\nbase = read('structures/TiO2_base.cif')\nn_base = len(base)\nprint(f\"Base cell: {n_base} atoms, cell = {base.cell[:].tolist()}\")\n\ncell_tuple = (base.cell[:], base.get_scaled_positions(), base.get_atomic_numbers())\n\n# seekpath with symprec=0.01 (matches pymatgen default; spglib's 1e-5 default\n# can under-detect symmetry on CIF-round-tripped coordinates)\nres = seekpath.get_path(cell_tuple, symprec=0.01)\n\n# INVARIANT 3 check: seekpath's space group must agree with spglib's own analysis\nsg_spglib = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01).number\nassert res['spacegroup_number'] == sg_spglib, (\n    f\"space group mismatch: seekpath={res['spacegroup_number']}, spglib={sg_spglib}\")\nprint(f\"Space group: #{res['spacegroup_number']} ({res['spacegroup_symbol']})\")\n\n# Unit-cell-choice DECISION RULE: use seekpath's own primitive cell, because its\n# k-path coordinates refer to exactly this cell (makes INVARIANT 3 a no-op).\nfrom ase import Atoms\nprim = Atoms(\n    cell=res['primitive_lattice'],\n    scaled_positions=res['primitive_positions'],\n    numbers=res['primitive_types'],\n    pbc=True,\n)\nn_prim = len(prim)\nprint(f\"Primitive cell: {n_prim} atoms, cell = {prim.cell[:].tolist()}\")\n\n# CHECK: space group unchanged by reduction, and reduced count divides original\nassert n_base % n_prim == 0, f\"{n_base} not divisible by {n_prim}\"\nprim_tuple = (prim.cell[:], prim.get_scaled_positions(), prim.get_atomic_numbers())\nsg_prim = spglib.get_symmetry_dataset(prim_tuple, symprec=0.01).number\nassert sg_prim == res['spacegroup_number'], f\"reduction changed space group: {sg_prim}\"\n\n# Save the primitive cell as the canonical base structure for downstream steps\nfrom ase.io import write\nwrite('structures/TiO2_primitive.cif', prim)\nprint(f\"Saved primitive cell to structures/TiO2_primitive.cif\")\nprint(f\"Path: {res['path']}\")\nprint(f\"Point coords: {res['point_coords']}\")\n"
  }
