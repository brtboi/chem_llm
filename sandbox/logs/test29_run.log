1\n        \n        # Energies: nbnd/10 lines of 10 values each\n        n_lines = nbnd // 10\n        for j in range(n_lines):\n            vals = [float(x) for x in lines[line_idx].split()]\n            assert len(vals) == 10, f\"Expected 10 energies at line {line_idx+1}, got {len(vals)}\"\n            energies[ik, j*10:(j+1)*10] = vals\n            line_idx += 1\n    \n    assert line_idx == len(lines), f\"Expected {len(lines)} lines, parsed {line_idx}\"\n    return kpts, energies\n\n\ndef parse_labels(path):\n    \"\"\"Parse band_labels.dat: each line is 'label index'.\n    \n    Returns:\n        labels: list of (label, index) tuples\n    \"\"\"\n    labels = []\n    with open(path) as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            parts = line.split()\n            assert len(parts) == 2, f\"Expected 'label index', got: {line}\"\n            labels.append((parts[0], int(parts[1])))\n    return labels\n\n\ndef get_n_electrons(pw_out_path):\n    \"\"\"Extract 'number of electrons' from pw.out.\n    \n    INVARIANT 2: the occupied-band count is a property of the pseudopotential,\n    not the element. We read it directly from pw.out as ground truth.\n    \"\"\"\n    with open(pw_out_path) as f:\n        for line in f:\n            if 'number of electrons' in line:\n                # Format: \"number of electrons       =        48.00\"\n                m = re.search(r'number of electrons\\s*=\\s*([\\d.]+)', line)\n                assert m, f\"Cannot parse electron count from: {line}\"\n                n_elec = float(m.group(1))\n                assert n_elec == int(n_elec), f\"Non-integer electron count: {n_elec}\"\n                return int(n_elec)\n    raise ValueError(f\"'number of electrons' not found in {pw_out_path}\")\n\n\ndef main():\n    # Parse the bands data\n    kpts, energies = parse_bands_dat(BANDS_DAT)\n    nks, nbnd = energies.shape\n    print(f\"Parsed {BANDS_DAT}: {nks}