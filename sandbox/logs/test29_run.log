    "content": "import os\nimport shutil\nimport numpy as np\nimport seekpath\nimport spglib\nfrom ase.io import read, write\nfrom ase.io.espresso import write_espresso_in, write_fortran_namelist\nfrom ase import Atoms\n\n# =============================================================================\n# setup_jobs.py -- Generate QE input files for all 51 TiO2 structures\n# =============================================================================\n# QE settings (decided in STEP 4):\n#   SCF:   calculation='scf',  prefix='pw', outdir='./tmp', pseudo_dir='./'\n#          ecutwfc=84.0 Ry (2*42.0 Ha, INVARIANT 5), ecutrho=336.0 Ry (4*ecutwfc)\n#          occupations='fixed' (insulator), conv_thr=1e-8, kpts=(4,4,4) MP\n#   Bands: calculation='nscf', same prefix/outdir/pseudo_dir/ecutwfc/ecutrho\n#          nbnd=40 (generous padding; Ti spn=6 valence, O spn=4 valence,\n#          total electrons=2*6+4*4=32, occupied bands=16, so 40 is well above)\n#          kpts: explicit (n_kpts,4) array from seekpath path, 20 pts/segment\n#   bands.x: prefix='pw', outdir='./tmp', filband='NNN.bands.dat'\n# =============================================================================\n\nECUTWFC_RY = 84.0   # 2 * 42.0 Ha (INVARIANT 5: 1 Ha = 2 Ry)\nECUTRHO_RY = 336.0  # 4 * ecutwfc\nCONV_THR = 1e-8\nNBND = 40\nNPTS_PER_SEGMENT = 20\n\n# Pseudopotential files (in template/)\nTI_PSP = 'template/Ti.pbesol-spn-rrkjus_psl.1.0.0.UPF'\nO_PSP = 'template/O.pbesol-spn-rrkjus_psl.1.0.0.UPF'\n\n\ndef build_kpath(atoms):\n    \"\"\"Build the k-path for a given structure using seekpath.\n    \n    INVARIANT 3: the k-path must be generated from the EXACT same Atoms object\n    that is written into CELL_PARAMETERS. We use seekpath's primitive cell\n    (which is the same as atoms for our primitive-cell structures) and its\n    point_coords directly -- no re-projection needed.\n    \n    Returns:\n        kpts_array: (n_kpts, 4) numpy array in crystal coordinates\n        labels: list of (label, index) for each high-symmetry point\n        path: list of (label_from, label_to) segments\n    \"\"\"\n    cell_tuple = (atoms.cell[:], atoms.get_scaled_positions(), atoms.get_atomic_numbers())\n    res = seekpath.get_path(cell_tuple, symprec=0.01)\n    \n    # INVARIANT 3 check: space group must agree with spglib\n    sg_spglib = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01).number\n    assert res['spacegroup_number'] == sg_spglib, (\n        f\"space group mismatch: seekpath={res['spacegroup_number']}, spglib={sg_spglib}\")\n    \n    # Build the k-point list by interpolating each segment independently.\n    # INVARIANT 3: EVERY segment must contribute its own start point.\n    # The path is frequently DISCONTINUOUS -- consecutive segments need not\n    # join up. We record both labels at a jump.\n    path = res['path']\n    point_coords = res['point_coords']\n    \n    kpts_list = []  # list of (x, y, z) in crystal coords\n    labels = []     # list of (label, index_in_kpts_list)\n    \n    for i_seg, (label_from, label_to) in enumerate(path):\n        start = np.array(point_coords[label_from])\n        end = np.array(point_coords[label_to])\n        \n        # Add the start point of this segment\n        if i_seg == 0:\n            kpts_list.append(start)\n            labels.append((label_from, 0))\n        else:\n            # Check if this is a discontinuous jump (previous end != this start)\n            prev_end = np.array(point_coords[path[i_seg - 1][1]])\n            if not np.allclose(prev_end, start, atol=1e-10):\n                # Discontinuous jump: add start point with combined label\n                kpts_list.append(start)\n                labels.append((f\"{path[i_seg-1][1]}|{label_from}\", len(kpts_list) - 1))\n            else:\n                # Continuous: the start point is already the last point added\n                # (it was the end of the previous segment). Just update the label\n                # if needed -- actually, the label was already set when we added\n                # the end of the previous segment. We don't add a duplicate.\n                pass\n        \n        # Add interior points (excluding start, including end)\n        for i in range(1, NPTS_PER_SEGMENT + 1):\n            t = i / NPTS_PER_SEGMENT\n            pt = start + t * (end - start)\n            kpts_list.append(pt)\n            if i == NPTS_PER_SEGMENT:\n                # This is the end point of this segment\n                labels.append((label_to, len(kpts_list) - 1))\n    \n    kpts_array = np.array(kpts_list)\n    # Add weight column (constant 1.0, unused for non-SCF bands run)\n    kpts_array = np.column_stack([kpts_array, np.ones(len(kpts_array))])\n    \n    return kpts_array, labels, path\n\n\ndef write_bands_post_in(path, prefix, outdir, filband):\n    \"\"\"Write a bands.x input file using write_fortran_namelist.\"\"\"\n    with open(path, 'w') as f:\n        write_fortran_namelist(\n            f,\n            input_data={\n                'prefix': prefix,\n                'outdir': outdir,\n                'filband': filband,\n            },\n            binary='bands',\n        )\n\n\ndef main():\n    for n in range(51):\n        nnn = f\"{n:03d}\"\n        calc_dir = f\"calculations/{nnn}\"\n        os.makedirs(calc_dir, exist_ok=True)\n        \n        # Copy pseudopotentials into the calculation directory\n        # (pseudo_dir='./' means pw.x looks in the current directory)\n        shutil.copy(TI_PSP, calc_dir)\n        shutil.copy(O_PSP, calc_dir)\n        \n        # Read the structure\n        atoms = read(f\"structures/structure_{nnn}.cif\")\n        \n        # INVARIANT 1: nat and ntyp computed from the actual Atoms object\n        nat = len(atoms)\n        ntyp = len(set(atoms.get_chemical_symbols()))\n        assert nat == 6, f\"Structure {nnn}: expected 6 atoms, got {nat}\"\n        assert ntyp == 2, f\"Structure {nnn}: expected 2 species, got {ntyp}\"\n        \n        # Build the k-path from THIS structure (INVARIANT 3)\n        kpts_array, labels, path = build_kpath(atoms)\n        \n        # Pseudopotential mapping for write_espresso_in\n        # The pseudopotentials dict maps element symbol -> filename\n        pseudopotentials = {\n            'Ti': os.path.basename(TI_PSP),\n            'O': os.path.basename(O_PSP),\n        }\n        \n        # --- SCF input (pw.in) ---\n        scf_input_data = {\n            'calculation': 'scf',\n            'prefix': 'pw',\n            'outdir': './tmp',\n            'pseudo_dir': './',\n            'ecutwfc': Ecutwfc_RY,\n            'ecutrho': Ecutrho_RY,\n            'occupations': 'fixed',\n            'conv_thr': CONV_THR,\n        }\n        \n        with open(os.path.join(calc_dir, 'pw.in'), 'w') as f:\n            write_espresso_in(\n                f,\n                atoms,\n                input_data=scf_input_data,\n                pseudopotentials=pseudopotentials,\n                kpts=(4, 4, 4),  # Monkhorst-Pack grid\n            )\n        \n        # --- Bands input (bands.in) ---\n        bands_input_data = {\n            'calculation': 'nscf',\n            'prefix': 'pw',\n            'outdir': './tmp',\n            'pseudo_dir': './',\n            'ecutwfc': Ecutwfc_RY,\n            'ecutrho': Ecutrho_RY,\n            'nbnd': NBND,\n        }\n        \n        with open(os.path.join(calc_dir, 'bands.in'), 'w') as f:\n            write_espresso_in(\n                f,\n                atoms,\n                input_data=bands_input_data,\n                pseudopotentials=pseudopotentials,\n                kpts=kpts_array,  # explicit (n_kpts, 4) array in crystal coords\n            )\n        \n        # --- bands.x post-processing input (bands_post.in) ---\n        filband = f\"{nnn}.bands.dat\"\n        write_bands_post_in(\n            os.path.join(calc_dir, 'bands_post.in'),\n            prefix='pw',\n            outdir='./tmp',\n            filband=filband,\n        )\n        \n        # --- band_labels.dat ---\n        # Each line: label index (for plotting)\n        with open(os.path.join(calc_dir, 'band_labels.dat'), 'w') as f:\n            for label, idx in labels:\n                f.write(f\"{label} {idx}\\n\")\n        \n        print(f\"Wrote calculations/{nnn}/ (pw.in, bands.in, bands_post.in, band_labels.dat)\")\n    \n    print(\"\\nDone: all 51 calculation directories set up.\")\n\n\nif __name__ == '__main__':\n    main()\n"
  }
