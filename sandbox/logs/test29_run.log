    "content": "import numpy as np\nfrom ase.io import read, write\nfrom ase import Atoms\n\n# Read the primitive-cell base structure (6 atoms, P4_2/mnm #136, mp-2657)\nbase = read('structures/TiO2_primitive.cif')\nn_base = len(base)\nntyp_base = len(set(base.get_chemical_symbols()))\nprint(f\"Base primitive cell: {n_base} atoms, {ntyp_base} species\")\n\n# Displacement magnitude justification:\n# At room temperature (300 K), the RMS thermal displacement of an atom is\n# sqrt(k_B*T / (m*omega^2)). For TiO2, typical phonon frequencies are ~500-900 cm^-1.\n# For O (lighter, larger amplitude): ~0.05-0.08 A RMS.\n# For Ti (heavier): ~0.03-0.05 A RMS.\n# We use a uniform 0.05 A Gaussian displacement for all atoms as a reasonable\n# room-temperature thermal vibration scale that is chemically reasonable\n# (much smaller than bond lengths ~1.9-2.0 A, so no bond breaking).\nDISPLACEMENT_SIGMA = 0.05  # Angstrom, Gaussian sigma\n\n# Small random lattice strain: ~1% is typical for thermal expansion effects\n# and small structural distortions. Applied as a random symmetric strain tensor.\nSTRAIN_MAGNITUDE = 0.01  # 1% strain\n\nrng = np.random.default_rng(seed=42)\n\n# Structure 000: unperturbed base\nwrite('structures/structure_000.cif', base)\nprint(f\"Wrote structures/structure_000.cif (unperturbed, {n_base} atoms)\")\n\nfor i in range(1, 51):\n    atoms = base.copy()\n    \n    # Random atomic displacements (Gaussian, sigma = 0.05 A)\n    displacements = rng.normal(0.0, DISPLACEMENT_SIGMA, size=(len(atoms), 3))\n    atoms.positions += displacements\n    \n    # Small random lattice strain (symmetric tensor, magnitude ~1%)\n    # Generate a random symmetric 3x3 matrix and scale it\n    strain = rng.normal(0.0, STRAIN_MAGNITUDE, size=(3, 3))\n    strain = 0.5 * (strain + strain.T)  # make symmetric\n    # Apply strain to the cell: new_cell = (I + strain) @ old_cell\n    new_cell = (np.eye(3) + strain) @ atoms.cell[:]\n    atoms.cell = new_cell\n    \n    # INVARIANT 1: assert nat/ntyp are consistent with the actual Atoms object\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == n_base, f\"Structure {i:03d}: nat changed from {n_base} to {nat}\"\n    assert ntyp == ntyp_base, f\"Structure {i:03d}: ntyp changed from {ntyp_base} to {ntyp}\"\n    \n    fname = f'structures/structure_{i:03d}.cif'\n    write(fname, atoms)\n    print(f\"Wrote {fname} ({nat} atoms, {ntyp} species)\")\n\nprint(f\"\\nDone: wrote 51 structures (000-050) to structures/\")\n"
  }
}
