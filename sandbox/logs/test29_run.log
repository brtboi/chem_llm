 k-points, {nbnd} bands\")\n    \n    # Parse high-symmetry labels\n    labels = parse_labels(LABELS_DAT)\n    print(f\"Parsed {LABELS_DAT}: {len(labels)} high-symmetry points\")\n    \n    # Get electron count from pw.out (INVARIANT 2)\n    n_elec = get_n_electrons(PW_OUT)\n    n_occ = n_elec // 2  # spin-unpolarized\n    print(f\"Number of electrons: {n_elec}, occupied bands: {n_occ}\")\n    assert n_occ <= nbnd, f\"Occupied bands ({n_occ}) exceed nbnd ({nbnd})\"\n    \n    # INVARIANT 4: The x-axis must use the SAME units for band data and ticks.\n    # The band_labels.dat stores k-point INDICES (0, 20, 40, ...).\n    # We use the k-point index as the x-axis for both bands and ticks.\n    # This is a valid monotonic parameter along the path.\n    x = np.arange(nks, dtype=float)\n    \n    # INVARIANT 4 check: tick positions must span the same range as the band data\n    tick_positions = [idx for _, idx in labels]\n    assert abs(max(tick_positions) - x[-1]) < 0.05 * x[-1] + 1e-10, (\n        f\"Tick positions (max={max(tick_positions)}) don't match k-data range \"\n        f\"(max={x[-1]}) -- unit mismatch!\")\n    \n    # Align energies to VBM\n    # VBM = maximum of occupied band energies (band index n_occ-1, 0-based)\n    vbm = np.max(energies[:, :n_occ])\n    # CBM = minimum of unoccupied band energies (band index n_occ, 0-based)\n    cbm = np.min(energies[:, n_occ:])\n    band_gap = cbm - vbm\n    \n    print(f\"VBM = {vbm:.4f} eV\")\n    print(f\"CBM = {cbm:.4f} eV\")\n    print(f\"Band gap = {band_gap:.4f} eV\")\n    \n    # Shift energies so VBM is at 0\n    energies_shifted = energies - vbm\n    \n    # Identify discontinuities in the path\n    # A discontinuity occurs where the previous segment's end differs from\n    # the next segment's start. We detect this from the labels: a label\n    # containing '|' indicates a jump.\n    discontinuity_indices = set()\n    for label, idx in labels:\n        if '|' in label:\n            discontinuity_indices.add(idx)\n    \n    # Build the plot\n    fig, ax = plt.subplots(figsize=(10, 6))\n    \n    # Plot bands, splitting at discontinuities\n    # We need to break the line at each discontinuity point\n    in_segment = True\n    for ik in range(nks):\n        if ik in discontinuity_indices and ik > 0:\n            # This is a jump point -- start a new segment\n            in_segment = False\n        \n        if not in_segment:\n            in_segment = True\n            # Start a new line segment at this point\n            x_seg = [x[ik]]\n            y_seg = [[energies_shifted[ik, b]] for b in range(nbnd)]\n        else:\n            x_seg.append(x[ik])\n            for b in range(nbnd):\n                y_seg[b].append(energies_shifted[ik, b])\n        \n        # Check if this is the last point or a discontinuity\n        if ik == nks - 1 or (ik + 1 in discontinuity_indices):\n            # End of segment -- plot it\n            for b in range(nbnd):\n                ax.plot(x_seg, y_seg[b], 'b-', linewidth=0.8)\n            x_seg = []\n            y_seg = []\n    \n    # Add high-symmetry ticks\n    tick_pos = []\n    tick_labels = []\n    for label, idx in labels:\n        tick_pos.append(x[idx])\n        tick_labels.append(label)\n    \n    ax.set_xticks(tick_pos)\n    ax.set_xticklabels(tick_labels, fontsize=10)\n    \n    # Y-axis: +/-10 eV around VBM (which is now at 0)\n    ax.set_ylim(-10, 10)\n    ax.axhline(0, color='k', linewidth=0.5, linestyle='--')\n    \n    ax.set_xlabel('k-point', fontsize=12)\n    ax.set_ylabel('Energy (eV) relative to VBM', fontsize=12)\n    ax.set_title('TiO2 (rutile) Band Structure - PBEsol, 6-atom primitive cell', fontsize=12)\n    \n    plt.tight_layout()\n    plt.savefig(OUTPUT_PDF, dpi=150)\n    print(f\"Saved plot to {OUTPUT_PDF}\")\n\n\nif __name__ == '__main__':\n    main()\n"
