    "content": "import numpy as np\nfrom ase.io import read, write\nfrom ase import Atoms\n\n# Read the primitive base structure (2 C atoms, Fd-3m #227)\nbase = read('structures/base_C_primitive.cif')\nn_base = len(base)\nntyp_base = len(set(base.get_chemical_symbols()))\nprint(f\"Base structure: {n_base} atoms, {ntyp_base} element types\")\n\n# Displacement magnitude justification:\n# At room temperature (300 K), the typical thermal displacement of a carbon atom\n# in diamond is on the order of 0.01-0.05 Angstrom (from Debye-Waller factors).\n# We use 0.05 A as a conservative upper bound for \"chemically reasonable\" random\n# displacements that do not break bonds but do perturb the structure enough to\n# test the workflow. The lattice strain is kept small (~1%) to avoid distorting\n# the crystal beyond the harmonic regime.\nDISPLACEMENT_SIGMA = 0.05  # Angstrom, ~room-temperature thermal displacement\nSTRAIN_SIGMA = 0.01        # 1% random lattice strain\n\nrng = np.random.default_rng(seed=42)\n\nfor i in range(51):\n    if i == 0:\n        # Unperturbed base structure\n        atoms = base.copy()\n    else:\n        atoms = base.copy()\n        # Random atomic displacements (Gaussian, sigma = 0.05 A)\n        displacements = rng.normal(0.0, DISPLACEMENT_SIGMA, size=atoms.positions.shape)\n        atoms.positions += displacements\n        # Small random lattice strain (symmetric 3x3 matrix, sigma = 1%)\n        strain = rng.normal(0.0, STRAIN_SIGMA, size=(3, 3))\n        # Make strain symmetric to avoid shear-only distortions\n        strain = 0.5 * (strain + strain.T)\n        # Apply strain to the cell: new_cell = (I + strain) @ old_cell\n        atoms.cell = (np.eye(3) + strain) @ atoms.cell.array\n        # Wrap positions back into the cell to keep them in the primary cell\n        atoms.wrap()\n\n    # INVARIANT 1: nat and ntyp must be computed from the actual Atoms object\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == n_base, f\"Structure {i:03d}: nat changed from {n_base} to {nat}\"\n    assert ntyp == ntyp_base, f\"Structure {i:03d}: ntyp changed from {ntyp_base} to {ntyp}\"\n\n    out_path = f'structures/structure_{i:03d}.cif'\n    write(out_path, atoms)\n    print(f\"Wrote {out_path}: {nat} atoms, {ntyp} types\")\n\nprint(\"Done: 51 structures written (000 = unperturbed, 001-050 = perturbed)\")\n"
  }
}
