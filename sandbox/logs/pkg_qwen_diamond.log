 {'tool': 'write_file', 'args': {'path': 'setup_jobs.py', 'content': 'import os\nimport shutil\nimport numpy as np\nimport spglib\nimport seekpath\nfrom ase.io import read, write\nfrom ase.io.espresso import write_espresso_in, write_fortran_namelist\n\n# =============================================================================\n# setup_jobs.py -- Create QE input files for each structure\n# =============================================================================\n\n# Pseudopotential settings (from STEP 3)\n# Recommended ecut = 41.0 Ha (Hartree) from get_pseudopotential\n# Per INVARIANT 5: 1 Ha = 2 Ry, so ecutwfc = 2 * 41.0 = 82.0 Ry\nECUT_HA = 41.0\nECUTWFC_RY = 2.0 * ECUT_HA  # 82.0 Ry\nECUTRHO_RY = 4.0 * ECUTWFC_RY  # 328.0 Ry\nassert abs(ECUTWFC_RY - 82.0) < 1e-10, f"ecutwfc conversion error: {ECUTWFC_RY}"\nassert abs(ECUTRHO_RY - 328.0) < 1e-10, f"ecutrho conversion error: {ECUTRHO_RY}"\n\n# Common QE settings\nPREFIX = \'pw\'\nOUTDIR = \'./tmp\'\nCONV_THR = 1.0e-8  # Ry\n\n# SCF k-point mesh (Monkhorst-Pack, reasonable for 2-atom diamond primitive cell)\nSCF_KPTS = (4, 4, 4)\n\n# nbnd for bands calculation: padded generously above expected occupied bands.\n# Diamond C: 2 atoms * 2 valence e- = 4 e- total, occupied bands = 2.\n# nbnd = 20 is well above this and captures conduction bands up to ~10 eV.\n# Per INVARIANT 2: after SCF, verify against \'number of electrons\' in pw.out.\nNBND = 20\n\n# Number of k-points per segment in the band path\nNPTS_PER_SEGMENT = 50\n\n\ndef build_kpath(atoms):\n    """\n    Build an explicit k-point list for the band structure calculation.\n    \n    Per INVARIANT 3:\n    - Use seekpath.get_path with symprec=0.01 (not the tight 1e-5 default)\n    - Reproject point coordinates from seekpath\'s reciprocal primitive lattice\n      to the actual cell\'s reciprocal lattice via Cartesian coordinates\n    - Handle path discontinuities: each segment contributes its own start point\n    - Return: (kpts_array, labels, label_indices, discontinuities)\n      where kpts_array is (n_kpts, 4) in crystal coordinates of the actual cell,\n      labels is a list of label strings (one per high-symmetry point),\n      label_indices is a list of (index, label) for each high-symmetry point,\n      discontinuities is a list of indices where the path jumps.\n    """\n    cell_tuple = (atoms.cell[:], atoms.get_scaled_positions(), atoms.get_atomic_numbers())\n    \n    # Get the k-path from seekpath\n    res = seekpath.get_path(cell_tuple, symprec=0.01)\n    \n    # Verify space group consistency with spglib\n    ds = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01)\n    assert res[\'spacegroup_number\'] == ds.number, \\\n        f"Space group mismatch: seekpath={res[\'spacegroup_number\']}, spglib={ds.number}"\n    \n    # Reprojection: seekpath\'s point_coords are in its own reciprocal primitive\n    # lattice (which includes 2*pi). We need to convert to the actual cell\'s\n    # reciprocal lattice (ASE\'s atoms.cell.reciprocal() does NOT include 2*pi).\n    recip_prim = np.array(res[\'reciprocal_primitive_lattice\'])  # includes 2*pi\n    recip_actual = 2 * np.pi * np.array(atoms.cell.reciprocal()[:])  # add 2*pi\n    \n    def to_actual_frac(frac_prim):\n        """Convert fractional coords in seekpath\'s reciprocal primitive lattice\n        to fractional coords in the actual cell\'s reciprocal lattice."""\n        cart = np.array(frac_prim) @ recip_prim  # Cartesian (2*pi/alat units)\n        return cart @ np.linalg.inv(recip_actual)  # back to fractional\n    \n    # Build the explicit k-point list\n    # res[\'path\'] is a list of (label_from, label_to) segments\n    # res[\'point_coords\'] maps label -> fractional coords in recip_prim\n    \n    kpts_list = []  # list of (3,) arrays in actual-cell fractional coords\n    labels = []     # high-symmetry labels in order\n    label_indices = []  # (index_in_kpts_list, label)\n    discontinuities = []  # indices where path jumps\n    \n    for seg_idx, (lbl_from, lbl_to) in enumerate(res[\'path\']):\n        # Get the start and end points in actual-cell fractional coords\n        start_frac = to_actual_frac(res[\'point_coords\'][lbl_from])\n        end_frac = to_actual_frac(res[\'point_coords\'][lbl_to])\n        \n        # Check for discontinuity: if this is not the first segment, compare\n        # the previous segment\'s end with this segment\'s start\n        if seg_idx > 0:\n            prev_end = kpts_list[-1]  # last point of previous segment\n            if np.linalg.norm(prev_end - start_frac) > 1e-6:\n                # Discontinuity: record the index where the jump occurs\n                # The jump is between kpts_list[-1] and the new start point\n                discontinuities.append(len(kpts_list))  # index of the new start\n                # Label this point with both sides\n                combined_label = f"{lbl_from}|{lbl_to}" if False else None\n                # Actually, the discontinuity is between the previous segment\'s\n                # end label and this segment\'s start label. We need to track\n                # which labels are at which positions.\n        \n        # Add the start point (always, even for first segment)\n        if seg_idx == 0:\n            kpts_list.append(start_frac)\n            labels.append(lbl_from)\n            label_indices.append((0, lbl_from))\n        else:\n            # For subsequent segments, the start point is a new point\n            # (it may or may not be the same as the previous end)\n            kpts_list.append(start_frac)\n            # The label at this position: if discontinuous, use combined label\n            if len(discontinuities) > 0 and discontinuities[-1] == len(kpts_list) - 1:\n                # This is a discontinuity point\n                # The previous segment ended at some label, this one starts at lbl_from\n                # We need to know the previous segment\'s end label\n                # res[\'path\'][seg_idx-1] = (prev_from, prev_to)\n                prev_lbl_to = res[\'path\'][seg_idx - 1][1]\n                combined = f"{prev_lbl_to}|{lbl_from}"\n                labels.append(combined)\n                label_indices.append((len(kpts_list) - 1, combined))\n            else:\n                labels.append(lbl_from)\n                label_indices.append((len(kpts_list) - 1, lbl_from))\n        \n        # Add interior points (linearly interpolate from start to end)\n        for i in range(1, NPTS_PER_SEGMENT):\n            t = i / NPTS_PER_SEGMENT\n            pt = (1 - t) * start_frac + t * end_frac\n            kpts_list.append(pt)\n        \n        # Add the end point\n        kpts_list.append(end_frac)\n        labels.append(lbl_to)\n        label_indices.append((len(kpts_list) - 1, lbl_to))\n    \n    # Build the (n_kpts, 4) array for write_espresso_in\n    # Column 4 is weight (unused for non-SCF bands run, set to 1.0)\n    n_kpts = len(kpts_list)\n    kpts_array = np.zeros((n_kpts, 4))\n    for i, pt in enumerate(kpts_list):\n        kpts_array[i, :3] = pt\n        kpts_array[i, 3] = 1.0  # weight (unused)\n    \n    return kpts_array, labels, label_indices, discontinuities\n\n\ndef setup_structure(nnn, atoms, psp_files):\n    """\n    Set up the calculation directory for structure NNN.\n    \n    Creates calculations/NNN/ with:\n    - Pseudopotential files (copied from template/)\n    - pw.in (SCF input)\n    - bands.in (non-SCF bands input)\n    - bands_post.in (bands.x input)\n    - band_labels.dat (high-symmetry labels and indices)\n    """\n    calc_dir = f\'calculations/{nnn}\'\n    os.makedirs(calc_dir, exist_ok=True)\n    \n    # Copy pseudopotential files into the calculation directory\n    # (pseudo_dir = \'./\' so pw.x looks in the current directory)\n    for psp in psp_files:\n        src = f\'template/{psp}\'\n        dst = f\'{calc_dir}/{psp}\'\n        if not os.path.exists(dst):\n            shutil.copy2(src, dst)\n    \n    # INVARIANT 1: nat and ntyp computed from the actual Atoms object\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    \n    # Build the k-path for the bands calculation\n    kpts_array, labels, label_indices, discontinuities = build_kpath(atoms)\n    \n    # --- SCF input (pw.in) ---\n    scf_input_data = {\n        \'calculation\': \'scf\',\n        \'prefix\': PREFIX,\n        \'outdir\': OUTDIR,\n        \'pseudo_dir\': \'./\',\n        \'ecutwfc\': ECUTWFC_RY,\n        \'ecutrho\': ECUTRHO_RY,\n        \'occupations\': \'fixed\',\n        \'conv_thr\': CONV_THR,\n        \'nat\': nat,\n        \'ntyp\': ntyp,\n    }\n    \n    # Pseudopotential mapping: element symbol -> filename\n    # For diamond C, there is only one element\n    elements = sorted(set(atoms.get_chemical_symbols()))\n    pseudopotentials = {}\n    for el in elements:\n        # Find the pseudopotential file for this element\n        for psp in psp_files:\n            if psp.startswith(el + \'.\'):\n                pseudopotentials[el] = psp\n                break\n    \n    write_espresso_in(\n        f\'{calc_dir}/pw.in\',\n        atoms,\n        input_data=scf_input_data,\n        pseudopotentials=pseudopotentials,\n        kpts=SCF_KPTS,\n        crystal_coordinates=True,\n    )\n    \n    # --- Bands input (bands.in) ---\n    bands_input_data = {\n        \'calculation\': \'bands\',\n        \'prefix\': PREFIX,\n        \'outdir\': OUTDIR,\n        \'pseudo_dir\': \'./\',\n        \'ecutwfc\': ECUTWFC_RY,\n        \'ecutrho\': ECUTRHO_RY,\n        \'occupations\': \'fixed\',\n        \'conv_thr\': CONV_THR,\n        \'nbnd\': NBND,\n        \'nat\': nat,\n        \'ntyp\': ntyp,\n    }\n    \n    write_espresso_in(\n        f\'{calc_dir}/bands.in\',\n        atoms,\n        input_data=bands_input_data,\n        pseudopotentials=pseudopotentials,\n        kpts=kpts_array,  # explicit (n_kpts, 4) array\n        crystal_coordinates=True,\n    )\n    \n    # --- Bands post-processing input (bands_post.in) ---\n    # bands.x input: &BANDS namelist with prefix, outdir, filband\n    bands_post_input_data = {\n        \'prefix\': PREFIX,\n        \'outdir\': OUTDIR,\n        \'filband\': f\'{nnn}.bands.dat\',\n    }\n    \n    with open(f\'{calc_dir}/bands_post.in\', \'w\') as f:\n        write_fortran_namelist(f, bands_post_input_data, binary=\'bands\')\n    \n    # --- Band labels file (band_labels.dat) ---\n    # Each line: index label\n    # For discontinuities, the label is \'X|Y\'\n    with open(f\'{calc_dir}/band_labels.dat\', \'w\') as f:\n        for idx, lbl in label_indices:\n            f.write(f"{idx} {lbl}\\n")\n    \n    # Also write the discontinuity info for plotting\n    with open(f\'{calc_dir}/discontinuities.dat\', \'w\') as f:\n        for idx in discontinuities:\n            f.write(f"{idx}\\n")\n    \n    print(f"Setup complete for {calc_dir}: {nat} atoms, {ntyp} types, "\n          f"{len(kpts_array)} k-points, {len(label_indices)} labels, "\n          f"{len(discontinuities)} discontinuities")\n\n\ndef main():\n    # Pseudopotential files (from template/)\n    psp_files = [\'C.pbesol-sr-pp.upf\']\n    \n    # Process all 51 structures\n    for i in range(51):\n        nnn = f\'{i:03d}\'\n        cif_path = f\'structures/structure_{nnn}.cif\'\n        atoms = read(cif_path)\n        setup_structure(nnn, atoms, psp_files)\n    \n    print("\\nAll 51 calculation directories set up.")\n\n\nif __name__ == \'__main__\':\n    main()\n'}}
