 {'tool': 'write_file', 'args': {'path': 'plot_bands.py', 'content': 'import numpy as np\nimport matplotlib\nmatplotlib.use(\'Agg\')\nimport matplotlib.pyplot as plt\nimport re\n\n# =============================================================================\n# plot_bands.py -- Plot the band structure for calculations/000\n# =============================================================================\n\nCALC_DIR = \'calculations/000\'\nBANDS_DAT = f\'{CALC_DIR}/000.bands.dat\'\nLABELS_DAT = f\'{CALC_DIR}/band_labels.dat\'\nDISCONT_DAT = f\'{CALC_DIR}/discontinuities.dat\'\nPW_OUT = f\'{CALC_DIR}/pw.out\'\nOUTPUT_PDF = f\'{CALC_DIR}/bands_000.pdf\'\n\n# -----------------------------------------------------------------------------\n# 1. Read the number of electrons from pw.out to determine occupied bands\n# -----------------------------------------------------------------------------\nwith open(PW_OUT, \'r\') as f:\n    pw_content = f.read()\n\n# Find \'number of electrons = X.XX\'\nmatch = re.search(r\'number of electrons\\s*=\\s*([\\d.]+)\', pw_content)\nassert match is not None, "Could not find \'number of electrons\' in pw.out"\nn_electrons = float(match.group(1))\nprint(f"Number of electrons from pw.out: {n_electrons}")\n\n# For spin-unpolarized non-metallic run: occupied bands = n_electrons / 2\nn_occ = int(n_electrons / 2)\nprint(f"Occupied bands: {n_occ}")\n\n# -----------------------------------------------------------------------------\n# 2. Parse the bands.dat file\n# -----------------------------------------------------------------------------\n# Format: first line is &plot nbnd=N, nks=M /\n# Then for each k-point: a line with 3 k-coordinates (in 2*pi/alat units),\n# followed by lines with 10 energies per line (in eV).\n\nwith open(BANDS_DAT, \'r\') as f:\n    lines = f.readlines()\n\n# Parse the header line\nheader = lines[0].strip()\nmatch_nbnd = re.search(r\'nbnd=\\s*(\\d+)\', header)\nmatch_nks = re.search(r\'nks=\\s*(\\d+)\', header)\nassert match_nbnd is not None, f"Could not parse nbnd from header: {header}"\nassert match_nks is not None, f"Could not parse nks from header: {header}"\nnbnd = int(match_nbnd.group(1))\nnks = int(match_nks.group(1))\nprint(f"Header: nbnd={nbnd}, nks={nks}")\n\n# Parse k-points and energies\nk_points = []  # list of (3,) arrays in 2*pi/alat units\nenergies = []  # list of (nbnd,) arrays in eV\n\ni = 1\nwhile i < len(lines):\n    line = lines[i].strip()\n    if not line:\n        i += 1\n        continue\n    \n    # Check if this is a k-point line (3 numbers) or an energy line (10 numbers)\n    parts = line.split()\n    if len(parts) == 3:\n        # K-point line\n        k = np.array([float(parts[0]), float(parts[1]), float(parts[2])])\n        k_points.append(k)\n        i += 1\n        \n        # Read energy lines until we have nbnd energies\n        band_energies = []\n        while len(band_energies) < nbnd and i < len(lines):\n            eline = lines[i].strip()\n            if not eline:\n                i += 1\n                continue\n            eparts = eline.split()\n            band_energies.extend([float(x) for x in eparts])\n            i += 1\n        \n        assert len(band_energies) == nbnd, \\\n            f"Expected {nbnd} energies, got {len(band_energies)}"\n        energies.append(np.array(band_energies))\n    else:\n        # This should not happen -- skip\n        i += 1\n\nassert len(k_points) == nks, f"Expected {nks} k-points, got {len(k_points)}"\nassert len(energies) == nks, f"Expected {nks} energy sets, got {len(energies)}"\nprint(f"Parsed {len(k_points)} k-points, {nbnd} bands each")\n\n# -----------------------------------------------------------------------------\n# 3. Compute cumulative path distance from k-coordinates\n# -----------------------------------------------------------------------------\n# The k-coordinates are in 2*pi/alat units (Cartesian reciprocal space).\n# Cumulative distance is the sum of Euclidean distances between consecutive k-points.\n# At a discontinuity, the distance between the last point of the previous segment\n# and the first point of the next segment is NOT added (the path jumps).\n\n# Read discontinuities\ndiscontinuities = set()\nwith open(DISCONT_DAT, \'r\') as f:\n    for line in f:\n        line = line.strip()\n        if line:\n            discontinuities.add(int(line))\n\nprint(f"Discontinuities at indices: {sorted(discontinuities)}")\n\n# Compute cumulative distances\ncum_dist = np.zeros(nks)\nfor i in range(1, nks):\n    if i in discontinuities:\n        # At a discontinuity, the distance from the previous point is NOT added\n        # (the path jumps, so we don\'t include that segment in the cumulative distance)\n        cum_dist[i] = cum_dist[i - 1]\n    else:\n        d = np.linalg.norm(k_points[i] - k_points[i - 1])\n        cum_dist[i] = cum_dist[i - 1] + d\n\nprint(f"Cumulative distance range: {cum_dist[0]:.4f} to {cum_dist[-1]:.4f}")\n\n# -----------------------------------------------------------------------------\n# 4. Read band labels for tick positions\n# -----------------------------------------------------------------------------\nlabels = []  # list of (index, label_string)\nwith open(LABELS_DAT, \'r\') as f:\n    for line in f:\n        line = line.strip()\n        if line:\n            parts = line.split()\n            idx = int(parts[0])\n            lbl = parts[1]\n            labels.append((idx, lbl))\n\nprint(f"Labels: {labels}")\n\n# -----------------------------------------------------------------------------\n# 5. Align energies to VBM\n# -----------------------------------------------------------------------------\n# VBM = maximum energy among occupied bands (bands 0 to n_occ-1)\n# CBM = minimum energy among unoccupied bands (bands n_occ to nbnd-1)\n\nall_energies = np.array(energies)  # shape (nks, nbnd)\n\n# VBM: max over all k-points of the max occupied band energy\nvbm = np.max(all_energies[:, :n_occ])\n# CBM: min over all k-points of the min unoccupied band energy\ncbm = np.min(all_energies[:, n_occ:])\nband_gap = cbm - vbm\n\nprint(f"VBM: {vbm:.4f} eV")\nprint(f"CBM: {cbm:.4f} eV")\nprint(f"Band gap: {band_gap:.4f} eV")\n\n# Shift all energies so VBM = 0\nall_energies_shifted = all_energies - vbm\n\n# -----------------------------------------------------------------------------\n# 6. Plot the band structure\n# -----------------------------------------------------------------------------\n# INVARIANT 4: The x-axis (cumulative distance) and tick positions must be in\n# the same units. We use cum_dist for both the band curves and the tick marks.\n\n# Check that tick positions span approximately the same range as the band data\n# The tick positions are cum_dist[label_idx] for each label\n# The band data x-range is cum_dist[0] to cum_dist[-1]\ntick_positions = [cum_dist[idx] for idx, lbl in labels]\nassert abs(max(tick_positions) - cum_dist[-1]) < 0.05 * cum_dist[-1], \\\n    f"Tick positions ({max(tick_positions):.4f}) do not span the same range as band data ({cum_dist[-1]:.4f})"\n\nfig, ax = plt.subplots(figsize=(10, 6))\n\n# Plot each band\nfor band_idx in range(nbnd):\n    ax.plot(cum_dist, all_energies_shifted[:, band_idx], \'b-\', linewidth=0.8)\n\n# Add high-symmetry ticks\n# For discontinuities, label with both sides (e.g., \'U|K\')\n# Draw a vertical line at each discontinuity to mark the jump\nfor idx, lbl in labels:\n    x_pos = cum_dist[idx]\n    ax.axvline(x=x_pos, color=\'gray\', linestyle=\'--\', linewidth=0.5, alpha=0.5)\n    ax.set_xticks(tick_positions)\n    ax.set_xticklabels([lbl for _, lbl in labels], rotation=0, fontsize=10)\n\n# Mark discontinuities with a thicker line\nfor disc_idx in sorted(discontinuities):\n    x_pos = cum_dist[disc_idx]\n    ax.axvline(x=x_pos, color=\'red\', linestyle=\'-\', linewidth=1.5, alpha=0.7)\n\n# Set y-axis limits: +/-10 eV around VBM (which is now at 0)\nax.set_ylim(-10, 10)\nax.set_xlabel(\'k-path (2$\\pi$/a units)\')\nax.set_ylabel(\'Energy (eV) relative to VBM\')\nax.set_title(\'Diamond C band structure (PBEsol, SCF converged)\')\nax.grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.savefig(OUTPUT_PDF, dpi=150, bbox_inches=\'tight\')\nprint(f"Saved plot to {OUTPUT_PDF}")\n\n# -----------------------------------------------------------------------------\n# 7. Print summary\n# -----------------------------------------------------------------------------\nprint("\\n=== Band Structure Summary ===")\nprint(f"VBM: {vbm:.4f} eV")\nprint(f"CBM: {cbm:.4f} eV")\nprint(f"Band gap: {band_gap:.4f} eV")\nprint(f"Number of occupied bands: {n_occ}")\nprint(f"Number of total bands: {nbnd}")\nprint(f"Number of k-points: {nks}")\nprint(f"Discontinuities: {sorted(discontinuities)}")\n'}}
