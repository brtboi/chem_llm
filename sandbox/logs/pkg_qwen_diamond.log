    "content": "import numpy as np\nimport spglib\nfrom ase.io import read, write\n\n# Read the base CIF (conventional Fd-3m cell, 8 atoms expected for diamond)\nbase = read('structures/base_C.cif')\nn_base = len(base)\nprint(f\"Base cell: {n_base} atoms, cell =\\n{base.cell.array}\")\n\ncell_tuple = (base.cell[:], base.get_scaled_positions(), base.get_atomic_numbers())\n\n# Space group of the base structure (symprec=0.01 to match pymatgen default)\nds_base = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01)\nprint(f\"Base space group number: {ds_base.number}, symbol: {ds_base.international}\")\n\n# Reduce to primitive cell\nprim = spglib.standardize_cell(cell_tuple, to_primitive=True, no_idealize=False, symprec=0.01)\nassert prim is not None, \"standardize_cell failed\"\nprim_cell, prim_pos, prim_types = prim['cell'], prim['scaled_positions'], prim['numbers']\nn_prim = len(prim_types)\nprint(f\"Primitive cell: {n_prim} atoms\")\n\n# CHECK: reduced atom count divides the original evenly\nassert n_base % n_prim == 0, f\"{n_base} not divisible by {n_prim}\"\n\n# Build ASE Atoms for the primitive cell\nfrom ase import Atoms\nprim_atoms = Atoms(\n    symbols=[prim_types[i] for i in range(n_prim)],\n    positions=prim_pos @ prim_cell,\n    cell=prim_cell,\n    pbc=True,\n)\n\n# CHECK: space group unchanged by the reduction\ncell_tuple_prim = (prim_atoms.cell[:], prim_atoms.get_scaled_positions(), prim_atoms.get_atomic_numbers())\nds_prim = spglib.get_symmetry_dataset(cell_tuple_prim, symprec=0.01)\nprint(f\"Primitive space group number: {ds_prim.number}, symbol: {ds_prim.international}\")\nassert ds_prim.number == ds_base.number, f\"Space group changed: {ds_base.number} -> {ds_prim.number}\"\n\n# Write the primitive cell as the new base structure\nwrite('structures/base_C_primitive.cif', prim_atoms)\nprint(f\"Wrote structures/base_C_primitive.cif with {n_prim} atoms\")\nprint(f\"Primitive cell vectors:\\n{prim_atoms.cell.array}\")\nprint(f\"Atomic positions (Cartesian):\\n{prim_atoms.get_positions()}\")\nprint(f\"Scaled positions:\\n{prim_atoms.get_scaled_positions()}\")\n"
  }
}
