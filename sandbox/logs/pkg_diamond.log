{"tool": "write_file", "args": {"path": "setup_jobs.py", "content": "\"\"\"STEP 5: Set up QE SCF + bands + bands-post inputs for each structure.\n\nFor each structures/structure_NNN.cif, create calculations/NNN/ containing:\n  - C.upf (copied; pw.x runs inside calculations/NNN so pseudo_dir='./')\n  - pw.in       (SCF, Monkhorst-Pack 8x8x8)\n  - bands.in    (non-self-consistent bands along a seekpath-derived k-path)\n  - bands_post.in (bands.x, filband='NNN.bands.dat')\n  - band_labels.dat (high-symmetry label + index in the bands k-point list)\n\"\"\"\nimport os\nimport shutil\nimport numpy as np\nimport spglib\nimport seekpath\nfrom ase.io import read\nfrom ase.io.espresso import write_espresso_in\n\n# ---- pw.x settings decided in STEP 4 ----\n# ecut hint returned in HARTREE (41.0 Ha). QE wants RYDBERG. 1 Ha = 2 Ry.\nECUT_HA = 41.0\nECUTWFC_RY = 2.0 * ECUT_HA           # = 82.0 Ry (INVARIANT 5)\nassert ECUTWFC_RY == 82.0\nECUTRHO_RY = 4.0 * ECUTWFC_RY        # = 328.0 Ry (NC default ratio)\nassert ECUTRHO_RY == 328.0\nCONV_THR = 1.0e-8\nMP_GRID = (8, 8, 8)                  # dense MP mesh for a 2-atom insulator\nNBND = 12                            # padded generously; verified vs pw.out\nPOINTS_PER_SEG = 20                  # interpolated k-points per path segment\n\nPSEUDO = {'C': 'C.upf'}\n\n\ndef build_kpath(atoms):\n    \"\"\"Return (kpts_array (n,4), labels list of (index, label)) for this exact\n    Atoms object, per INVARIANT 3 (seekpath, symprec=0.01, 2*pi-corrected\n    reprojection onto atoms.cell.reciprocal()).\"\"\"\n    cell_tuple = (atoms.cell[:], atoms.get_scaled_positions(),\n                  atoms.get_atomic_numbers())\n    res = seekpath.get_path(cell_tuple, symprec=0.01)\n    # Self-consistency: seekpath spacegroup must match spglib at same symprec.\n    sg_spglib = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01).number\n    assert res['spacegroup_number'] == sg_spglib, \\\n        (res['spacegroup_number'], sg_spglib)\n\n    # recip_prim already includes 2*pi (seekpath convention).\n    recip_prim = np.array(res['reciprocal_primitive_lattice'])\n    # ASE's reciprocal() has NO 2*pi factor -> add it to match.\n    recip_actual = 2.0 * np.pi * np.array(atoms.cell.reciprocal()[:])\n\n    def to_actual_frac(frac_prim):\n        # Go through Cartesian: seekpath's primitive cell may differ in shape/\n        # orientation from the cell we actually wrote, so its fractional named\n        # points are only meaningful once reprojected via Cartesian.\n        cart = np.array(frac_prim) @ recip_prim\n        return cart @ np.linalg.inv(recip_actual)\n\n    pts = {lbl: to_actual_frac(c) for lbl, c in res['point_coords'].items()}\n\n    kpts = []\n    labels = []            # list of (index_in_kpts, label)\n    prev_end_label = None\n    for (a, b) in res['path']:\n        start = pts[a]\n        end = pts[b]\n        # Discontinuity: previous segment's end != this segment's start.\n        if prev_end_label is not None and prev_end_label != a:\n            # Mark the jump with both sides at the current index.\n            labels.append((len(kpts), f'{prev_end_label}|{a}'))\n        else:\n            labels.append((len(kpts), a))\n        # Each segment contributes its own start plus interior points so that\n        # every named point (even across a discontinuity) is actually sampled.\n        seg = np.linspace(start, end, POINTS_PER_SEG, endpoint=False)\n        for k in seg:\n            kpts.append(list(k) + [1.0])   # weight column unused for bands\n        prev_end_label = b\n    # Append the final endpoint of the last segment.\n    kpts.append(list(pts[prev_end_label]) + [1.0])\n    labels.append((len(kpts) - 1, prev_end_label))\n\n    return np.array(kpts), labels\n\n\nfor i in range(51):\n    nnn = f'{i:03d}'\n    atoms = read(f'structures/structure_{nnn}.cif')\n\n    # INVARIANT 1: nat/ntyp derived from the actual Atoms object.\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == 2 and ntyp == 1, (nnn, nat, ntyp)\n\n    calc_dir = f'calculations/{nnn}'\n    os.makedirs(calc_dir, exist_ok=True)\n    shutil.copy('template/C.upf', os.path.join(calc_dir, 'C.upf'))\n\n    common = {\n        'prefix': 'C',\n        'outdir': './out',\n        'pseudo_dir': './',\n        'ecutwfc': ECUTWFC_RY,\n        'ecutrho': ECUTRHO_RY,\n        'occupations': 'fixed',   # diamond is an insulator; no smearing\n    }\n\n    # ---- SCF input (flat dict; ASE routes keys to correct namelists) ----\n    scf_data = dict(common)\n    scf_data['calculation'] = 'scf'\n    scf_data['conv_thr'] = CONV_THR\n    with open(os.path.join(calc_dir, 'pw.in'), 'w') as fd:\n        write_espresso_in(fd, atoms, input_data=scf_data,\n                          pseudopotentials=PSEUDO, kpts=MP_GRID)\n\n    # ---- Bands input (non-self-consistent, explicit k-path) ----\n    kpts_arr, labels = build_kpath(atoms)\n    bands_data = dict(common)\n    bands_data['calculation'] = 'bands'\n    bands_data['nbnd'] = NBND\n    with open(os.path.join(calc_dir, 'bands.in'), 'w') as fd:\n        # np.ndarray shape (n_kpts, 4) -> raw k-points in crystal coordinates.\n        write_espresso_in(fd, atoms, input_data=bands_data,\n                          pseudopotentials=PSEUDO, kpts=kpts_arr)\n\n    # ---- bands.x post-processing input ----\n    bands_post = (\n        '&BANDS\\n'\n        \"  prefix = 'C'\\n\"\n        \"  outdir = './out'\\n\"\n        f\"  filband = '{nnn}.bands.dat'\\n\"\n        '/\\n'\n    )\n    with open(os.path.join(calc_dir, 'bands_post.in'), 'w') as fd:\n        fd.write(bands_post)\n\n    # ---- band_labels.dat : index in the k-point list + label ----\n    with open(os.path.join(calc_dir, 'band_labels.dat'), 'w') as fd:\n        for idx, lbl in labels:\n            fd.write(f'{idx} {lbl}\\n')\n\nprint('Wrote calculations/000..050 (pw.in, bands.in, bands_post.in, labels).')\n"}}
