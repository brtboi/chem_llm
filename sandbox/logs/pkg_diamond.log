 {"tool": "write_file", "args": {"path": "plot_bands.py", "content": "\"\"\"STEP 7: Plot the band structure for calculations/000.\n\nReads the bands.x .gnu output (cumulative k-path distance in col 0, energy in\ncol 1, in eV), aligns to the VBM using the occupied-band count from pw.out,\nputs high-symmetry ticks in the SAME x-units as the band data (INVARIANT 4),\nlabels a discontinuity with both sides and draws no connector across it,\nrestricts y to +/-10 eV around the VBM, saves bands_000.pdf and prints\nVBM/CBM/gap.\n\"\"\"\nimport re\nimport numpy as np\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\nCALC = 'calculations/000'\nGNU = f'{CALC}/000.bands.dat.gnu'\nLABELS = f'{CALC}/band_labels.dat'\nPWOUT = f'{CALC}/pw.out'\n\n# ---- occupied-band count from pw.out (INVARIANT 2: read from the file) ----\nwith open(PWOUT) as fh:\n    txt = fh.read()\nm = re.search(r'number of electrons\\s*=\\s*([0-9.]+)', txt)\nn_elec = float(m.group(1))\n# spin-unpolarised non-metal: occupied bands = n_electrons / 2\nn_occ = int(round(n_elec / 2))\nassert abs(n_elec / 2 - n_occ) < 1e-6, n_elec\nprint('number of electrons:', n_elec, '-> occupied bands:', n_occ)\n\n# ---- parse the .gnu file: blocks separated by blank lines, one per band ----\nblocks = []\ncur = []\nwith open(GNU) as fh:\n    for line in fh:\n        if line.strip() == '':\n            if cur:\n                blocks.append(cur)\n                cur = []\n        else:\n            xk, en = line.split()\n            cur.append((float(xk), float(en)))\n    if cur:\n        blocks.append(cur)\n\nnbands = len(blocks)\nnkpts = len(blocks[0])\nfor b in blocks:\n    assert len(b) == nkpts, (len(b), nkpts)\nprint('nbands:', nbands, 'nkpts:', nkpts)\n\n# k-distance column (same for every band); energies shaped (nkpts, nbands)\nkdist = np.array([p[0] for p in blocks[0]])\nener = np.array([[blk[i][1] for blk in blocks] for i in range(nkpts)])\n\n# ---- VBM / CBM / gap from occupied vs unoccupied bands ----\nvbm = ener[:, :n_occ].max()\ncbm = ener[:, n_occ:].min()\ngap = cbm - vbm\nprint(f'VBM = {vbm:.4f} eV')\nprint(f'CBM = {cbm:.4f} eV')\nprint(f'band gap = {gap:.4f} eV')\n\n# align energies to VBM\nener_shift = ener - vbm\n\n# ---- read band_labels.dat: INDEX into the k-point list + label ----\nlabel_idx = []\nlabel_txt = []\nwith open(LABELS) as fh:\n    for line in fh:\n        idx, lbl = line.split()\n        label_idx.append(int(idx))\n        label_txt.append(lbl)\n\n# INVARIANT 4: convert each label's k-point-list INDEX to the cumulative\n# distance x-value used by the band data (row order matches kpts order).\ntick_pos = [kdist[i] for i in label_idx]\n\n# assert ticks span same numeric range as the band data's own k column\nassert abs(max(tick_pos) - kdist.max()) < 0.05 * kdist.max(), \\\n    (max(tick_pos), kdist.max())\n\n# ---- identify discontinuities: bands.x marks a jump by REPEATING the x value\n# (zero distance increment between consecutive rows).\njump_rows = [i for i in range(1, nkpts) if kdist[i] == kdist[i - 1]]\n\n# ---- plot: split each band line at jump rows so no connector is drawn ----\nfig, ax = plt.subplots(figsize=(7, 5))\nsegment_bounds = [0] + jump_rows + [nkpts]\nfor j in range(nbands):\n    for s in range(len(segment_bounds) - 1):\n        lo, hi = segment_bounds[s], segment_bounds[s + 1]\n        ax.plot(kdist[lo:hi], ener_shift[lo:hi, j], color='C0', lw=0.8)\n\nax.set_xticks(tick_pos)\n# pretty labels: GAMMA -> Gamma symbol\nnice = [t.replace('GAMMA', '$\\\\Gamma$') for t in label_txt]\nax.set_xticklabels(nice)\nfor xp in tick_pos:\n    ax.axvline(xp, color='0.7', lw=0.5)\nax.axhline(0.0, color='k', lw=0.5, ls='--')  # VBM reference\n\nax.set_ylim(-10, 10)          # +/-10 eV around VBM (INVARIANT 4)\nax.set_xlim(kdist.min(), kdist.max())\nax.set_ylabel('Energy - VBM (eV)')\nax.set_title(f'Diamond C band structure (gap = {gap:.2f} eV)')\n\nfig.tight_layout()\nfig.savefig(f'{CALC}/bands_000.pdf')\nprint('Saved', f'{CALC}/bands_000.pdf')\n"}}
