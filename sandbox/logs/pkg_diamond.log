 {'tool': 'write_file', 'args': {'path': 'generate_structures.py', 'content': '"""STEP 2: Generate 51 diamond-C structures.\n\nstructure_000.cif = unperturbed primitive cell.\nstructure_001..050.cif = perturbed copies (random atomic displacements +\nsmall random lattice strain).\n"""\nimport numpy as np\nimport spglib\nfrom ase.io import read, write\n\n# ---- Read base structure (from Materials Project, mp-66, Fd-3m #227) ----\nbase = read(\'structures/C_base.cif\')\nn_before = len(base)\n\n# ---- Reduce to primitive cell (unit-cell-choice DECISION RULE) ----\n# Build spglib cell tuple from the exact ASE Atoms object.\ncell_tuple = (base.cell[:], base.get_scaled_positions(), base.get_atomic_numbers())\nsg_before = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01).number\n\n# standardize_cell to the primitive cell; no_idealize=False lets spglib clean\n# up numerical noise from the CIF round-trip.\nprim_cell, prim_pos, prim_num = spglib.standardize_cell(\n    cell_tuple, to_primitive=True, no_idealize=False, symprec=0.01)\n\nfrom ase import Atoms\nprimitive = Atoms(numbers=prim_num, scaled_positions=prim_pos, cell=prim_cell, pbc=True)\nn_after = len(primitive)\n\n# Space group must be unchanged, and reduced count must divide original evenly.\nsg_after = spglib.get_symmetry_dataset(\n    (primitive.cell[:], primitive.get_scaled_positions(),\n     primitive.get_atomic_numbers()), symprec=0.01).number\nassert sg_after == sg_before == 227, (sg_before, sg_after)\nassert n_before % n_after == 0, (n_before, n_after)\nprint(\'atoms before reduction:\', n_before, \'after:\', n_after,\n      \'space group:\', sg_before)\n\n# ---- Write 51 structures ----\n# Displacement magnitude: diamond has a very high Debye temperature (~2200 K),\n# so the thermal RMS atomic displacement at 300 K is small, ~0.03-0.05 Angstrom.\n# We use 0.05 A as a chemically reasonable room-temperature displacement stdev.\nDISP_STDEV = 0.05  # Angstrom\n# Lattice strain: small random symmetric strain, components ~ N(0, 0.01) => ~1%.\nSTRAIN_STDEV = 0.01\n\nrng = np.random.default_rng(12345)\n\nfor i in range(51):\n    atoms = primitive.copy()\n    if i > 0:\n        # Random atomic displacements (thermal).\n        atoms.rattle(stdev=DISP_STDEV, rng=rng)\n        # Random symmetric strain tensor applied to the cell vectors:\n        # new_cell = old_cell @ (I + eps), eps symmetric ~ N(0, STRAIN_STDEV).\n        eps = rng.normal(0.0, STRAIN_STDEV, size=(3, 3))\n        eps = 0.5 * (eps + eps.T)  # symmetric strain\n        deform = np.eye(3) + eps\n        new_cell = atoms.cell[:] @ deform\n        # scale_atoms=True keeps fractional coords fixed under the strain.\n        atoms.set_cell(new_cell, scale_atoms=True)\n\n    # INVARIANT 1: nat/ntyp computed from the actual Atoms object.\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == n_after, (i, nat, n_after)\n    assert ntyp == 1, (i, ntyp)\n\n    write(f\'structures/structure_{i:03d}.cif\', atoms)\n\nprint(\'Wrote 51 structures (structure_000..050).\')\n'}}
