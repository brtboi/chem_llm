    cell=structure.cell[:],\n    kpts=band_kpts[:, :3],\n    special_points=special_points,\n    path=path_str,\n)\nprint(f"BandPath: {bandpath}")\n\n# Create a test directory\ntest_dir = "test_espresso"\nos.makedirs(test_dir, exist_ok=True)\n\n# Write a minimal wrapper script\nwith open(os.path.join(test_dir, "pw_wrapper.sh"), "w") as f:\n    f.write(\'#!/bin/bash\\nmodule load espresso/7.5-libxc-7.0.0-cpu\\nexport OMP_NUM_THREADS=1\\nexec pw.x "$@"\\n\')\nos.chmod(os.path.join(test_dir, "pw_wrapper.sh"), 0o755)\n\n# Copy pseudopotentials\nimport shutil\nshutil.copy("template/Ti.pbesol-srn-rrkjus_psl.1.0.0.UPF", test_dir)\nshutil.copy("template/O.pbesol-srn-rrkjus_psl.1.0.0.UPF", test_dir)\n\n# Create the Espresso calculator for SCF\ncalc_scf = Espresso(\n    command=os.path.join(test_dir, "pw_wrapper.sh"),\n    directory=test_dir,\n    label="test_scf",\n    prefix="test_scf",\n    calculation="scf",\n    restart_mode="from_scratch",\n    outdir="./",\n    wfcdir="./",\n    pseudo_dir="./",\n    verbosity="high",\n    ibrav=0,\n    nat=len(structure),\n    ntyp=len(set(structure.get_chemical_symbols())),\n    ecutwfc=572.0,\n    ecutrho=2288.0,\n    tot_charge=0.0,\n    nosym=True,\n    noinv=True,\n    occupations="fixed",\n    electron_maxstep=100,\n    conv_thr=1.0e-8,\n    mixing_mode="plain",\n    mixing_beta=0.3,\n    mixing_ndim=8,\n    diagonalization="david",\n    diago_david_ndim=4,\n    diago_full_acc=False,\n    pseudopotentials={"Ti": "Ti.pbesol-srn-rrkjus_psl.1.0.0.UPF", "O": "O.pbesol-srn-rrkjus_psl.1.0.0.UPF"},\n    kpts=(8, 8, 8),\n)\n\n# Write the input file without running\ncalc_scf.write_input(os.path.join(test_dir, "test_scf.in"))\nprint("\\nSCF input file written to test_espresso/test_scf.in")\n\n# Read and print the input file\nwith open(os.path.join(test_dir, "test_scf.in")) as f:\n    print(f.read())\n\n# Now create the bands calculator\ncalc_bands = Espresso(\n    command=os.path.join(test_dir, "pw_wrapper.sh"),\n    directory=test_dir,\n    label="test_bands",\n    prefix="test_bands",\n    calculation="bands",\n    restart_mode="from_scratch",\n    outdir="./",\n    wfcdir="./",\n    pseudo_dir="./",\n    verbosity="high",\n    ibrav=0,\n    nat=len(structure),\n    ntyp=len(set(structure.get_chemical_symbols())),\n    ecutwfc=572.0,\n    ecutrho=2288.0,\n    tot_charge=0.0,\n    nosym=True,\n    noinv=True,\n    occupations="fixed",\n    electron_maxstep=100,\n    conv_thr=1.0e-8,\n    mixing_mode="plain",\n    mixing_beta=0.3,\n    mixing_ndim=8,\n    diagonalization="david",\n    diago_david_ndim=4,\n    diago_full_acc=False,\n    pseudopotentials={"Ti": "Ti.pbesol-srn-rrkjus_psl.1.0.0.UPF", "O": "O.pbesol-srn-rrkjus_psl.1.0.0.UPF"},\n    kpts={"path": bandpath},\n)\n\ncalc_bands.write_input(os.path.join(test_dir, "test_bands.in"))\nprint("\\nBands input file written to test_espresso/test_bands.in")\n\nwith open(os.path.join(test_dir, "test_bands.in")) as f:\n    print(f.read())\n\nprint("\\nDone. Check the input files to see how ASE writes the K_POINTS card for a BandPath.")\n'}}
