 {
  "tool": "write_file",
  "args": {
    "path": "generate_structures.py",
    "content": "import numpy as np\nfrom ase.io import read, write\nfrom ase import Atoms\n\n# Read the primitive base structure (2-atom fcc diamond, Fd-3m #227)\nbase = read('structures/c_primitive.cif')\nn_base = len(base)\nntyp_base = len(set(base.get_chemical_symbols()))\nprint(f\"Base structure: {n_base} atoms, {ntyp_base} element types\")\n\n# Displacement magnitude justification:\n# At room temperature (300 K), the mean-square displacement of a C atom in diamond\n# is on the order of (k_B*T / k_spring)^(1/2). The C-C bond spring constant is ~15-20 N/m,\n# giving a thermal displacement amplitude of ~0.05-0.1 Angstrom. We use 0.05 Angstrom\n# as a conservative, chemically reasonable perturbation that breaks symmetry without\n# causing unphysical bond stretching.\nDISPLACEMENT_SIGMA = 0.05  # Angstrom, Gaussian std dev for random atomic displacements\n\n# Small random lattice strain: ~0.1% (1e-3) is well within the elastic regime for diamond\n# (bulk modulus ~440 GPa) and breaks inversion symmetry slightly.\nSTRAIN_MAGNITUDE = 1e-3  # dimensionless, max strain component\n\nrng = np.random.default_rng(seed=42)\n\nfor i in range(51):\n    if i == 0:\n        # Unperturbed base structure\n        atoms = base.copy()\n    else:\n        atoms = base.copy()\n        # Random atomic displacements in Cartesian coordinates\n        displacements = rng.normal(0.0, DISPLACEMENT_SIGMA, size=(len(atoms), 3))\n        atoms.positions += displacements\n        # Small random lattice strain: apply a symmetric strain tensor\n        strain = rng.uniform(-STRAIN_MAGNITUDE, STRAIN_MAGNITUDE, size=(3, 3))\n        # Make strain symmetric (physical strain tensor is symmetric)\n        strain = 0.5 * (strain + strain.T)\n        # Apply strain to the cell: new_cell = (I + strain) @ old_cell\n        new_cell = (np.eye(3) + strain) @ atoms.cell.array\n        atoms.cell = new_cell\n        # Keep positions in the new cell (wrap to [0,1) fractional coordinates)\n        atoms.wrap()\n\n    # INVARIANT 1: assert nat/ntyp from the actual Atoms object\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == n_base, f\"Structure {i:03d}: nat {nat} != base {n_base}\"\n    assert ntyp == ntyp_base, f\"Structure {i:03d}: ntyp {ntyp} != base {ntyp_base}\"\n\n    out_path = f'structures/structure_{i:03d}.cif'\n    write(out_path, atoms)\n    print(f\"Wrote {out_path}: nat={nat}, ntyp={ntyp}\")\n\nprint(f\"\\nDone: wrote 51 structures (structure_000.cif through structure_050.cif)\")\n"
}

