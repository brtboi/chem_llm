    "path": "plot_bands.py",
    "content": "import numpy as np\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport re\n\n# =============================================================================\n# plot_bands.py\n# Reads the bands.x output (000.bands.dat) and band_labels.dat for calculations/000,\n# aligns energies to the VBM, and plots the band structure with high-symmetry ticks.\n# =============================================================================\n\nCALC_DIR = 'calculations/000'\nBANDS_FILE = f'{CALC_DIR}/000.bands.dat'\nLABELS_FILE = f'{CALC_DIR}/band_labels.dat'\nPW_OUT = f'{CALC_DIR}/pw.out'\nOUTPUT_PDF = f'{CALC_DIR}/bands_000.pdf'\n\n# --- Read the number of electrons from pw.out (INVARIANT 2) ---\nwith open(PW_OUT, 'r') as f:\n    pw_content = f.read()\n\n# Find 'number of electrons' line\nmatch = re.search(r'number of electrons\\s*=\\s*([\\d.]+)', pw_content)\nassert match, f\"Could not find 'number of electrons' in {PW_OUT}\"\nn_electrons = float(match.group(1))\nprint(f\"Number of electrons from pw.out: {n_electrons}\")\n\n# For spin-unpolarized non-metallic run: occupied bands = n_electrons / 2\nn_occupied = int(n_electrons / 2)\nprint(f\"Number of occupied bands: {n_occupied}\")\n\n# --- Parse the bands.dat file ---\n# Format: line 1 is &plot nbnd=NN, nks=NN /\n# Then for each k-point: a line with 3 k-coordinates (in 2*pi/alat units),\n# followed by lines with nbnd energies in eV (may span multiple lines)\n\nwith open(BANDS_FILE, 'r') as f:\n    lines = f.readlines()\n\n# Parse header\nheader = lines[0].strip()\nmatch = re.search(r'nbnd=\\s*(\\d+),\\s*nks=\\s*(\\d+)', header)\nassert match, f\"Could not parse header: {header}\"\nnbnd = int(match.group(1))\nnks = int(match.group(2))\nprint(f\"Header: nbnd={nbnd}, nks={nks}\")\n\n# Parse k-points and energies\nk_coords = []  # (nks, 3) array of k-coordinates in 2*pi/alat units\nenergies = []  # (nks, nbnd) array of energies in eV\n\nline_idx = 1\nfor i in range(nks):\n    # Read k-coordinate line\n    k_line = lines[line_idx].strip()\n    line_idx += 1\n    k_vals = [float(x) for x in k_line.split()]\n    assert len(k_vals) == 3, f\"Expected 3 k-coordinates, got {len(k_vals)}: {k_line}\"\n    k_coords.append(k_vals)\n    \n    # Read energy lines (nbnd values, may span multiple lines)\n    e_vals = []\n    while len(e_vals) < nbnd:\n        e_line = lines[line_idx].strip()\n        line_idx += 1\n        e_vals.extend([float(x) for x in e_line.split()])\n    \n    assert len(e_vals) == nbnd, f\"Expected {nbnd} energies, got {len(e_vals)}\"\n    energies.append(e_vals)\n\nk_coords = np.array(k_coords)  # (nks, 3)\nenergies = np.array(energies)  # (nks, nbnd)\n\nprint(f\"Parsed {nks} k-points, {nbnd} bands each\")\nassert k_coords.shape == (nks, 3)\nassert energies.shape == (nks, nbnd)\n\n# --- Compute cumulative path distance for the x-axis ---\n# The k-coordinates are in 2*pi/alat units (Cartesian reciprocal space).\n# We compute the cumulative distance along the path for the x-axis.\n# This is the same unit system that bands.x uses internally.\n\n# Compute distances between consecutive k-points\ndiffs = np.diff(k_coords, axis=0)  # (nks-1, 3)\ndistances = np.sqrt(np.sum(diffs**2, axis=1))  # (nks-1,)\n\n# Cumulative distance: x[0] = 0, x[i] = sum of distances up to i\ncum_dist = np.zeros(nks)\nfor i in range(1, nks):\n    cum_dist[i] = cum_dist[i-1] + distances[i-1]\n\nprint(f\"Cumulative distance range: {cum_dist[0]:.4f} to {cum_dist[-1]:.4f}\")\n\n# --- Read band labels ---\nlabels = []  # list of (label, index)\nwith open(LABELS_FILE, 'r') as f:\n    for line in f:\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.split('\\t')\n        assert len(parts) == 2, f\"Expected 2 tab-separated fields, got {len(parts)}: {line}\"\n        label = parts[0]\n        idx = int(parts[1])\n        labels.append((label, idx))\n\nprint(f\"Band labels: {labels}\")\n\n# --- Align energies to VBM ---\n# VBM = highest occupied band energy = max of band (n_occupied-1) across all k-points\n# (0-indexed: band index n_occupied-1 is the highest occupied band)\nvbm_band_idx = n_occupied - 1\nvbm = np.max(energies[:, vbm_band_idx])\nprint(f\"VBM (highest occupied band max): {vbm:.4f} eV\")\n\n# Shift all energies so VBM = 0\nenergies_shifted = energies - vbm\n\n# --- Find CBM (lowest conduction band minimum) ---\n# Conduction bands start at index n_occupied (0-indexed)\ncbm = np.min(energies_shifted[:, n_occupied:])\ncbm_k_idx = np.argmin(energies_shifted[:, n_occupied:])\nprint(f\"CBM (lowest conduction band min): {cbm:.4f} eV (at k-point index {cbm_k_idx})\")\n\n# Band gap\ngap = cbm - 0.0  # VBM is at 0 after shifting\nprint(f\"Band gap: {gap:.4f} eV\")\n\n# --- Build tick positions and labels ---\n# Tick positions are the cumulative distances at the labeled k-point indices\ntick_positions = []\ntick_labels = []\nfor label, idx in labels:\n    tick_positions.append(cum_dist[idx])\n    tick_labels.append(label)\n\ntick_positions = np.array(tick_positions)\ntick_labels = np.array(tick_labels)\n\n# INVARIANT 4 CHECK: tick positions must span approximately the same range as the band data's k column\n# The band data's x-axis is cum_dist, which spans [0, cum_dist[-1]]\n# The tick positions should span approximately the same range\nassert abs(tick_positions.max() - cum_dist.max()) < 0.05 * cum_dist.max(), \\\n    f\"Tick positions max ({tick_positions.max()}) does not match cum_dist max ({cum_dist.max()})\"\nassert abs(tick_positions.min() - cum_dist.min()) < 0.05 * cum_dist.max(), \\\n    f\"Tick positions min ({tick_positions.min()}) does not match cum_dist min ({cum_dist.min()})\"\nprint(f\"INVARIANT 4 check passed: tick positions span [{tick_positions.min():.4f}, {tick_positions.max():.4f}], \"\n      f\"band data spans [{cum_dist.min():.4f}, {cum_dist.max():.4f}]\")\n\n# --- Identify discontinuities (jumps in the path) ---\n# A discontinuity occurs when the previous segment's end differs from the next segment's start.\n# In the k_coords array, this shows up as a large jump in distance between consecutive points.\n# We can detect this by looking at the distances array: if a distance is much larger than\n# the typical inter-point spacing, it's likely a jump.\n\n# Typical spacing: median of the distances\ntypical_spacing = np.median(distances)\nprint(f\"Typical inter-point spacing: {typical_spacing:.6f}\")\n\n# A jump is where the distance is significantly larger than typical\n# Use a threshold of 3x the typical spacing\njump_threshold = 3.0 * typical_spacing\njump_indices = np.where(distances > jump_threshold)[0]  # indices in distances array\n# These are the indices i where distance from point i to point i+1 is a jump\n# So the jump is between k-point i and k-point i+1\nprint(f\"Jump indices (between k-point i and i+1): {jump_indices}\")\n\n# For plotting, we need to split the line at each jump.\n# We'll create segments: each segment is a contiguous range of k-point indices\n# where no jump occurs within the segment.\n\nsegments = []\nstart = 0\nfor j in jump_indices:\n    # Jump between point j and point j+1\n    # Segment from start to j (inclusive)\n    segments.append((start, j))\n    start = j + 1\n# Final segment\nsegments.append((start, nks - 1))\n\nprint(f\"Plot segments: {segments}\")\n\n# --- Plot ---\nfig, ax = plt.subplots(figsize=(10, 6))\n\n# Plot each band for each segment\nfor band_idx in range(nbnd):\n    for seg_start, seg_end in segments:\n        x_seg = cum_dist[seg_start:seg_end+1]\n        y_seg = energies_shifted[seg_start:seg_end+1, band_idx]\n        ax.plot(x_seg, y_seg, 'b-', linewidth=0.8)\n\n# Set x-axis ticks at high-symmetry points\nax.set_xticks(tick_positions)\nax.set_xticklabels(tick_labels, rotation=0, ha='center')\n\n# Set y-axis limits: +/-10 eV around VBM (which is at 0)\nax.set_ylim(-10, 10)\n\n# Labels and title\nax.set_xlabel('k-path (2$\\pi$/a units)')\nax.set_ylabel('Energy (eV) relative to VBM')\nax.set_title('Diamond C band structure (PBEsol, SCF)')\nax.axhline(y=0, color='k', linestyle='--', linewidth=0.5, alpha=0.5)\n\nplt.tight_layout()\nplt.savefig(OUTPUT_PDF, dpi=150, bbox_inches='tight')\nprint(f\"\\nSaved plot to {OUTPUT_PDF}\")\n\n# --- Print summary ---\nprint(f\"\\n=== Summary ===\")\nprint(f\"VBM: {vbm:.4f} eV (raw), 0.0000 eV (shifted)\")\nprint(f\"CBM: {cbm + vbm:.4f} eV (raw), {cbm:.4f} eV (shifted)\")\nprint(f\"Band gap: {gap:.4f} eV\")\nprint(f\"Number of occupied bands: {n_occupied}\")\nprint(f\"Number of electrons: {n_electrons}\")\n"
  }
}
