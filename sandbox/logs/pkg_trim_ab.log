    "content": "import numpy as np\nimport seekpath\nimport spglib\nfrom ase.io import read, write\n\n# Read the base CIF (conventional fcc cell from Materials Project)\nbase = read('structures/c_base.cif')\nn_base = len(base)\nprint(f\"Base cell: {n_base} atoms, cell =\\n{base.cell.array}\")\n\n# Build the cell tuple for seekpath (lattice + basis aware)\ncell_tuple = (base.cell[:], base.get_scaled_positions(), base.get_atomic_numbers())\n\n# Full symmetry analysis at symprec=0.01 (matches pymatgen default; spglib's 1e-5 default\n# can under-detect symmetry on CIF-round-tripped coordinates)\ndataset = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01)\nsg_number = dataset.number\nprint(f\"Space group number (spglib, symprec=0.01): {sg_number}\")\nassert sg_number == 227, f\"Expected Fd-3m (#227), got {sg_number}\"\n\n# seekpath: get the primitive cell AND the k-path in one call\nres = seekpath.get_path(cell_tuple, symprec=0.01)\nassert res['spacegroup_number'] == sg_number, \\\n    f\"seekpath sg {res['spacegroup_number']} != spglib sg {sg_number}\"\n\nprim_cell = res['primitive_lattice']\nprim_pos = res['primitive_positions']\nprim_types = res['primitive_types']\nn_prim = len(prim_types)\nprint(f\"Primitive cell: {n_prim} atoms\")\nprint(f\"Primitive lattice =\\n{prim_cell}\")\nprint(f\"Path: {res['path']}\")\nprint(f\"Point coords: {res['point_coords']}\")\n\n# DECISION RULE check: reduced atom count divides the original evenly\nassert n_base % n_prim == 0, f\"{n_base} not divisible by {n_prim}\"\n\n# Build the primitive Atoms object -- this is the cell we write into CELL_PARAMETERS\nfrom ase import Atoms\nprim = Atoms(cell=prim_cell, scaled_positions=prim_pos, numbers=prim_types, pbc=True)\n\n# Verify the primitive cell has the same space group (reduction must not change it)\nprim_tuple = (prim.cell[:], prim.get_scaled_positions(), prim.get_atomic_numbers())\nprim_dataset = spglib.get_symmetry_dataset(prim_tuple, symprec=0.01)\nprint(f\"Primitive cell space group: {prim_dataset.number}\")\nassert prim_dataset.number == 227, f\"Primitive cell sg {prim_dataset.number} != 227\"\n\n# Save the primitive cell as the base structure for downstream use\nwrite('structures/c_primitive.cif', prim)\nprint(f\"\\nSaved primitive cell to structures/c_primitive.cif\")\nprint(f\"Atom count: {n_base} (conventional) -> {n_prim} (primitive)\")\nprint(f\"nat = {n_prim}, ntyp = {len(set(prim.get_chemical_symbols()))}\")\n"
