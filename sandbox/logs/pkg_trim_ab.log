n CELL_PARAMETERS\n        kpts_array: (n_kpts, 4) ndarray in crystal coordinates for K_POINTS card\n        labels: list of (label, index) for band_labels.dat\n        path: list of (label_from, label_to) segments\n    """\n    cell_tuple = (atoms.cell[:], atoms.get_scaled_positions(), atoms.get_atomic_numbers())\n    \n    # seekpath with symprec=0.01 (matches pymatgen default; spglib default 1e-5 is too tight)\n    res = seekpath.get_path(cell_tuple, symprec=0.01)\n    \n    # Cross-check with spglib directly\n    dataset = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01)\n    assert res[\'spacegroup_number\'] == dataset.number, \\\n        f"Space group mismatch: seekpath={res[\'spacegroup_number\']}, spglib={dataset.number}"\n    \n    # Build the primitive cell from seekpath\'s own output\n    prim = Atoms(\n        cell=res[\'primitive_lattice\'],\n        scaled_positions=res[\'primitive_positions\'],\n        numbers=res[\'primitive_types\'],\n        pbc=True\n    )\n    \n    # Build the k-point list from seekpath\'s path and point_coords\n    # INVARIANT 3: every segment must contribute its own start point\n    path = res[\'path\']\n    point_coords = res[\'point_coords\']\n    \n    kpts_list = []\n    labels = []  # (label, index) pairs\n    \n    for i_seg, (label_from, label_to) in enumerate(path):\n        start_coord = np.array(point_coords[label_from])\n        end_coord = np.array(point_coords[label_to])\n        \n        # Add the start point of this segment\n        if i_seg == 0:\n            kpts_list.append(start_coord)\n            labels.append((label_from, len(kpts_list) - 1))\n        else:\n            # Check if this is a discontinuous jump (previous segment\'s end != this segment\'s start)\n            prev_end = np.array(point_coords[path[i_seg - 1][1]])\n            if not np.allclose(prev_end, start_coord, atol=1e-10):\n                # Discontinuous jump: add the start point with a combined label\n                kpts_list.append(start_coord)\n                labels.append((f"{path[i_seg-1][1]}|{label_from}", len(kpts_list) - 1))\n            else:\n                # Continuous: the start point is already the previous segment\'s end\n                # (already added as the last point of the previous segment)\n                pass\n        \n        # Add interior points (excluding the start, including the end)\n        for i in range(1, NPTS_PER_SEGMENT + 1):\n            t = i / NPTS_PER_SEGMENT\n            kpt = start_coord + t * (end_coord - start_coord)\n            kpts_list.append(kpt)\n        \n        # Add the end label (only for the last point of this segment)\n        labels.append((label_to, len(kpts_list) - 1))\n    \n    # Convert to (n_kpts, 4) array with weight column = 1.0\n    kpts_array = np.zeros((len(kpts_list), 4))\n    for i, kpt in enumerate(kpts_list):\n        kpts_array[i, :3] = kpt\n        kpts_array[i, 3] = 1.0  # weight (unused for non-self-consistent bands run)\n    \n    return prim, kpts_array, labels, path\n\n\ndef setup_structure(nnn):\n    """Set up calculations/NNN/ for structure NNN."""\n    calc_dir = f\'calculations/{nnn}\'\n    os.makedirs(calc_dir, exist_ok=True)\n    \n    # Copy pseudopotential into the calculation directory\n    shutil.copy(PP_SOURCE, os.path.join(calc_dir, PP_FILE))\n    \n    # Read the structure\n    atoms = read(f\'structures/structure_{nnn}.cif\')\n    \n    # INVARIANT 1: nat and ntyp computed from the actual Atoms object\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    \n    # Derive the k-path from this exact structure\n    prim, kpts_array, labels, path = get_kpath(atoms)\n    \n    # INVARIANT 1: nat and ntyp must be computed from the prim object (the one written into CELL_PARAMETERS)\n    nat_prim = len(prim)\n    ntyp_prim = len(set(prim.get_chemical_symbols()))\n    \n    # Write pw.in (SCF)\n    scf_input_data = {\n        \'control\': {\n            \'calculation\': \'scf\',\n            \'prefix\': \'diamond\',\n            \'outdir\': \'./tmp\',\n            \'pseudo_dir\': \'./\',\n        },\n        \'system\': {\n            \'ecutwfc\': ECUTWFC_RY,\n            \'ecutrho\': ECUTRHO_RY,\n            \'occupations\': \'fixed\',\n            \'nat\': nat_prim,\n            \'ntyp\': ntyp_prim,\n        },\n        \'electrons\': {\n            \'conv_thr\': 1.0e-8,\n        },\n    }\n    \n    write_espresso_in(\n        os.path.join(calc_dir, \'pw.in\'),\n        prim,\n        input_data=scf_input_data,\n        pseudopotentials={\'C\': PP_FILE},\n        kpts=SCF_KPTS,\n    )\n    \n    # Write bands.in (non-self-consistent bands)\n    bands_input_data = {\n        \'control\': {\n            \'calculation\': \'bands\',\n            \'prefix\': \'diamond\',\n            \'outdir\': \'./tmp\',\n            \'pseudo_dir\': \'./\',\n        },\n        \'system\': {\n            \'ecutwfc\': ECUTWFC_RY,\n            \'ecutrho\': ECUTRHO_RY,\n            \'nbnd\': NBND,\n            \'nat\': nat_prim,\n            \'ntyp\': ntyp_prim,\n        },\n    }\n    \n    write_espresso_in(\n        os.path.join(calc_dir, \'bands.in\'),\n        prim,\n        input_data=bands_input_data,\n        pseudopotentials={\'C\': PP_FILE},\n        kpts=kpts_array,  # (n_kpts, 4) ndarray in crystal coordinates\n    )\n    \n    # Write bands_post.in (bands.x input)\n    bands_post_input_data = {\n        \'BANDS\': {\n            \'prefix\': \'diamond\',\n            \'outdir\': \'./tmp\',\n            \'filband\': f\'{nnn}.bands.dat\',\n        }\n    }\n    write_fortran_namelist(\n        os.path.join(calc_dir, \'bands_post.in\'),\n        input_data=bands_post_input_data,\n        binary=\'bands\',\n    )\n    \n    # Write band_labels.dat\n    with open(os.path.join(calc_dir, \'band_labels.dat\'), \'w\') as f:\n        for label, idx in labels:\n            f.write(f"{label}\\t{idx}\\n")\n    \n    print(f"Setup complete for {calc_dir}: nat={nat_prim}, ntyp={ntyp_prim}, "\n          f"n_kpts={len(kpts_array)}, path={path}")\n\n\nif __name__ == \'__main__\':\n    for i in range(51):\n        nnn = f"{i:03d}"\n        setup_structure(nnn)\n    \n    print("\\nAll 51 calculation directories set up.")\n    print("Next: validate calculations/000/pw.in and calculations/000/bands.in")\n'}}
