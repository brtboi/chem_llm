    "content": "import numpy as np\nfrom ase.io import read, write\nfrom ase import Atoms\n\n# Read the primitive base structure (already reduced in STEP 1)\nbase = read('structures/base_C_primitive.cif')\nprint(f\"Base structure: {len(base)} atoms, elements: {base.get_chemical_symbols()}\")\n\n# Displacement magnitude justification:\n# At room temperature (300 K), the mean-square displacement of a carbon atom in diamond\n# is on the order of (k_B*T / k_spring)^(1/2). The C-C bond spring constant is ~15-20 N/m,\n# giving a typical thermal displacement of ~0.05-0.1 Angstrom. We use 0.05 Angstrom as\n# a conservative, chemically reasonable perturbation that mimics room-temperature\n# thermal vibrations without breaking bonds or causing unphysical overlaps.\nDISPLACEMENT_MAGNITUDE = 0.05  # Angstrom\n\n# Small random lattice strain: ~0.5% is reasonable for thermal expansion effects\n# (diamond's thermal expansion coefficient is ~1.8e-6 /K, so 300 K gives ~0.05%,\n# but we use 0.5% to ensure a non-trivial perturbation for testing purposes)\nSTRAIN_MAGNITUDE = 0.005  # 0.5%\n\nnp.random.seed(42)  # Reproducibility\n\nfor i in range(51):\n    if i == 0:\n        # Unperturbed base structure\n        atoms = base.copy()\n    else:\n        atoms = base.copy()\n        \n        # Random atomic displacements (Gaussian, zero mean, sigma = DISPLACEMENT_MAGNITUDE)\n        displacements = np.random.normal(0, DISPLACEMENT_MAGNITUDE, size=(len(atoms), 3))\n        atoms.positions += displacements\n        \n        # Small random lattice strain: apply a random symmetric strain tensor\n        # with magnitude ~STRAIN_MAGNITUDE\n        strain = np.random.normal(0, STRAIN_MAGNITUDE, size=(3, 3))\n        strain = (strain + strain.T) / 2  # Make symmetric\n        new_cell = (np.eye(3) + strain) @ atoms.cell.array\n        atoms.cell = new_cell\n        \n        # Wrap positions back into the cell (fractional coordinates in [0, 1))\n        atoms.wrap()\n    \n    # INVARIANT 1: nat and ntyp must be computed from the actual Atoms object\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == 2, f\"Structure {i:03d}: expected nat=2, got {nat}\"\n    assert ntyp == 1, f\"Structure {i:03d}: expected ntyp=1, got {ntyp}\"\n    \n    out_path = f'structures/structure_{i:03d}.cif'\n    write(out_path, atoms)\n    print(f\"Wrote {out_path}: nat={nat}, ntyp={ntyp}\")\n\nprint(\"\\nDone: 51 structures written (000 = unperturbed, 001-050 = perturbed)\")\n"
  }
}
