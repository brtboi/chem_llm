nks-1), ticks at label indices\n# This avoids INVARIANT 4\'s unit-mixing problem: both band data and ticks\n# use the same index-based scale.\n# -----------------------------------------------------------------------------\nx = np.arange(nks)\n\nfig, ax = plt.subplots(figsize=(10, 6))\n\n# Plot each band, splitting at discontinuous jumps (no line across the jump)\njump_indices = [idx for idx, label in labels if \'|\' in label]\nprint(f"Jump indices (discontinuous): {jump_indices}")\n\n# Build segments: split the k-point list at each jump index\n# A jump at index j means the segment before j ends at j-1, and the next\n# segment starts at j (the jump point itself is the start of the new segment).\n# Looking at the labels: U|K at index 41 means index 41 is the K point\n# (start of the K->GAMMA segment). The U point is at index 40 (end of X->U segment).\n# So the jump is between index 40 and 41. We should not draw a line from 40 to 41.\n# The L->W transition is continuous (both are on the same path segment).\n\n# Build the list of segments as (start_idx, end_idx) inclusive\nsegments = []\nprev_end = 0\nfor jidx in jump_indices:\n    segments.append((prev_end, jidx - 1))\n    prev_end = jidx\nsegments.append((prev_end, nks - 1))\nprint(f"Segments: {segments}")\n\nfor b in range(nbnd):\n    for (s, e) in segments:\n        ax.plot(x[s:e+1], energies_shifted[s:e+1, b], \'b-\', linewidth=0.8)\n\n# Set x-ticks at label positions\ntick_positions = [idx for idx, label in labels]\ntick_labels = [label for idx, label in labels]\nax.set_xticks(tick_positions)\nax.set_xticklabels(tick_labels, fontsize=10)\n\n# INVARIANT 4 CHECK: tick positions must span the same range as the band data x-axis\nassert abs(max(tick_positions) - x.max()) < 0.05 * x.max(), \\\n    f"Tick positions max {max(tick_positions)} != band data x max {x.max()}"\n\n# Draw vertical lines at high-symmetry points\nfor idx, label in labels:\n    ax.axvline(x=idx, color=\'gray\', linestyle=\'--\', linewidth=0.5, alpha=0.5)\n\n# For discontinuous jumps, draw a thicker line to indicate the break\nfor jidx in jump_indices:\n    ax.axvline(x=jidx, color=\'red\', linestyle=\'-\', linewidth=1.5, alpha=0.7)\n\nax.set_xlabel(\'k-point index\', fontsize=12)\nax.set_ylabel(\'Energy (eV) relative to VBM\', fontsize=12)\nax.set_title(\'Diamond C - Band Structure (PBEsol, 82 Ry)\', fontsize=14)\nax.set_ylim(-10, 10)\nax.grid(True, alpha=0.3)\n\nplt.tight_layout()\nplt.savefig(OUTPUT_PDF, dpi=150, bbox_inches=\'tight\')\nprint(f"\\nSaved plot to {OUTPUT_PDF}")\nprint(f"\\nSummary:")\nprint(f"  VBM: {vbv:.4f} eV")\nprint(f"  CBM: {cbm:.4f} eV")\nprint(f"  Band gap: {band_gap:.4f} eV")\n'}}
