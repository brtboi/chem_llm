t\',\n            \'pseudo_dir\': \'.\',\n            \'ecutwfc\': ECUTWFC_RY,\n            \'ecutrho\': ECUTRHO_RY,\n            \'occupations\': \'fixed\',   # MgO wide-gap insulator, non-metallic\n            \'conv_thr\': 1.0e-8,\n            \'nat\': nat,               # from actual Atoms (INVARIANT 1)\n            \'ntyp\': ntyp,\n        }\n        with open(os.path.join(d, \'pw.in\'), \'w\') as fd:\n            # 8x8x8 Monkhorst-Pack: dense for 2-atom primitive insulator cell\n            write_espresso_in(fd, atoms, input_data=scf_input,\n                              pseudopotentials=PSEUDOS, kpts=(8, 8, 8))\n\n        # ---- bands k-path (from THIS structure) ----\n        kpts, labels, res = build_kpath(atoms)\n        # explicit (n,4) array: crystal coords + weight column (unused for bands)\n        kpts4 = np.column_stack([kpts, np.ones(len(kpts))])\n\n        bands_input = dict(scf_input)\n        bands_input[\'calculation\'] = \'bands\'\n        bands_input[\'nbnd\'] = NBND\n        with open(os.path.join(d, \'bands.in\'), \'w\') as fd:\n            # ndarray kpts -> raw explicit k-points in crystal coordinates\n            write_espresso_in(fd, atoms, input_data=bands_input,\n                              pseudopotentials=PSEUDOS, kpts=kpts4)\n\n        # ---- bands.x post-processing (bands_post.in) ----\n        with open(os.path.join(d, \'bands_post.in\'), \'w\') as fd:\n            fd.write(\'&BANDS\\n\')\n            fd.write("  prefix = \'mgo\'\\n")\n            fd.write("  outdir = \'./out\'\\n")\n            fd.write(f"  filband = \'{i:03d}.bands.dat\'\\n")\n            fd.write(\'/\\n\')\n\n        # ---- band_labels.dat: label + index into the bands k-point list ----\n        with open(os.path.join(d, \'band_labels.dat\'), \'w\') as fd:\n            for idx, lbl in labels:\n                fd.write(f\'{idx} {lbl}\\n\')\n\n    print(f\'wrote {n} calculation directories\')\n\n\nif __name__ == \'__main__\':\n    main()\n'}}
