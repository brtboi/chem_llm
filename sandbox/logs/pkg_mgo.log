 {"tool": "write_file", "args": {"path": "generate_structures.py", "content": "import numpy as np\nfrom ase.io import read, write\n\n# STEP 2: generate 51 structures: 000 unperturbed base, 001-050 perturbed.\n# Displacement magnitude justification:\n#   Room-temperature thermal RMS displacement <u> of atoms in a solid is\n#   typically ~0.05-0.1 Ang (Debye-Waller factors for oxides give ~0.07 Ang).\n#   We use a Gaussian (normal) displacement with sigma = 0.08 Ang, applied\n#   independently to each Cartesian component of each atom -- chemically\n#   reasonable, small compared to the ~2.1 Ang Mg-O bond, so bonding topology\n#   is preserved. Lattice strain: small random isotropic+anisotropic strain\n#   with each component drawn uniformly in +/-1% (typical thermal-expansion\n#   / small-distortion scale) so the cell shape changes modestly.\n\nDISP_SIGMA = 0.08   # Angstrom, Gaussian stdev per Cartesian component\nMAX_STRAIN = 0.01   # +/-1% per strain tensor component\n\nbase = read('structures/mgo_primitive.cif')\nntyp_ref = len(set(base.get_chemical_symbols()))\nnat_ref = len(base)\n\nrng = np.random.default_rng(12345)\n\nfor i in range(51):\n    atoms = base.copy()\n    if i != 0:\n        # --- random lattice strain ---\n        # Build a symmetric strain tensor eps (small), new_cell = cell . (I + eps)\n        eps = rng.uniform(-MAX_STRAIN, MAX_STRAIN, size=(3, 3))\n        eps = 0.5 * (eps + eps.T)  # symmetric strain\n        deform = np.eye(3) + eps\n        new_cell = base.cell[:] @ deform\n        # scale_atoms=True moves atoms affinely with the cell (fractional coords fixed)\n        atoms.set_cell(new_cell, scale_atoms=True)\n        # --- random atomic displacements (thermal) ---\n        # rattle adds Gaussian noise (stdev in Angstrom) to Cartesian positions\n        atoms.rattle(stdev=DISP_SIGMA, rng=rng)\n\n    # INVARIANT 1: nat/ntyp computed from the actual Atoms object\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == nat_ref, f'structure {i}: nat {nat} != {nat_ref}'\n    assert ntyp == ntyp_ref, f'structure {i}: ntyp {ntyp} != {ntyp_ref}'\n\n    write(f'structures/structure_{i:03d}.cif', atoms)\n\nprint('wrote 51 structures, nat=%d ntyp=%d each' % (nat_ref, ntyp_ref))\n"}}
