{"tool": "write_file", "args": {"path": "setup_jobs.py", "content": "import os\nimport shutil\nimport numpy as np\nimport spglib\nimport seekpath\nfrom ase.io import read\nfrom ase.io.espresso import write_espresso_in\n\n# ---------------------------------------------------------------------------\n# STEP 5: for each perturbed structure NNN build calculations/NNN/ containing\n#   - pseudopotential files (pw.x runs inside calculations/NNN, pseudo_dir='.')\n#   - pw.in   (SCF)\n#   - bands.in (non-self-consistent bands along a seekpath-derived k-path)\n#   - bands_post.in (bands.x, filband='NNN.bands.dat')\n#   - band_labels.dat (high-symmetry label + its index in the k-point list)\n# ---------------------------------------------------------------------------\n\n# --- QE settings (STEP 4). Cutoffs converted Ha->Ry per INVARIANT 5. ---\nECUT_HA = 42.0                 # pseudo-dojo hint, in Hartree\nECUTWFC_RY = 2.0 * ECUT_HA     # 1 Ha = 2 Ry -> 84 Ry\nECUTRHO_RY = 4.0 * ECUTWFC_RY  # NC pseudos: rho cutoff = 4 x wfc cutoff -> 336 Ry\nassert ECUTWFC_RY == 84.0 and ECUTRHO_RY == 336.0\n\nNBND = 16          # generous pad; verified against pw.out 'number of electrons' in STEP 6\nKMESH = (8, 8, 8)  # Monkhorst-Pack SCF grid, dense for a 2-atom primitive cell\nNPTS_PER_SEG = 20  # interpolated points per k-path segment\nSYMPREC = 0.01     # match pymatgen default; avoid spglib 1e-5 under-detection\nPSEUDOS = {'Mg': 'Mg.upf', 'O': 'O.upf'}\n\nBASE_INPUT = {\n    'prefix': 'mgo',\n    'outdir': './out',\n    'pseudo_dir': '.',\n    'ecutwfc': ECUTWFC_RY,\n    'ecutrho': ECUTRHO_RY,\n    'occupations': 'fixed',   # MgO is a wide-gap insulator (non-metallic)\n    'conv_thr': 1.0e-8,\n}\n\n\ndef build_kpath(atoms):\n    \"\"\"Return (kpts_array (N,4) fractional in ACTUAL cell + weight, labels list of\n    (index, label)). Derived from THIS atoms object per INVARIANT 3.\"\"\"\n    cell_tuple = (atoms.cell[:], atoms.get_scaled_positions(),\n                  atoms.get_atomic_numbers())\n    res = seekpath.get_path(cell_tuple, symprec=SYMPREC)\n    # self-consistency check: seekpath sg == spglib sg for this exact structure\n    ds = spglib.get_symmetry_dataset(cell_tuple, symprec=SYMPREC)\n    sg_spglib = ds.number if hasattr(ds, 'number') else ds['number']\n    assert res['spacegroup_number'] == sg_spglib, (\n        f\"seekpath sg {res['spacegroup_number']} != spglib sg {sg_spglib}\")\n\n    # reproject seekpath primitive-cell fractional coords onto the ACTUAL cell's\n    # reciprocal lattice via Cartesian (INVARIANT 3). seekpath recip includes\n    # 2*pi already; ASE reciprocal() does NOT, so add 2*pi.\n    recip_prim = np.array(res['reciprocal_primitive_lattice'])\n    recip_actual = 2.0 * np.pi * np.array(atoms.cell.reciprocal()[:])\n    inv_recip_actual = np.linalg.inv(recip_actual)\n\n    def to_actual_frac(frac_prim):\n        cart = np.array(frac_prim) @ recip_prim\n        return cart @ inv_recip_actual\n\n    coords = {lbl: to_actual_frac(c) for lbl, c in res['point_coords'].items()}\n\n    kpts = []\n    labels = []  # list of (index_into_kpts, label)\n    for (a, b) in res['path']:\n        ca = coords[a]\n        cb = coords[b]\n        start_idx = len(kpts)\n        # mark start; if discontinuous from previous segment, label both sides\n        if labels and labels[-1][0] == start_idx:\n            # previous end lands on same index -> merge label\n            prev_lbl = labels[-1][1]\n            if prev_lbl != a:\n                labels[-1] = (start_idx, f'{prev_lbl}|{a}')\n        else:\n            labels.append((start_idx, a))\n        # each segment contributes its OWN start point + interior points\n        for j in range(NPTS_PER_SEG):\n            t = j / (NPTS_PER_SEG - 1)\n            k = (1 - t) * ca + t * cb\n            kpts.append(k)\n        labels.append((len(kpts) - 1, b))\n\n    kpts = np.array(kpts)\n    weights = np.ones((len(kpts), 1))  # weight unused for bands, constant\n    kpts4 = np.hstack([kpts, weights])\n    return kpts4, labels\n\n\ndef write_bands_kpoints(path, kpts4):\n    \"\"\"Append an explicit 'K_POINTS crystal' card (interpolation already done).\"\"\"\n    with open(path, 'a') as f:\n        f.write('\\nK_POINTS crystal\\n')\n        f.write('%d\\n' % len(kpts4))\n        for row in kpts4:\n            f.write('  %18.12f %18.12f %18.12f %8.4f\\n' %\n                    (row[0], row[1], row[2], row[3]))\n\n\ndef main():\n    n_struct = 51\n    for i in range(n_struct):\n        atoms = read(f'structures/structure_{i:03d}.cif')\n        nat = len(atoms)\n        ntyp = len(set(atoms.get_chemical_symbols()))\n        assert nat == 2 and ntyp == 2, f'struct {i}: nat={nat} ntyp={ntyp}'\n\n        cdir = f'calculations/{i:03d}'\n        os.makedirs(cdir, exist_ok=True)\n        # pseudos must resolve from inside the run dir (pseudo_dir='.')\n        for src in PSEUDOS.values():\n            shutil.copy(f'template/{src}', os.path.join(cdir, src))\n\n        # --- SCF input (pw.in) ---\n        scf_input = dict(BASE_INPUT)\n        scf_input['calculation'] = 'scf'\n        # flat dict -> ASE routes each key to its correct namelist (INVARIANT 6)\n        with open(os.path.join(cdir, 'pw.in'), 'w') as fd:\n            write_espresso_in(fd, atoms, input_data=scf_input,\n                              pseudopotentials=PSEUDOS, kpts=KMESH)\n\n        # --- bands input (bands.in) ---\n        bands_input = dict(BASE_INPUT)\n        bands_input['calculation'] = 'bands'\n        bands_input['nbnd'] = NBND\n        kpts4, labels = build_kpath(atoms)\n        bpath = os.path.join(cdir, 'bands.in')\n        # write with kpts=None (gamma), then strip any K_POINTS block and append\n        # our explicit crystal card\n        with open(bpath, 'w') as fd:\n            write_espresso_in(fd, atoms, input_data=bands_input,\n                              pseudopotentials=PSEUDOS, kpts=None)\n        # remove the auto-written K_POINTS section\n        with open(bpath) as fd:\n            lines = fd.readlines()\n        out_lines = []\n        skip = False\n        for ln in lines:\n            if ln.strip().upper().startswith('K_POINTS'):\n                skip = True\n                continue\n            if skip:\n                # skip until a blank line or next CARD/namelist\n                if ln.strip() == '' or ln.strip().startswith('&') or \\\n                   ln.strip().split()[0].isupper() and '_' in ln.strip().split()[0]:\n                    skip = False\n                    if ln.strip() != '':\n                        out_lines.append(ln)\n                continue\n            out_lines.append(ln)\n        with open(bpath, 'w') as fd:\n            fd.writelines(out_lines)\n        write_bands_kpoints(bpath, kpts4)\n\n        # --- band_labels.dat ---\n        with open(os.path.join(cdir, 'band_labels.dat'), 'w') as fd:\n            for idx, lbl in labels:\n                fd.write('%d %s\\n' % (idx, lbl))\n\n        # --- bands_post.in (bands.x) ---\n        with open(os.path.join(cdir, 'bands_post.in'), 'w') as fd:\n            fd.write('&BANDS\\n')\n            fd.write(\"  prefix = 'mgo'\\n\")\n            fd.write(\"  outdir = './out'\\n\")\n            fd.write(\"  filband = '%03d.bands.dat'\\n\" % i)\n            fd.write('/\\n')\n\n    print('setup complete for %d structures' % n_struct)\n\n\nif __name__ == '__main__':\n    main()\n"}}

