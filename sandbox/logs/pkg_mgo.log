 {"tool": "write_file", "args": {"path": "plot_bands.py", "content": "import re\nimport numpy as np\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\n\n# STEP 7: plot the band structure for calculations/000, aligned to VBM.\n\nCALC = 'calculations/000'\nBANDS_FILE = f'{CALC}/000.bands.dat'   # QE plotband (filband) output, real & non-empty\nLABELS_FILE = f'{CALC}/band_labels.dat'\nPW_OUT = f'{CALC}/pw.out'\n\n# --- read number of electrons / occupied bands from pw.out (INVARIANT 2) ---\n# occupied bands = number of electrons / 2 for a spin-unpolarized non-metal;\n# QE also prints 'number of Kohn-Sham states' but that is nbnd of the SCF run,\n# so use 'number of electrons' as ground truth.\nnelec = None\nfor line in open(PW_OUT):\n    m = re.search(r'number of electrons\\s*=\\s*([0-9.]+)', line)\n    if m:\n        nelec = float(m.group(1))\n        break\nassert nelec is not None, 'could not read number of electrons from pw.out'\nn_occ = int(round(nelec / 2))   # spin-unpolarized insulator\nprint(f'number of electrons = {nelec}, occupied bands = {n_occ}')\n\n# --- parse the QE plotband (filband) file ---\n# format: ' &plot nbnd=  N, nks=  M /' header, then per k-point:\n#   a coordinate line (3 floats, 2pi/alat cartesian), then nbnd energies (eV),\n#   wrapped across lines (10 per line).\nwith open(BANDS_FILE) as f:\n    text = f.read()\nhead = text.splitlines()[0]\nmh = re.search(r'nbnd=\\s*(\\d+),\\s*nks=\\s*(\\d+)', head)\nnbnd = int(mh.group(1))\nnks = int(mh.group(2))\n\n# tokenize everything after the header line\nbody = text.split('/', 1)[1]\nnums = np.array([float(x) for x in body.split()])\n# each k-point block = 3 (coords) + nbnd (energies)\nblock = 3 + nbnd\nassert nums.size == nks * block, f'expected {nks*block} numbers, got {nums.size}'\nnums = nums.reshape(nks, block)\nkcoords = nums[:, :3]          # 2pi/alat cartesian\nenergies = nums[:, 3:]         # (nks, nbnd) in eV\n\n# --- cumulative k-path distance in 2pi/alat (INVARIANT 4: same units as ticks) ---\ndk = np.diff(kcoords, axis=0)\nseg_len = np.linalg.norm(dk, axis=1)\nxk = np.concatenate([[0.0], np.cumsum(seg_len)])   # length nks, in 2pi/alat\n\n# --- VBM / CBM / gap (align to VBM) ---\nvbm = energies[:, n_occ - 1].max()   # top of the n_occ-th band\ncbm = energies[:, n_occ].min()       # bottom of the (n_occ+1)-th band\ngap = cbm - vbm\nprint(f'VBM = {vbm:.4f} eV, CBM = {cbm:.4f} eV, band gap = {gap:.4f} eV')\nen_shifted = energies - vbm\n\n# --- read band_labels.dat: index-into-kpoint-list + label ---\nlab_idx = []\nlab_txt = []\nfor line in open(LABELS_FILE):\n    parts = line.split()\n    if len(parts) >= 2:\n        lab_idx.append(int(parts[0]))\n        lab_txt.append(parts[1])\n\n# --- Determine ticks and genuine discontinuities ---\n# QE plotband splits (\"two consecutive same k\") wherever two consecutive\n# k-points are identical. band_labels pairs like (29 X, 30 X) are the SAME\n# physical point shared by adjacent seekpath segments (zero coord distance):\n# these are NOT discontinuities, just a merged tick. A genuine discontinuity\n# is where the label already carries a '|' (built in setup_jobs when the\n# previous segment's end differs from the next segment's start), e.g. 'U|K'.\n# Build tick positions (in xk units) and merge coincident indices.\ntick_pos = []\ntick_lab = []\nseen = {}\nfor idx, txt in zip(lab_idx, lab_txt):\n    pos = xk[idx]\n    # merge with a previous tick at (essentially) the same x position\n    if tick_pos and abs(pos - tick_pos[-1]) < 1e-9:\n        # same physical location -> keep the more informative label\n        if '|' in txt and '|' not in tick_lab[-1]:\n            tick_lab[-1] = txt\n        elif txt != tick_lab[-1] and '|' not in tick_lab[-1]:\n            tick_lab[-1] = txt\n        continue\n    tick_pos.append(pos)\n    tick_lab.append(txt)\n\ntick_pos = np.array(tick_pos)\n\n# INVARIANT 4 assertion: ticks span the same numeric range as the band data x-axis\nassert abs(tick_pos.max() - xk.max()) < 0.05 * xk.max(), \\\n    f'tick range {tick_pos.max()} != band x range {xk.max()} -- unit mismatch'\n\n# --- Find genuine discontinuities to break the plotted line ---\n# A genuine jump: consecutive k-points identical (zero distance) AND the two\n# sides are DIFFERENT physical labels (i.e. seekpath path was discontinuous).\n# Detect via coord equality between consecutive points that also corresponds\n# to a '|' label. We break the line at any index i where the label carries '|'.\njump_after = set()\nfor idx, txt in zip(lab_idx, lab_txt):\n    if '|' in txt:\n        # the discontinuity is between index idx-? ; the '|' label sits at the\n        # end of the previous segment (idx is the last point of prev segment)\n        jump_after.add(idx)\n\n# --- plot ---\nfig, ax = plt.subplots(figsize=(7, 5))\nnkpts = en_shifted.shape[0]\nfor b in range(nbnd):\n    # break the line wherever a genuine discontinuity occurs\n    start = 0\n    for i in range(1, nkpts):\n        # a coincident-point break: identical coords -> zero segment length\n        if seg_len[i - 1] < 1e-12:\n            # only a genuine discontinuity if that break index is flagged\n            if (i - 1) in jump_after:\n                ax.plot(xk[start:i], en_shifted[start:i, b], 'b-', lw=0.8)\n                start = i\n    ax.plot(xk[start:nkpts], en_shifted[start:nkpts, b], 'b-', lw=0.8)\n\nax.axhline(0.0, color='k', ls=':', lw=0.6)  # VBM reference\nfor p in tick_pos:\n    ax.axvline(p, color='gray', ls='-', lw=0.4)\nax.set_xticks(tick_pos)\ntick_lab_disp = ['$\\\\Gamma$' if t == 'GAMMA' else t for t in tick_lab]\nax.set_xticklabels(tick_lab_disp)\nax.set_xlim(xk.min(), xk.max())\nax.set_ylim(-10, 10)   # +/-10 eV around VBM (INVARIANT 4 y-range advice)\nax.set_ylabel('Energy - VBM (eV)')\nax.set_title(f'MgO band structure (gap = {gap:.2f} eV)')\nfig.tight_layout()\nfig.savefig(f'{CALC}/bands_000.pdf')\nprint(f'wrote {CALC}/bands_000.pdf')\n"}}
