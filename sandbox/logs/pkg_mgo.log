 {'tool': 'write_file', 'args': {'path': 'setup_jobs.py', 'content': 'import os\nimport shutil\nimport numpy as np\nimport seekpath\nimport spglib\nfrom ase.io import read\nfrom ase.io.espresso import write_espresso_in\n\n# STEP 5: build calculations/NNN for each structure with pw.in (SCF),\n# bands.in (NSCF bands along a seekpath-derived k-path), bands_post.in,\n# band_labels.dat, and copies of the pseudopotentials.\n\n# --- unit / cutoff bookkeeping (INVARIANT 5) ---\n# get_pseudopotential returned ecut hint = 42.0 Ha for both Mg and O.\n# QE ecutwfc/ecutrho are in Rydberg. 1 Ha = 2 Ry.\nECUT_HA = 42.0\nECUTWFC_RY = 2.0 * ECUT_HA            # = 84.0 Ry\nECUTRHO_RY = 4.0 * ECUTWFC_RY         # NC pseudopotentials: rho cutoff = 4 * wfc cutoff\nassert ECUTWFC_RY == 84.0\nassert ECUTRHO_RY == 336.0\n\nNPTS_PER_SEG = 30                     # interpolated points per k-path segment\nNBND = 16                            # padded generously; verified vs pw.out in STEP 6\nSYMPREC = 0.01                       # match pymatgen default (INVARIANT 3)\n\nPSEUDOS = {\'Mg\': \'Mg.upf\', \'O\': \'O.upf\'}\nTEMPLATE_DIR = \'template\'\n\n\ndef build_kpath(atoms):\n    """Derive an explicit K_POINTS crystal card from THIS atoms object\n    using seekpath (lattice+basis aware), re-projected onto the actual\n    reciprocal cell (INVARIANT 3)."""\n    cell_tuple = (atoms.cell[:], atoms.get_scaled_positions(),\n                  atoms.get_atomic_numbers())\n    res = seekpath.get_path(cell_tuple, symprec=SYMPREC)\n    # self-consistency check: seekpath path SG must match spglib SG\n    ds = spglib.get_symmetry_dataset(cell_tuple, symprec=SYMPREC)\n    sg = ds.number if hasattr(ds, \'number\') else ds[\'number\']\n    assert res[\'spacegroup_number\'] == sg, \\\n        f"seekpath SG {res[\'spacegroup_number\']} != spglib SG {sg}"\n\n    recip_prim = np.array(res[\'reciprocal_primitive_lattice\'])  # includes 2*pi\n    recip_actual = 2 * np.pi * np.array(atoms.cell.reciprocal()[:])  # add