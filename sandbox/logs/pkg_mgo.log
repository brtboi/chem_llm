{"tool": "write_file", "args": {"path": "setup_jobs.py", "content": "import os\nimport shutil\nimport numpy as np\nimport seekpath\nimport spglib\nfrom ase.io import read\nfrom ase.io.espresso import write_espresso_in\n\n# STEP 5: build calculations/NNN for each structure with pw.in (SCF),\n# bands.in (NSCF bands along a seekpath-derived k-path), bands_post.in,\n# band_labels.dat, and copies of the pseudopotentials.\n\n# --- unit / cutoff bookkeeping (INVARIANT 5) ---\n# get_pseudopotential returned ecut hint = 42.0 Ha for both Mg and O.\n# QE ecutwfc/ecutrho are in Rydberg. 1 Ha = 2 Ry.\nECUT_HA = 42.0\nECUTWFC_RY = 2.0 * ECUT_HA            # = 84.0 Ry\nECUTRHO_RY = 4.0 * ECUTWFC_RY         # NC pseudopotentials: rho cutoff = 4 * wfc cutoff\nassert ECUTWFC_RY == 84.0\nassert ECUTRHO_RY == 336.0\n\nNPTS_PER_SEG = 30                     # interpolated points per k-path segment\nNBND = 16                            # padded generously; verified vs pw.out in STEP 6\nSYMPREC = 0.01                       # match pymatgen default (INVARIANT 3)\n\nPSEUDOS = {'Mg': 'Mg.upf', 'O': 'O.upf'}\nTEMPLATE_DIR = 'template'\n\n\ndef build_kpath(atoms):\n    \"\"\"Derive an explicit K_POINTS crystal card from THIS atoms object\n    using seekpath (lattice+basis aware), re-projected onto the actual\n    reciprocal cell (INVARIANT 3).\"\"\"\n    cell_tuple = (atoms.cell[:], atoms.get_scaled_positions(),\n                  atoms.get_atomic_numbers())\n    res = seekpath.get_path(cell_tuple, symprec=SYMPREC)\n    # self-consistency check: seekpath path SG must match spglib SG\n    ds = spglib.get_symmetry_dataset(cell_tuple, symprec=SYMPREC)\n    sg = ds.number if hasattr(ds, 'number') else ds['number']\n    assert res['spacegroup_number'] == sg, \\\n        f\"seekpath SG {res['spacegroup_number']} != spglib SG {sg}\"\n\n    recip_prim = np.array(res['reciprocal_primitive_lattice'])  # includes 2*pi\n    recip_actual = 2 * np.pi * np.array(atoms.cell.reciprocal()[:])  # add 2*pi\n\n    def to_actual_frac(frac_prim):\n        cart = np.array(frac_prim) @ recip_prim\n        return cart @ np.linalg.inv(recip_actual)\n\n    pc = {lbl: to_actual_frac(c) for lbl, c in res['point_coords'].items()}\n\n    kpts = []          # explicit (n,3) fractional coords in ACTUAL cell\n    labels = []        # (index_in_kpts, label) for high-symmetry points\n    for seg_i, (a, b) in enumerate(res['path']):\n        ka = pc[a]\n        kb = pc[b]\n        # Determine label for the start of this segment; mark discontinuity\n        if seg_i > 0:\n            prev_b = res['path'][seg_i - 1][1]\n            if prev_b != a:\n                # genuine jump: relabel the previous end tick as 'prev|a'\n                labels[-1] = (labels[-1][0], f'{prev_b}|{a}')\n        start_lbl = a\n        # append start point of segment (every segment contributes its start)\n        labels.append((len(kpts), start_lbl))\n        for t in range(NPTS_PER_SEG):\n            frac = ka + (kb - ka) * (t / (NPTS_PER_SEG - 1))\n            kpts.append(frac)\n        # label the end point\n        labels.append((len(kpts) - 1, b))\n    kpts = np.array(kpts)\n    return kpts, labels, res\n\n\ndef main():\n    n = 51\n    for i in range(n):\n        atoms = read(f'structures/structure_{i:03d}.cif')\n        nat = len(atoms)\n        ntyp = len(set(atoms.get_chemical_symbols()))\n        assert nat == 2 and ntyp == 2, f'struct {i}: nat={nat} ntyp={ntyp}'\n\n        d = f'calculations/{i:03d}'\n        os.makedirs(d, exist_ok=True)\n        # copy pseudos into the run dir (pw.x runs inside d, pseudo_dir='.')\n        for el, fn in PSEUDOS.items():\n            shutil.copy(os.path.join(TEMPLATE_DIR, fn), os.path.join(d, fn))\n\n        # ---- SCF input (pw.in) ----\n        # Flat input_data; ASE routes keys to correct namelists (INVARIANT 6).\n        scf_input = {\n            'calculation': 'scf',\n            'prefix': 'mgo',\n            'outdir': './out',\n            'pseudo_dir': '.',\n     