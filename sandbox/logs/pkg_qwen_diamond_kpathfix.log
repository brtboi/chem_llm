\\n    f"Space group mismatch: seekpath={res[\'spacegroup_number\']}, spglib={spg_dataset.number}"\nprint(f"Space group: #{res[\'spacegroup_number\']}")\n\n# Build the k-point list from the path\n# Each segment: (label_from, label_to)\n# For each segment, add the start point and NPTS_PER_SEGMENT-1 interior points\n# (the end point is the start of the next segment, so we don\'t duplicate it)\n# EXCEPT for the last segment, where we include the end point.\n\npath = res[\'path\']\npoint_coords = res[\'point_coords\']\n\nkpts_list = []\nlabel_indices = []  # (label, index_in_kpts_list)\n\nfor i, (label_from, label_to) in enumerate(path):\n    start = np.array(point_coords[label_from])\n    end = np.array(point_coords[label_to])\n    \n    # Add the start point of this segment\n    if i == 0 or not np.allclose(start, kpts_list[-1], atol=1e-10):\n        # This is either the first segment or a discontinuous jump\n        kpts_list.append(start)\n        label_indices.append((label_from, len(kpts_list) - 1))\n    else:\n        # Continuous: the start point is already the last point added\n        # (it was the end of the previous segment)\n        pass\n    \n    # Add interior points (not including the end point, which will be the start of the next segment)\n    for j in range(1, NPTS_PER_SEGMENT):\n        t = j / NPTS_PER_SEGMENT\n        pt = start + t * (end - start)\n        kpts_list.append(pt)\n    \n    # Add the end point of this segment (which is the start of the next, or the final point)\n    kpts_list.append(end)\n    label_indices.append((label_to, len(kpts_list) - 1))\n\n# Convert to numpy array of shape (n_kpts, 4) with weight column = 1.0\nkpts_array = np.zeros((len(kpts_list), 4))\nfor i, pt in enumerate(kpts_list):\n    kpts_array[i, :3] = pt\n    kpts_array[i, 3] = 1.0\n\nprint(f"K-path: {path}")\nprint(f"Total k-points: {len(kpts_list)}")\nprint(f"Label indices: {label_indices}")\n\n# --- Create calculation directories and write input files ---\nfor nnn in range(51):\n    calc_dir = f\'calculations/{nnn:03d}\'\n    os.makedirs(calc_dir, exist_ok=True)\n    \n    # Copy pseudopotential\n    shutil.copy(\'template/C.pbesol-sr-pp.upf\', os.path.join(calc_dir, \'C.pbesol-sr-pp.upf\'))\n    \n    # Read the structure for this NNN\n    atoms = read(f\'structures/structure_{nnn:03d}.cif\')\n    \n    # INVARIANT 1: nat and ntyp computed from the actual Atoms object\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == 2, f"Structure {nnn:03d}: expected 2 atoms, got {nat}"\n    assert ntyp == 1, f"Structure {nnn:03d}: expected 1 element type, got {ntyp}"\n    \n    # --- SCF input (pw.in) ---\n    scf_input_data = {\n        \'calculation\': \'scf\',\n        \'prefix\': PREFIX,\n        \'outdir\': OUTDIR,\n        \'pseudo_dir\': \'./\',\n        \'ecutwfc\': Ecutwfc_RY,\n        \'ecutrho\': Ecutrho_RY,\n        \'occupations\': \'fixed\',\n        \'conv_thr\': CONV_THR,\n        \'nat\': nat,\n        \'ntyp\': ntyp,\n    }\n    \n    # 4x4x4 Monkhorst-Pack grid for SCF\n    write_espresso_in(\n        os.path.join(calc_dir, \'pw.in\'),\n        atoms,\n        input_data=scf_input_data,\n        pseudopotentials={\'C\': \'C.pbesol-sr-pp.upf\'},\n        kpts=(4, 4, 4),\n        crystal_coordinates=True,\n    )\n    \n    # --- Bands input (bands.in) ---\n    bands_input_data = {\n        \'calculation\': \'bands\',\n        \'prefix\': PREFIX,\n        \'outdir\': OUTDIR,\n        \'pseudo_dir\': \'./\',\n        \'ecutwfc\': Ecutwfc_RY,\n        \'ecutrho\': Ecutrho_RY,\n        \'occupations\': \'fixed\',\n        \'conv_thr\': CONV_THR,\n        \'nbnd\': NBND,\n        \'nat\': nat,\n        \'ntyp\': ntyp,\n    }\n    \n    # Explicit k-point list from seekpath\n    write_espresso_in(\n        os.path.join(calc_dir, \'bands.in\'),\n        atoms,\n        input_data=bands_input_data,\n        pseudopotentials={\'C\': \'C.pbesol-sr-pp.upf\'},\n        kpts=kpts_array,\n        crystal_coordinates=True,\n    )\n    \n    # --- Bands post-processing input (bands_post.in) ---\n    bands_post_input_data = {\n        \'prefix\': PREFIX,\n        \'outdir\': OUTDIR,\n        \'filband\': f\'{nnn:03d}.bands.dat\',\n    }\n    \n    with open(os.path.join(calc_dir, \'bands_post.in\'), \'w\') as f:\n        write_fortran_namelist(f, bands_post_input_data, binary=\'bands\')\n    \n    # --- Band labels file ---\n    # Write each high-symmetry label and its index in the k-point list\n    with open(os.path.join(calc_dir, \'band_labels.dat\'), \'w\') as f:\n        for label, idx in label_indices:\n            f.write(f"{label} {idx}\\n")\n    \n    print(f"Wrote {calc_dir}/ (pw.in, bands.in, bands_post.in, band_labels.dat)")\n\nprint("\\nDone. All 51 calculation directories created.")\n', 'truncated': False, 'total_chars': 6482}

