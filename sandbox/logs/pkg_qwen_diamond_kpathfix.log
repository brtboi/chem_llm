 {'tool': 'write_file', 'args': {'path': 'plot_bands.py', 'content': '#!/usr/bin/env python3\n"""\nPlot the band structure for calculations/000 (diamond C).\n\nReads the bands.x output file (000.bands.dat), aligns energies to the VBM,\nand produces a publication-quality band structure plot with high-symmetry\ntick marks.\n\nThe VBM is determined from the occupied-band count read from pw.out\n(number of Kohn-Sham states = 4, so the 4th band is the VBM).\n\nThe x-axis uses the cumulative k-path distance in 2*pi/alat units,\nwhich is the same unit system as the k-coordinates in the bands.dat file.\nHigh-symmetry tick positions are computed from the k-point list in the\nbands.dat file, ensuring they are in the same units as the band data.\n"""\n\nimport numpy as np\nimport matplotlib\nmatplotlib.use(\'Agg\')\nimport matplotlib.pyplot as plt\nimport re\n\n# --- Read the bands.x output file ---\n# The file format is:\n#   &plot nbnd= 16, nks= 122 /\n#   kx ky kz\n#   e1 e2 ... e16\n#   kx ky kz\n#   e1 e2 ... e16\n#   ...\n\nbands_file = \'calculations/000/000.bands.dat\'\n\nwith open(bands_file, \'r\') as f:\n    lines = f.readlines()\n\n# Parse the header to get nbnd and nks\nheader = lines[0].strip()\nmatch = re.match(r\'&plot\\s+nbnd=\\s*(\\d+),\\s*nks=\\s*(\\d+)\\s*/\', header)\nassert match, f"Could not parse header: {header}"\nnbnd = int(match.group(1))\nnks = int(match.group(2))\nprint(f"Parsed header: nbnd={nbnd}, nks={nks}")\n\n# Parse k-points and energies\nkpoints = []\nenergies = []\n\ni = 1\nwhile i < len(lines):\n    line = lines[i].strip()\n    if not line:\n        i += 1\n        continue\n    \n    # Check if this line has 3 numbers (k-point) or 16 numbers (energies)\n    parts = line.split()\n    if len(parts) == 3:\n        kpoints.append([float(x) for x in parts])\n        i += 1\n    elif len(parts) == nbnd:\n        energies.append([float(x) for x in parts])\n        i += 1\n    else:\n        # Might be a continuation of the energy line (if wrapped)\n        # Try to accumulate until we have nbnd values\n        vals = [float(x) for x in parts]\n        while len(vals) < nbnd and i + 1 < len(lines):\n            i += 1\n            vals.extend([float(x) for x in lines[i].strip().split()])\n        energies.append(vals[:nbnd])\n        i += 1\n\nkpoints = np.array(kpoints)\nenergies = np.array(energies)\n\nassert len(kpoints) == nks, f"Expected {nks} k-points, got {len(kpoints)}"\nassert len(energies) == nks, f"Expected {nks} energy rows, got {len(energies)}"\nassert energies.shape[1] == nbnd, f"Expected {nbnd} bands, got {energies.shape[1]}"\n\nprint(f"Parsed {len(kpoints)} k-points, {energies.shape[1]} bands")\n\n# --- Read the occupied-band count from pw.out ---\n# The line \'number of Kohn-Sham states = 4\' tells us the number of occupied bands\nwith open(\'calculations/000/pw.out\', \'r\') as f:\n    pw_out = f.read()\n\nmatch = re.search(r\'number of Kohn-Sham states\\s*=\\s*(\\d+)\', pw_out)\nassert match, "Could not find \'number of Kohn-Sham states\' in pw.out"\nn_occ = int(match.group(1))\nprint(f"Number of occupied bands (from pw.out): {n_occ}")\n\n# --- Compute the VBM ---\n# The VBM is the maximum energy among the occupied bands (bands 0 to n_occ-1)\n# across all k-points\nvbm = np.max(energies[:, :n_occ])\nprint(f"VBM = {vbm:.4f} eV")\n\n# --- Compute the CBM ---\n# The CBM is the minimum energy among the unoccupied bands (bands n_occ to nbnd-1)\ncbm = np.min(energies[:, n_occ:])\nprint(f"CBM = {cbm:.4f} eV")\n\n# --- Compute the band gap ---\nband_gap = cbm - vbm\nprint(f"Band gap = {band_gap:.4f} eV")\n\n# --- Read the band labels ---\nwith open(\'calculations/000/band_labels.dat\', \'r\') as f:\n    labels = []\n    for line in f:\n        parts = line.strip().split()\n        if len(parts) == 2:\n            labels.append((parts[0], int(parts[1])))\n\nprint(f"Band labels: {labels}")\n\n# --- Compute the cumulative k-path distance ---\n# The k-points are in crystal coordinates (fractional).\n# We need to convert to Cartesian coordinates in units of 2*pi/alat\n# to compute the path distance.\n\n# Read the cell from the structure\nfrom ase.io import read\natoms = read(\'structures/structure_000.cif\')\ncell = atoms.cell[:]\n\n# Compute the reciprocal lattice vectors\n# The reciprocal lattice vectors b_i satisfy a_i . b_j = 2*pi*delta_ij\na1, a2, a3 = cell[0], cell[1], cell[2]\nvolume = np.dot(a1, np.cross(a2, a3))\n\nb1 = 2 * np.pi * np.cross(a2, a3) / volume\nb2 = 2 * np.pi * np.cross(a3, a1) / volume\nb3 = 2 * np.pi * np.cross(a1, a2) / volume\n\n# The reciprocal lattice vectors in units of 2*pi/alat:\n# From pw.out: lattice parameter (alat) = 4.7580 a.u. = 4.7580 * 0.529177 A = 2.5178 A\n# So 2*pi/alat = 2*pi/2.5178 A^-1\n\nalat_au = 4.7580  # from pw.out\nalat_A = alat_au * 0.529177  # convert to Angstrom\n\n# The reciprocal vectors in units of 2*pi/alat_A:\nb1_unit = b1 / (2 * np.pi / alat_A)\nb2_unit = b2 / (2 * np.pi / alat_A)\nb3_unit = b3 / (2 * np.pi / alat_A)\n\nprint(f"Reciprocal lattice vectors (in units of 2*pi/alat):")\nprint(f"  b1 = {b1_unit}")\nprint(f"  b2 = {b2_unit}")\nprint(f"  b3 = {b3_unit}")\n\n# Convert k-points from crystal coordinates to Cartesian coordinates in units of 2*pi/alat\nk_cart = np.zeros_like(kpoints)\nfor i in range(len(kpoints)):\n    k_cart[i] = (kpoints[i, 0] * b1_unit + \n                 kpoints[i, 1] * b2_unit + \n                 kpoints[i, 2] * b3_unit)\n\n# Compute the cumulative path distance\ndistances = np.zeros(len(kpoints))\nfor i in range(1, len(kpoints)):\n    distances[i] = distances[i-1] + np.linalg.norm(k_cart[i] - k_cart[i-1])\n\nprint(f"Total path distance: {distances[-1]:.4f} (in units of 2*pi/alat)")\n\n# --- Compute the high-symmetry tick positions ---\n# The tick positions are the cumulative distances at the labeled k-points\ntick_positions = []\ntick_labels = []\n\nfor label, idx in labels:\n    tick_positions.append(distances[idx])\n    tick_labels.append(label)\n\ntick_positions = np.array(tick_positions)\ntick_labels = np.array(tick_labels)\n\nprint(f"Tick positions: {tick_positions}")\nprint(f"Tick labels: {tick_labels}")\n\n# --- INVARIANT 4 CHECK: tick positions must span the same range as the band data ---\n# The band data\'s k column is the cumulative distance, which spans [0, distances[-1]]\n# The tick positions should span approximately the same range\nassert abs(tick_positions[-1] - distances[-1]) < 0.05 * distances[-1], \\\n    f"Tick positions ({tick_positions[-1]:.4f}) do not span the same range as band data ({distances[-1]:.4f})"\nprint("INVARIANT 4 check passed: tick positions span the same range as band data")\n\n# --- Identify discontinuities in the path ---\n# A discontinuity occurs when the k-point at the end of one segment differs\n# from the k-point at the start of the next segment.\n# From the path: GAMMA-X-U-K-GAMMA-L-W-X\n# The discontinuity is at U->K (index 40 -> 41)\n\n# Check for discontinuities by comparing consecutive k-points\n# A discontinuity is when the distance between consecutive k-points is large\n# (much larger than the typical step size)\n\ntypical_step = np.median(np.diff(distances))\nprint(f"Typical step size: {typical_step:.6f}")\n\ndiscontinuities = []\nfor i in range(1, len(kpoints)):\n    step = distances[i] - distances[i-1]\n    if step > 5 * typical_step:\n        discontinuities.append(i)\n        print(f"Discontinuity at index {i} (step = {step:.6f})")\n\nprint(f"Discontinuities at indices: {discontinuities}")\n\n# --- Plot the band structure ---\nfig, ax = plt.subplots(figsize=(10, 6))\n\n# Plot each band\nfor band in range(nbnd):\n    # Split the band at discontinuities\n    segments = []\n    current_segment = [0]\n    for i in range(1, len(kpoints)):\n        if i in discontinuities:\n            segments.append(current_segment)\n            current_segment = [i]\n        else:\n            current_segment.append(i)\n    segments.append(current_segment)\n    \n    for seg in segments:\n        x = distances[seg]\n        y = energies[seg, band] - vbm  # Align to VBM\n        ax.plot(x, y, \'b-\', linewidth=0.8)\n\n# Add high-symmetry tick marks\nfor pos, label in zip(tick_positions, tick_labels):\n    ax.axvline(x=pos, color=\'gray\', linestyle=\'--\', linewidth=0.5, alpha=0.5)\nax.set_xticks(tick_positions)\nax.set_xticklabels(tick_labels)\n\n# Set axis labels and title\nax.set_xlabel(r\'k-point path (in units of $2\\pi$/alat)\')\nax.set_ylabel(\'Energy (eV) relative to VBM\')\nax.set_title(\'Diamond C band structure (PBEsol, 82 Ry cutoff)\')\n\n# Restrict y-axis to +/-10 eV around VBM\nax.set_ylim(-10, 10)\n\n# Add a horizontal line at E=0 (VBM)\nax.axhline(y=0, color=\'red\', linestyle=\':\', linewidth=0.5, alpha=0.5)\n\nplt.tight_layout()\nplt.savefig(\'calculations/000/bands_000.pdf\', bbox_inches=\'tight\')\nprint("Saved plot to calculations/000/bands_000.pdf")\n\n# --- Print summary ---\nprint(f"\\nSummary:")\nprint(f"  VBM = {vbm:.4f} eV")\nprint(f"  CBM = {cbm:.4f} eV")\nprint(f"  Band gap = {band_gap:.4f} eV")\n'}}
