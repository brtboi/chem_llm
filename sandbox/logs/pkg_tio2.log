 {"tool": "write_file", "args": {"path": "setup_jobs.py", "content": "import os, shutil\nimport numpy as np\nimport seekpath, spglib\nfrom ase.io import read\nfrom ase.io.espresso import write_espresso_in\n\n# STEP 5: build calculations/NNN/ for each structure.\n#\n# INVARIANT 5 unit conversion:\n#   get_pseudopotential returned ecut hint = 42.0 Ha (both Ti and O).\n#   QE ecutwfc/ecutrho are in Rydberg. 1 Ha = 2 Ry.\nECUT_HA = 42.0\nECUTWFC_RY = 2.0 * ECUT_HA          # 84.0 Ry\nassert ECUTWFC_RY == 84.0\nECUTRHO_RY = 4.0 * ECUTWFC_RY        # 336.0 Ry (NC needs rho cutoff >= 4x wfc)\nassert ECUTRHO_RY == 336.0\n\n# nbnd for the bands calc, written BEFORE the SCF exists. INVARIANT 2 says do\n# NOT trust the pseudo n_valence hint; pad generously above a best estimate.\n# Naive electrons: 2*Ti(4) + 4*O(6) = 32 -> 16 occupied. Pad to 28.\n# Re-checked against pw.out 'number of electrons' in STEP 6.\nNBND = 28\n\nKPTS_SCF = (6, 6, 9)   # Monkhorst-Pack; denser along c* (rutile c<a real space)\nNPTS_SEG = 20          # interpolation points per k-path segment\n\nPSEUDOS = {'Ti': 'Ti.upf', 'O': 'O.upf'}\nTEMPLATE = 'template'\n\n\ndef kpath_for(atoms):\n    \"\"\"INVARIANT 3: derive k-path from THIS exact Atoms object via seekpath.\n    Returns (kpts_array (n,4), labels list of (index, label)).\"\"\"\n    cell_tuple = (atoms.cell[:], atoms.get_scaled_positions(),\n                  atoms.get_atomic_numbers())\n    res = seekpath.get_path(cell_tuple, symprec=0.01)\n    # cross-check the symmetry the path assumes against spglib at same symprec\n    sg_check = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01)\n    sg_check_n = sg_check.number if hasattr(sg_check, 'number') else sg_check['number']\n    assert res['spacegroup_number'] == sg_check_n, (\n        f\"seekpath sg {res['spacegroup_number']} != spglib {sg_check_n}\")\n\n    recip_prim = np.array(res['reciprocal_primitive_lattice'])   # includes 2*pi\n    recip_actual = 2 * np.pi * np.array(atoms.cell.reciprocal()[:])  # add 2*pi\n\n    def to_actual_frac(frac_prim):\n        # go through Cartesian: seekpath's primitive cell may differ in\n        # shape/orientation from the cell we actually write.\n        cart = np.array(frac_prim) @ recip_prim\n        return cart @ np.linalg.inv(recip_actual)\n\n    pc = {lbl: to_actual_frac(c) for lbl, c in res['point_coords'].items()}\n\n    kpts = []\n    labels = []  # (index_in_kpts, label)\n    path = res['path']\n    for seg_i, (a, b) in enumerate(path):\n        ka, kb = pc[a], pc[b]\n        # Detect discontinuity: previous segment's end != this segment's start\n        if seg_i > 0:\n            prev_b = path[seg_i - 1][1]\n            if prev_b != a:\n                # relabel the previous end index with both sides\n                labels[-1] = (labels[-1][0], f'{prev_b}|{a}')\n        # every segment contributes its own start point\n        start_idx = len(kpts)\n        if seg_i == 0 or path[seg_i - 1][1] != a:\n            labels.append((start_idx, a))\n        kpts.append(ka)\n        for j in range(1, NPTS_SEG):\n            t = j / (NPTS_SEG - 1)\n            kpts.append((1 - t) * ka + t * kb)\n        labels.append((len(kpts) - 1, b))\n\n    kpts = np.array(kpts)\n    kpts_w = np.hstack([kpts, np.ones((len(kpts), 1))])  # weight col (unused)\n    return kpts_w, labels\n\n\ncommon_input = {\n    'prefix': 'tio2',\n    'outdir': './out',\n    'pseudo_dir': '.',\n    'ecutwfc': ECUTWFC_RY,\n    'ecutrho': ECUTRHO_RY,\n    'occupations': 'fixed',   # rutile TiO2 is an insulator; fixed occupations\n    'conv_thr': 1.0e-8,       # ASE routes this to &ELECTRONS (INVARIANT 6)\n}\n\nfor i in range(51):\n    nnn = f'{i:03d}'\n    d = f'calculations/{nnn}'\n    os.makedirs(d, exist_ok=True)\n    for el, fn in PSEUDOS.items():\n        shutil.copyfile(os.path.join(TEMPLATE, fn), os.path.join(d, fn))\n\n    atoms = read(f'structures/structure_{nnn}.cif')\n\n    # INVARIANT 1: nat/ntyp from the actual object (ASE writes them itself,\n    # but assert consistency here too).\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == 6 and ntyp == 2, f'{nnn}: nat={nat} ntyp={ntyp}'\n\n    # ----- SCF pw.in -----\n    scf_input = dict(common_input)\n    scf_input['calculation'] = 'scf'\n    with open(os.path.join(d, 'pw.in'), 'w') as fd:\n        write_espresso_in(fd, atoms, input_data=scf_input,\n                          pseudopotentials=PSEUDOS, kpts=KPTS_SCF,\n                          koffset=(0, 0, 0))\n\n    # ----- bands.in (nscf bands along seekpath path) -----\n    kpts_w, labels = kpath_for(atoms)\n    bands_input = dict(common_input)\n    bands_input['calculation'] = 'bands'\n    bands_input['nbnd'] = NBND\n    with open(os.path.join(d, 'bands.in'), 'w') as fd:\n        # numpy array kpts -> ASE writes explicit crystal K_POINTS card\n        write_espresso_in(fd, atoms, input_data=bands_input,\n                          pseudopotentials=PSEUDOS, kpts=kpts_w)\n\n    # ----- bands_post.in (bands.x) -----\n    with open(os.path.join(d, 'bands_post.in'), 'w') as fd:\n        fd.write('&BANDS\\n')\n        fd.write(\"  prefix = 'tio2'\\n\")\n        fd.write(\"  outdir = './out'\\n\")\n        fd.write(f\"  filband = '{nnn}.bands.dat'\\n\")\n        fd.write('  lsym = .true.\\n')\n        fd.write('/\\n')\n\n    # ----- band_labels.dat -----\n    with open(os.path.join(d, 'band_labels.dat'), 'w') as fd:\n        fd.write('# index  label\\n')\n        for idx, lbl in labels:\n            fd.write(f'{idx}  {lbl}\\n')\n\n    print(f'wrote {d}: nat={nat} ntyp={ntyp} nkpts={len(kpts_w)}')\n\nprint('setup_jobs done')\n"}}
