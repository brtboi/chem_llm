 {'tool': 'write_file', 'args': {'path': 'plot_bands.py', 'content': '"""STEP 7: Plot the GaAs band structure for calculations/000.\nParses the bands.x primary filband output (000.bands.dat) -- the .gnu file was\nwritten empty by bands.x, so we parse the real, non-empty primary file.\nReads band_labels.dat for high-symmetry tick indices, reads pw.out for the\nnumber of electrons (INVARIANT 2), aligns to the VBM, keeps ticks and band data\nin the SAME x units (INVARIANT 4), and marks/splits genuine discontinuities.\nNo pymatgen.\n"""\nimport math\nimport numpy as np\nimport matplotlib\nmatplotlib.use(\'Agg\')\nimport matplotlib.pyplot as plt\n\nCALC = \'calculations/000\'\nBANDS_FILE = f\'{CALC}/000.bands.dat\'\nLABELS_FILE = f\'{CALC}/band_labels.dat\'\nPWOUT = f\'{CALC}/pw.out\'\n\n# --- INVARIANT 2: read the ACTUAL number of electrons from pw.out (semicore\n# pseudos give 44 electrons, NOT the 3+3 the n_valence hint suggested). ---\nn_elec = None\nfor line in open(PWOUT):\n    if \'number of electrons\' in line:\n        n_elec = float(line.split(\'=\')[1])\n        break\nassert n_elec is not None, \'could not read number of electrons from pw.out\'\n# spin-unpolarized, non-metallic: occupied bands = electrons / 2\nn_occ = int(round(n_elec / 2))\nassert abs(n_occ - n_elec / 2) < 1e-9, \'non-integer occupied band count\'\nprint(f\'number of electrons = {n_elec}, occupied bands = {n_occ}\')\n\n# --- Parse the primary filband file (000.bands.dat) ---\n# Format: header \' &plot nbnd= N, nks= M /\', then per k-point a line of 3 floats\n# (kx ky kz in 2pi/alat) followed by ceil(nbnd/10) lines of energies (eV).\nlines = open(BANDS_FILE).read().split(\'\\n\')\nheader = lines[0]\nnbnd = int(header.split(\'nbnd=\')[1].split(\',\')[0])\nnks = int(header.split(\'nks=\')[1].split(\'/\')[0])\nn_elines = math.ceil(nbnd / 10)\n\nkcoords = []   # (nks, 3) in 2pi/alat\nenergies = []  # (nks, nbnd) in eV\ni = 1\nfor _ in range(nks):\n    kxyz = [float(x) for x in lines[i].split()]\n    assert len(kxyz) == 3\n    i += 1\n    evals = []\n    for _ in range(n_elines):\n        evals += [float(x) for x in lines[i].split()]\n        i += 1\n    assert len(evals) == nbnd, f\'expected {nbnd} energies, got {len(evals)}\'\n    kcoords.append(kxyz)\n    energies.append(evals)\nkcoords = np.array(kcoords)\nenergies = np.array(energies)  # (nks, nbnd)\nassert energies.shape == (nks, nbnd)\n\n# --- Cumulative path distance in 2pi/alat units (same units bands.x uses) ---\n# This is the x-axis for BOTH band curves and the high-symmetry ticks (INV 4).\ndist = np.zeros(nks)\nfor k in range(1, nks):\n    dist[k] = dist[k - 1] + np.linalg.norm(kcoords[k] - kcoords[k - 1])\n\n# --- VBM / CBM / gap ---\n# occupied bands are columns 0..n_occ-1 (0-indexed); VBM = max of highest\n# occupied band, CBM = min of lowest unoccupied band.\nvbm = energies[:, n_occ - 1].max()\ncbm = energies[:, n_occ].min()\ngap = cbm - vbm\nprint(f\'VBM = {vbm:.4f} eV\')\nprint(f\'CBM = {cbm:.4f} eV\')\nprint(f\'band gap = {gap:.4f} eV\')\n\n# --- High-symmetry labels: index in the k-point list -> distance ---\nlabel_idx = []\nlabel_txt = []\nfor line in open(LABELS_FILE):\n    parts = line.split()\n    if not parts:\n        continue\n    label_idx.append(int(parts[0]))\n    label_txt.append(parts[1])\n\n# Build tick positions (in distance units) and merged labels. A genuine\n# discontinuity is where two consecutive labelled indices are adjacent k-points\n# (idx, idx+1) whose k-coords are identical (bands.x repeats the x value) OR\n# the label file already encodes \'A|B\'. We collapse consecutive same-position\n# ticks and merge their labels with \'|\' only where the path truly jumps.\ntick_pos = []\ntick_lab = []\nj = 0\nwhile j < len(label_idx):\n    idx = label_idx[j]\n    lab = label_txt[j]\n    if \'|\' in lab:\n        # already a discontinuity label from setup (e.g. \'U|K\')\n        tick_pos.append(dist[idx])\n        tick_lab.append(lab)\n        j += 1\n        continue\n    # look ahead: next label at idx+1 with same distance -> a repeated vertex\n    if (j + 1 < len(label_idx) and label_idx[j + 1] == idx + 1\n            and abs(dist[label_idx[j + 1]] - dist[idx]) < 1e-9):\n        nxt = label_txt[j + 1]\n        if nxt == lab:\n            # same point sampled as end-of-seg and start-of-next: continuous\n            tick_pos.append(dist[idx])\n            tick_lab.append(lab)\n        else:\n            # genuine jump: different labels at zero-distance step\n            tick_pos.append(dist[idx])\n            tick_lab.append(f\'{lab}|{nxt}\')\n        j += 2\n    else:\n        tick_pos.append(dist[idx])\n        tick_lab.append(lab)\n        j += 1\n\n# INVARIANT 4: assert tick positions and band data share the same x range.\nassert abs(max(tick_pos) - dist.max()) < 0.05 * dist.max(), (\n    f\'tick range {max(tick_pos)} != band data range {dist.max()} (unit mismatch)\')\n\n# --- Identify discontinuity segments so no line is drawn across a jump ---\n# A jump is a zero-length step between consecutive k-points (repeated vertex).\nseg_breaks = [0]\nfor k in range(1, nks):\n    if np.linalg.norm(kcoords[k] - kcoords[k - 1]) < 1e-9:\n        seg_breaks.append(k)\nseg_breaks.append(nks)\n\n# --- Plot ---\nfig, ax = plt.subplots(figsize=(8, 6))\nfor b in range(nbnd):\n    # draw each continuous segment separately (no connector across jumps)\n    for s in range(len(seg_breaks) - 1):\n        a, c = seg_breaks[s], seg_breaks[s + 1]\n        ax.plot(dist[a:c], energies[a:c, b] - vbm, color=\'b\', lw=0.8)\n\nfor xp in tick_pos:\n    ax.axvline(xp, color=\'k\', lw=0.5)\nax.set_xticks(tick_pos)\nax.set_xticklabels([t.replace(\'GAMMA\', r\'$\\Gamma$\') for t in tick_lab])\nax.axhline(0.0, color=\'r\', ls=\'--\', lw=0.7)  # VBM reference\n\n# Restrict y-axis to about +/-10 eV around the VBM (INVARIANT 4).\nax.set_ylim(-10, 10)\nax.set_xlim(dist.min(), dist.max())\nax.set_ylabel(\'Energy - VBM (eV)\')\nax.set_title(f\'GaAs band structure (gap = {gap:.3f} eV)\')\nfig.tight_layout()\nfig.savefig(f\'{CALC}/bands_000.pdf\')\nprint(f\'Saved {CALC}/bands_000.pdf\')\n'}}
