 {"tool": "write_file", "args": {"path": "setup_jobs.py", "content": "\"\"\"STEP 5: Build calculations/NNN/ directories for each structure.\nEach dir gets: the two .upf pseudopotentials, pw.in (SCF), bands.in (bands NSCF along\na seekpath-derived k-path), bands_post.in (bands.x), and band_labels.dat.\nUses ASE (write_espresso_in) for QE I/O and seekpath+spglib for the k-path.\nNo pymatgen.\n\"\"\"\nimport os\nimport shutil\nimport numpy as np\nimport spglib\nimport seekpath\nfrom ase.io import read\nfrom ase.io.espresso import write_espresso_in\n\n# --- Pseudopotential files (fetched in STEP 3, live in template/) ---\nPP = {\"Ga\": \"449bd75c_Ga.upf\", \"As\": \"e8448a87_As.upf\"}\nPP_SRC = \"template\"\n\n# --- Energy cutoffs (INVARIANT 5) ---\n# get_pseudopotential hints are in HARTREE: Ga 40 Ha, As 42 Ha. QE wants RYDBERG.\n# 1 Ha = 2 Ry, so ecutwfc_ry = 2 * max(hint_ha).\nHINT_HA_MAX = 42.0\nECUTWFC = 2.0 * HINT_HA_MAX          # = 84 Ry\nassert ECUTWFC == 84.0\nECUTRHO = 4.0 * ECUTWFC              # norm-conserving: rho cutoff = 4 * wfc cutoff\nassert ECUTRHO == 336.0\n\nNBND = 16   # generous for bands; verified against pw.out 'number of electrons' in STEP 6\nPTS_PER_SEG = 20  # interpolation points per k-path segment\n\n\ndef build_kpath(atoms):\n    \"\"\"Return (kpts_array (n,4) in ACTUAL-cell crystal coords, labels list of\n    (index, label)) derived from the EXACT Atoms via seekpath (INVARIANT 3).\"\"\"\n    cell_tuple = (atoms.cell[:], atoms.get_scaled_positions(),\n                  atoms.get_atomic_numbers())\n    res = seekpath.get_path(cell_tuple, symprec=0.01)\n    # Self-consistency: seekpath's space group must match spglib's at same symprec.\n    sg_spglib = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01).number\n    assert res['spacegroup_number'] == sg_spglib, (\n        f\"seekpath sg {res['spacegroup_number']} != spglib {sg_spglib}\")\n\n    # Reproject seekpath's primitive-cell fractional points onto the ACTUAL cell's\n    # reciprocal lattice, going through Cartesian (INVARIANT 3).\n    recip_prim = np.array(res['reciprocal_primitive_lattice'])   # includes 2*pi\n    recip_actual = 2 * np.pi * np.array(atoms.cell.reciprocal()[:])  # add 2*pi\n    inv_recip_actual = np.linalg.inv(recip_actual)\n\n    def to_actual_frac(frac_prim):\n        cart = np.array(frac_prim) @ recip_prim\n        return cart @ inv_recip_actual\n\n    pc = {lbl: to_actual_frac(c) for lbl, c in res['point_coords'].items()}\n\n    kpts = []\n    labels = []  # (index_in_kpts, label)\n    prev_end_label = None\n    for (a, b) in res['path']:\n        start = pc[a]\n        end = pc[b]\n        # Discontinuity: previous segment's end label differs from this start.\n        if prev_end_label is not None and prev_end_label != a:\n            # Mark the jump on the point already recorded (last appended start).\n            labels[-1] = (labels[-1][0], f\"{prev_end_label}|{a}\")\n        # Every segment contributes its own start point (path can be discontinuous).\n        labels.append((len(kpts), a))\n        kpts.append(list(start) + [1.0])\n        # interior + end points\n        for t in range(1, PTS_PER_SEG + 1):\n            frac = start + (end - start) * (t / PTS_PER_SEG)\n            kpts.append(list(frac) + [1.0])\n        labels.append((len(kpts) - 1, b))\n        prev_end_label = b\n\n    return np.array(kpts), labels\n\n\ndef common_input(calculation):\n    \"\"\"FLAT input_data dict (INVARIANT 6: let ASE route to namelists).\"\"\"\n    d = {\n        'calculation': calculation,\n        'prefix': 'gaas',\n        'outdir': './out',\n        'pseudo_dir': './',          # pw.x runs inside calculations/NNN\n        'ecutwfc': ECUTWFC,          # Ry\n        'ecutrho': ECUTRHO,          # Ry\n        'occupations': 'fixed',      # GaAs semiconductor, non-metallic\n        'conv_thr': 1.0e-8,          # ASE routes this to &ELECTRONS\n    }\n    return d\n\n\nos.makedirs('calculations', exist_ok=True)\nN_STRUCT = 51\nfor i in range(N_STRUCT):\n    nnn = f\"{i:03d}\"\n    d = os.path.join('calculations', nnn)\n    os.makedirs(d, exist_ok=True)\n\n    atoms = read(f\"structures/structure_{nnn}.cif\")\n\n    # INVARIANT 1: nat/ntyp from the actual Atoms object (write_espresso_in does\n    # this itself, but we assert here to be explicit).\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == 2 and ntyp == 2, f\"{nnn}: nat={nat} ntyp={ntyp}\"\n\n    # Copy pseudopotentials into the calc dir.\n    for sym, fname in PP.items():\n        shutil.copy(os.path.join(PP_SRC, fname), os.path.join(d, fname))\n\n    # SCF input: Monkhorst-Pack 8x8x8 for a 2-atom primitive insulator.\n    with open(os.path.join(d, 'pw.in'), 'w') as f:\n        write_espresso_in(f, atoms, input_data=common_input('scf'),\n                          pseudopotentials=PP, kpts=(8, 8, 8),\n                          koffset=(0, 0, 0))\n\n    # Bands input: explicit k-path (INVARIANT 3), nbnd padded.\n    kpts_arr, labels = build_kpath(atoms)\n    bands_input = common_input('bands')\n    bands_input['nbnd'] = NBND\n    with open(os.path.join(d, 'bands.in'), 'w') as f:\n        write_espresso_in(f, atoms, input_data=bands_input,\n                          pseudopotentials=PP, kpts=kpts_arr)\n\n    # bands.x post-processing input (ASE has no bands.x writer -> hand-written).\n    with open(os.path.join(d, 'bands_post.in'), 'w') as f:\n        f.write('&BANDS\\n')\n        f.write(\"  prefix = 'gaas'\\n\")\n        f.write(\"  outdir = './out'\\n\")\n        f.write(f\"  filband = '{nnn}.bands.dat'\\n\")\n        f.write('/\\n')\n\n    # band_labels.dat: label + index in the bands k-point list (for plotting).\n    with open(os.path.join(d, 'band_labels.dat'), 'w') as f:\n        for idx, lbl in labels:\n            f.write(f\"{idx} {lbl}\\n\")\n\nprint(f\"Set up {N_STRUCT} calculation directories.\")\nprint(f\"ecutwfc={ECUTWFC} Ry, ecutrho={ECUTRHO} Ry, nbnd={NBND}\")\n"}}
