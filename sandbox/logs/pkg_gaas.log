 {"tool": "write_file", "args": {"path": "generate_structures.py", "content": "\"\"\"STEP 2: Generate 51 GaAs structures (000 = unperturbed primitive, 001-050 perturbed).\nUses ASE for all structure I/O and spglib for the primitive-cell reduction.\nNo pymatgen.\n\"\"\"\nimport numpy as np\nimport spglib\nfrom ase.io import read, write\nfrom ase import Atoms\n\n# --- Read base CIF (Materials Project mp-2534, zincblende GaAs, F-43m #216) ---\nbase = read(\"structures/gaas_base.cif\")\n\n# --- Reduce to primitive cell (unit-cell-choice DECISION RULE) ---\n# Build spglib cell tuple from the EXACT ASE Atoms object.\ncell_tuple = (base.cell[:], base.get_scaled_positions(), base.get_atomic_numbers())\nsg_before = spglib.get_symmetry_dataset(cell_tuple, symprec=0.01).number\nnat_before = len(base)\n\n# standardize_cell to primitive; no_idealize=False cleans up numerical noise.\nlattice, positions, numbers = spglib.standardize_cell(\n    cell_tuple, to_primitive=True, no_idealize=False, symprec=0.01)\nprim = Atoms(numbers=numbers, scaled_positions=positions, cell=lattice, pbc=True)\n\n# Verify space group unchanged and atom count divides evenly (DECISION RULE check).\nprim_tuple = (prim.cell[:], prim.get_scaled_positions(), prim.get_atomic_numbers())\nsg_after = spglib.get_symmetry_dataset(prim_tuple, symprec=0.01).number\nnat_after = len(prim)\nassert sg_after == sg_before == 216, f\"space group changed: {sg_before}->{sg_after}\"\nassert nat_before % nat_after == 0, f\"{nat_before} not divisible by {nat_after}\"\nprint(f\"nat before reduction = {nat_before}, after = {nat_after}\")\nprint(f\"space group before = {sg_before}, after = {sg_after}\")\n\n# --- Displacement magnitude justification ---\n# RMS thermal displacement at 300 K for GaAs (Debye-Waller) is ~0.08-0.1 Ang.\n# We use a modest Gaussian stdev of 0.05 Ang per Cartesian component so atoms stay\n# near their equilibrium sites (chemically reasonable, avoids unphysical overlaps).\nDISP_STDEV = 0.05  # Angstrom\n# Small random lattice strain, up to ~2% (isotropic + shear), room-temperature scale.\nMAX_STRAIN = 0.02\n\nN_STRUCT = 51\nfor i in range(N_STRUCT):\n    atoms = prim.copy()\n    if i != 0:\n        rng = np.random.RandomState(1000 + i)  # per-structure reproducible seed\n        # Random symmetric strain tensor: epsilon = 1 + small symmetric matrix.\n        e = rng.uniform(-MAX_STRAIN, MAX_STRAIN, size=(3, 3))\n        e = 0.5 * (e + e.T)  # symmetrize -> physical strain (no rigid rotation)\n        strain = np.eye(3) + e\n        new_cell = atoms.cell[:] @ strain.T\n        # scale_atoms=True keeps fractional coords fixed as the cell deforms.\n        atoms.set_cell(new_cell, scale_atoms=True)\n        # Random atomic displacements (thermal-like) via ASE rattle.\n        atoms.rattle(stdev=DISP_STDEV, seed=2000 + i)\n\n    # INVARIANT 1: nat/ntyp from the actual Atoms object, not hardcoded.\n    nat = len(atoms)\n    ntyp = len(set(atoms.get_chemical_symbols()))\n    assert nat == nat_after, f\"structure {i}: nat {nat} != {nat_after}\"\n    assert ntyp == 2, f\"structure {i}: ntyp {ntyp} != 2\"\n\n    write(f\"structures/structure_{i:03d}.cif\", atoms)\n\nprint(f\"Wrote {N_STRUCT} structures, nat={nat_after}, ntyp=2 each.\")\n"}}
