&control
  calculation = 'scf'
  restart_mode = 'from_scratch'
  prefix = 'CsPbBr3'
  outdir = './tmp'
  wfcdir = './tmp'
  pseudo_dir = './'
/
&system
  ibrav = 0
  celldm(1) = 10.0
  nat = 4
  ntyp = 3
  ecutwfc = 30.0
  ecutrho = 120.0
  occupations = 'smearing'
  smearing = 'gaussian'
  degauss = 0.01
  spin_polarized = .false.
/
&electrons
  mixing_mode = 'plain'
  mixing_beta = 0.7
  conv_thr = 1.0d-8
  max_iter = 100
/
ATOMIC_SPECIES
Cs 132.905  Cs.upf
Pb 207.2  Pb.upf
Br 79.904  Br.upf
ATOMIC_POSITIONS (crystal)
Cs 0.0 0.0 0.0
Pb 0.5 0.5 0.5
Br 0.5 0.0 0.0
Br 0.0 0.5 0.0
K_POINTS (automatic)
4 4 4 0 0 0
